;;-*-Lisp-*-
(in-package goal)

;; name: glider-hud.gc
;; name in dgo: glider-hud
;; dgos: HGA

;; DECOMP BEGINS

(defmethod draw ((this hud-glider-altitude))
  (set-hud-piece-position! (-> this sprites 0) 256 (+ (the int (* 50.0 (-> this offset))) 376))
  (set! (-> this sprites 0 pos z) #xfffff0)
  (let ((f0-4 (fmax 0.0 (fmin 1.0 (the-as float (-> this values 0 current))))))
    (set-as-offset-from! (-> this sprites 1) (-> this sprites 0 pos) (+ (the int (* 120.0 f0-4)) -60) 0)
    )
  (set! (-> this sprites 1 pos z) #xfffff1)
  (when (and *game-info* (logtest? (-> *game-info* secrets) (game-secrets hero-mode)))
    ;; Red marks the live failure floor; blue marks the intended course ceiling.
    (set-as-offset-from! (-> this sprites 2) (-> this sprites 0 pos) -60 0)
    (set-as-offset-from! (-> this sprites 3) (-> this sprites 0 pos) 60 0)
    (set! (-> this sprites 2 pos z) #xfffff2)
    (set! (-> this sprites 3 pos z) #xfffff2)
    (format (clear (-> this strings 0 text)) "~Dm" (the int (/ *hero-glider-fail-elevation* 4096.0)))
    (format (clear (-> this strings 1 text)) "~Dm" (the int (/ *hero-glider-max-elevation* 4096.0)))
    (set-as-offset-from! (the-as hud-sprite (-> this strings 0 pos)) (-> this sprites 0 pos) -66 -13)
    (set-as-offset-from! (the-as hud-sprite (-> this strings 1 pos)) (-> this sprites 0 pos) 66 -13)
    )
  ((method-of-type hud draw) this)
  0
  (none)
  )

(defmethod update-values! ((this hud-glider-altitude))
  (set! (-> this values 0 target) (the-as int (-> *game-info* health-bar-vehicle)))
  (logclear! (-> this flags) (hud-flags disable))
  ((method-of-type hud update-values!) this)
  0
  (none)
  )

(defmethod init-callback ((this hud-glider-altitude))
  (set! (-> this gui-id)
        (add-process *gui-control* this (gui-channel hud-upper-center-2) (gui-action hidden) (-> this name) 81920.0 0)
        )
  (logior! (-> this flags) (hud-flags show))
  (set! (-> this sprites 0 tid) (the-as texture-id (get-texture hud-glider-speed-01 hanga-minimap)))
  (set! (-> this sprites 0 flags) (hud-sprite-flags hsf3))
  (set! (-> this sprites 0 scale-x) 1.2)
  (set! (-> this sprites 0 scale-y) 1.2)
  (set! (-> this sprites 1 tid) (the-as texture-id (get-texture hud-glider-speed-marker-01 hanga-minimap)))
  (set! (-> this sprites 1 flags) (hud-sprite-flags hsf3))
  (set! (-> this sprites 1 scale-x) 1.0)
  (set! (-> this sprites 1 scale-y) 1.0)
  (when (and *game-info* (logtest? (-> *game-info* secrets) (game-secrets hero-mode)))
    (set! (-> this sprites 2 tid) (the-as texture-id (get-texture common-white common)))
    (set! (-> this sprites 2 flags) (hud-sprite-flags hsf3))
    (set! (-> this sprites 2 scale-x) 0.18)
    (set! (-> this sprites 2 scale-y) 0.55)
    (set! (-> this sprites 2 color x) 128)
    (set! (-> this sprites 2 color y) 18)
    (set! (-> this sprites 2 color z) 18)
    (set! (-> this sprites 3 tid) (the-as texture-id (get-texture common-white common)))
    (set! (-> this sprites 3 flags) (hud-sprite-flags hsf3))
    (set! (-> this sprites 3 scale-x) 0.18)
    (set! (-> this sprites 3 scale-y) 0.55)
    (set! (-> this sprites 3 color x) 18)
    (set! (-> this sprites 3 color y) 54)
    (set! (-> this sprites 3 color z) 128)
    (alloc-string-if-needed this 0)
    (set! (-> this strings 0 scale) 0.4)
    (set! (-> this strings 0 flags) (font-flags shadow kerning right large))
    (set! (-> this strings 0 color) (font-color red))
    (alloc-string-if-needed this 1)
    (set! (-> this strings 1 scale) 0.4)
    (set! (-> this strings 1 flags) (font-flags shadow kerning large))
    (set! (-> this strings 1 color) (font-color blue))
    )
  0
  (none)
  )
