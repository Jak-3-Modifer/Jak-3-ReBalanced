;;-*-Lisp-*-
(in-package goal)

;; name: wcar-x-ride.gc
;; name in dgo: wcar-x-ride
;; dgos: LPATK, LFACCAR, WASALL

;; DECOMP BEGINS

(deftype v-x-ride (wcar-snake-base)
  ()
  )

;; Hero Mode X-Ride loadout.  Keep its selections and cooldowns independent
;; from every other garage vehicle.
(define *v-x-ride-loadout-menu-open?* #f)
(define *v-x-ride-loadout-menu-page* 0)
(define *v-x-ride-loadout-menu-selection* 0)
(define *v-x-ride-weapon-loadout* 0)
(define *v-x-ride-ability-loadout* 0)
(define *v-x-ride-defense-loadout* 0)
(define *v-x-ride-vehicle-toughness-equipped?* #f)
(define *v-x-ride-mass-inverter-cooldown-time* (the-as time-frame 0))
(define *v-x-ride-mass-inverter-cooldown-active?* #f)
(define *v-x-ride-damage-immunity-time* (the-as time-frame 0))
(define *v-x-ride-damage-immunity-active?* #f)
(define *v-x-ride-damage-immunity-cooldown-time* (the-as time-frame 0))
(define *v-x-ride-damage-immunity-cooldown-active?* #f)
(define *v-x-ride-repair-cooldown-time* (the-as time-frame 0))
(define *v-x-ride-repair-cooldown-active?* #f)
(define *v-x-ride-regenerative-armor-time* (the-as time-frame 0))
(define *v-x-ride-regenerative-armor-active?* #f)
(define *v-x-ride-camouflage-time* (the-as time-frame 0))
(define *v-x-ride-camouflage-cooldown-time* (the-as time-frame 0))
(define *v-x-ride-camouflage-cooldown-active?* #f)
(define *v-x-ride-camouflage-active?* #f)
(define *v-x-ride-jammer-fade-active?* #f)

(defun set-v-x-ride-active-loadout! ((loadout int))
  (set! *v-x-ride-weapon-loadout* loadout)
  (none))

(defun set-v-x-ride-ability-loadout! ((loadout int))
  (set! *v-x-ride-ability-loadout* loadout)
  (set! *v-x-ride-vehicle-toughness-equipped?* (= loadout 2))
  (none))

(defun set-v-x-ride-defense-loadout! ((loadout int))
  (set! *v-x-ride-defense-loadout* loadout)
  (none))

(defun close-v-x-ride-loadout-menu ()
  (set-master-mode 'game)
  (set! *v-x-ride-loadout-menu-open?* #f)
  (set! *popup-menu-open* #f)
  (none))

(defun open-v-x-ride-loadout-menu ()
  (set! *v-x-ride-loadout-menu-page* 0)
  (set! *v-x-ride-loadout-menu-selection* 0)
  (set! *v-x-ride-loadout-menu-open?* #t)
  (set! *popup-menu-open* #t)
  (set-master-mode 'menu)
  (sound-play "menu-pick")
  (none))

(defun v-x-ride-set-fade! ((this wvehicle) (amount uint) (active? symbol))
  (if active?
      (begin
        (logior! (-> this draw status) (draw-control-status force-fade))
        (set! (-> this draw force-fade) amount))
      (begin
        (set! (-> this draw force-fade) (the-as uint 128))
        (logclear! (-> this draw status) (draw-control-status force-fade))))
  (dotimes (wheel-index (-> this info physics-model wheel-count))
    (let ((wheel-proc (handle->process (-> this wheel wheel-index handle))))
      (when wheel-proc
        (if active?
            (begin
              (logior! (-> (the-as process-drawable wheel-proc) draw status)
                       (draw-control-status force-fade))
              (set! (-> (the-as process-drawable wheel-proc) draw force-fade) amount))
            (begin
              (set! (-> (the-as process-drawable wheel-proc) draw force-fade) (the-as uint 128))
              (logclear! (-> (the-as process-drawable wheel-proc) draw status)
                         (draw-control-status force-fade)))))))
  (none))

(defun v-x-ride-camouflage-hides-target? ()
  (if (and *v-x-ride-camouflage-active?*
           *target*
           (focus-test? *target* pilot-riding)
           (= (-> *game-info* current-vehicle) (vehicle-type-u8 v-x-ride)))
      #t
      #f))

(defmethod deactivate ((this v-x-ride))
  (when (or *v-x-ride-camouflage-active?* *v-x-ride-jammer-fade-active?*)
    (v-x-ride-set-fade! this (the-as uint 128) #f))
  (set! *v-x-ride-camouflage-active?* #f)
  (set! *v-x-ride-jammer-fade-active?* #f)
  (set! *v-x-ride-damage-immunity-active?* #f)
  ((method-of-type wcar-snake-base deactivate) this)
  (none))

(defmethod apply-damage ((this v-x-ride) (amount float) (impact rigid-body-impact))
  (when (and *v-x-ride-vehicle-toughness-equipped?*
             (logtest? (-> *game-info* secrets) (game-secrets hero-mode))
             (logtest? (vehicle-flag player-driving) (-> this v-flags)))
    (set! amount (/ amount 2)))
  (when *v-x-ride-damage-immunity-active?*
    (set! amount 0.0))
  (when (and (= *v-x-ride-ability-loadout* 7) (> amount 0.0))
    (set-time! *v-x-ride-regenerative-armor-time*)
    (set! *v-x-ride-regenerative-armor-active?* #t))
  ((method-of-type wcar-base apply-damage) this amount impact)
  (none))

(defun v-x-ride-update-loadout! ((this v-x-ride))
  (when (and (logtest? (vehicle-flag player-driving) (-> this v-flags))
             (cpad-pressed? 0 r1)
             (= *v-x-ride-weapon-loadout* 1)
             (v-turtle-mass-inverter-unlocked?)
             (or (not *v-x-ride-mass-inverter-cooldown-active?*)
                 (time-elapsed? *v-x-ride-mass-inverter-cooldown-time* (seconds 8))))
    (process-spawn gun-gravity (-> this root trans) (-> this rbody matrix fvec)
                   :name "v-x-ride-mass-inverter" :to *entity-pool*)
    (set-time! *v-x-ride-mass-inverter-cooldown-time*)
    (set! *v-x-ride-mass-inverter-cooldown-active?* #t))
  (when (and (logtest? (vehicle-flag player-driving) (-> this v-flags))
             (cpad-pressed? 0 right))
    (case *v-x-ride-defense-loadout*
      ((4)
       (when (and (not *v-x-ride-damage-immunity-active?*)
                  (or (not *v-x-ride-damage-immunity-cooldown-active?*)
                      (time-elapsed? *v-x-ride-damage-immunity-cooldown-time* (seconds 35))))
         (set-time! *v-x-ride-damage-immunity-time*)
         (set! *v-x-ride-damage-immunity-active?* #t)
         (set! *v-x-ride-damage-immunity-cooldown-active?* #f)
         (sound-play "shield-on")))
      ((5)
       (when (and (< 0.0 (-> this hit-points))
                  (<= (-> this hit-points) 0.15)
                  (or (not *v-x-ride-repair-cooldown-active?*)
                      (time-elapsed? *v-x-ride-repair-cooldown-time* (seconds 40))))
         (set! (-> this hit-points) (fmin 1.0 (+ (-> this hit-points) 0.25)))
         (when (logtest? (-> *game-info* secrets) (game-secrets hero-mode))
           (sound-play "get-green-eco"))
         (set-time! *v-x-ride-repair-cooldown-time*)
         (set! *v-x-ride-repair-cooldown-active?* #t)))
      ((8)
       (when (and (not *v-x-ride-camouflage-active?*)
                  (or (not *v-x-ride-camouflage-cooldown-active?*)
                      (time-elapsed? *v-x-ride-camouflage-cooldown-time* (seconds 25))))
         (set-time! *v-x-ride-camouflage-time*)
         (set! *v-x-ride-camouflage-active?* #t)
         (set! *v-x-ride-camouflage-cooldown-active?* #f)
         (v-x-ride-set-fade! this (the-as uint 13) #t)))))
  (when (and *v-x-ride-damage-immunity-active?*
             (or (time-elapsed? *v-x-ride-damage-immunity-time* (seconds 4))
                 (!= *v-x-ride-defense-loadout* 4)))
    (set! *v-x-ride-damage-immunity-active?* #f)
    (set-time! *v-x-ride-damage-immunity-cooldown-time*)
    (set! *v-x-ride-damage-immunity-cooldown-active?* #t))
  (when (and (= *v-x-ride-ability-loadout* 3)
             (not (logtest? (vehicle-flag turbo-boost) (-> this v-flags))))
    (set! (-> this turbo-ready)
          (fmin 1.0 (+ (-> this turbo-ready) (* 0.5 (seconds-per-frame))))))
  (cond
    ((!= *v-x-ride-ability-loadout* 7) (set! *v-x-ride-regenerative-armor-active?* #f))
    ((and *v-x-ride-regenerative-armor-active?*
          (time-elapsed? *v-x-ride-regenerative-armor-time* (seconds 4)))
     (set! (-> this hit-points) (fmin 1.0 (+ (-> this hit-points) 0.033333335)))
     (if (>= (-> this hit-points) 1.0)
         (set! *v-x-ride-regenerative-armor-active?* #f)
         (set-time! *v-x-ride-regenerative-armor-time*))))
  (when (and *v-x-ride-camouflage-active?*
             (or (time-elapsed? *v-x-ride-camouflage-time* (seconds 10))
                 (!= *v-x-ride-defense-loadout* 8)))
    (set! *v-x-ride-camouflage-active?* #f)
    (set-time! *v-x-ride-camouflage-cooldown-time*)
    (set! *v-x-ride-camouflage-cooldown-active?* #t)
    (v-x-ride-set-fade! this (the-as uint 128) #f))
  (cond
    (*v-x-ride-camouflage-active?* (set! *v-x-ride-jammer-fade-active?* #f))
    ((= *v-x-ride-ability-loadout* 6)
     (unless *v-x-ride-jammer-fade-active?*
       (set! *v-x-ride-jammer-fade-active?* #t)
       (v-x-ride-set-fade! this (the-as uint 115) #t)))
    (*v-x-ride-jammer-fade-active?*
     (set! *v-x-ride-jammer-fade-active?* #f)
     (v-x-ride-set-fade! this (the-as uint 128) #f)))
  (none))

(defmethod vehicle-method-77 ((this v-x-ride))
  (v-x-ride-update-loadout! this)
  ((method-of-type wvehicle vehicle-method-77) this)
  (none))


(defmethod vehicle-method-62 ((this v-x-ride))
  (let ((s5-0 (-> this root root-prim)))
    (mem-copy!
      (the-as pointer (-> (the-as collide-shape-prim-group s5-0) child 0 local-sphere))
      (the-as pointer (new 'static 'vector :x 8192.0 :y 1638.4 :z 7864.32 :w 3276.8))
      16
      )
    (mem-copy!
      (the-as pointer (-> (the-as collide-shape-prim-group s5-0) child 1 local-sphere))
      (the-as pointer (new 'static 'vector :x -8192.0 :y 1638.4 :z 7864.32 :w 3276.8))
      16
      )
    (mem-copy!
      (the-as pointer (-> (the-as collide-shape-prim-group s5-0) child 2 local-sphere))
      (the-as pointer (new 'static 'vector :x 9011.2 :y 2048.0 :z -11878.4 :w 4915.2))
      16
      )
    (mem-copy!
      (the-as pointer (-> (the-as collide-shape-prim-group s5-0) child 3 local-sphere))
      (the-as pointer (new 'static 'vector :x -9011.2 :y 2048.0 :z -11878.4 :w 4915.2))
      16
      )
    (mem-copy!
      (the-as pointer (-> (the-as collide-shape-prim-group s5-0) child 4 local-sphere))
      (the-as pointer (new 'static 'vector :y 3317.76 :z 9011.2 :w 4915.2))
      16
      )
    (mem-copy!
      (the-as pointer (-> (the-as collide-shape-prim-group s5-0) child 5 local-sphere))
      (the-as pointer (new 'static 'vector :y 3686.4 :z -1638.4 :w 6144.0))
      16
      )
    (mem-copy!
      (the-as pointer (-> (the-as collide-shape-prim-group s5-0) child 6 local-sphere))
      (the-as pointer (new 'static 'vector :y 3276.8 :z -14336.0 :w 6144.0))
      16
      )
    (set! (-> (the-as collide-shape-prim-group s5-0) child 7 local-sphere w) 20889.6)
    )
  ((method-of-type wcar-base vehicle-method-62) this)
  0
  (none)
  )

(defmethod init-rbody-control! ((this v-x-ride))
  (initialize-skeleton
    this
    (the-as skeleton-group (art-group-get-by-name *level* "skel-v-x-ride" (the-as (pointer level) #f)))
    (the-as pair 0)
    )
  (setup-masks (-> this draw) 0 -1)
  (setup-masks (-> this draw) 1 0)
  (setup-masks (-> this draw) 4 0)
  (alloc-rbody-control! this *v-x-ride-constants*)
  (set! *v-x-ride-damage-immunity-active?* #f)
  (set! *v-x-ride-damage-immunity-cooldown-active?* #f)
  (set! *v-x-ride-repair-cooldown-active?* #f)
  (set! *v-x-ride-mass-inverter-cooldown-active?* #f)
  (set! *v-x-ride-regenerative-armor-active?* #f)
  (set! *v-x-ride-camouflage-cooldown-active?* #f)
  (set! *v-x-ride-camouflage-active?* #f)
  (set! *v-x-ride-jammer-fade-active?* #f)
  (set! (-> this shoot-delay) (the-as uint 25))
  (set! (-> this local-gun-pos 0 quad) (-> (new 'static 'vector :x 2048.0 :y 3686.4 :z 14336.0 :w 1.0) quad))
  (vector-copy! (-> this local-gun-pos 1) (new 'static 'vector :x -2048.0 :y 3686.4 :z 14336.0 :w 1.0))
  (set! (-> this rider-hand-joint-array 0) 8)
  ((method-of-type joint-mod-rotate-local init)
   (-> this jmod-axles 0)
   this
   (the-as uint 5)
   (joint-mod-base-flags attached)
   )
  (init (-> this jmod-axles 1) this (the-as uint 6) (joint-mod-base-flags attached))
  (init (-> this jmod-axles 2) this (the-as uint 4) (joint-mod-base-flags attached))
  (init (-> this jmod-axles 3) this (the-as uint 7) (joint-mod-base-flags attached))
  ((method-of-type joint-mod-rotate-local init)
   (-> this jmod-shock-tops 0)
   this
   (the-as uint 11)
   (joint-mod-base-flags attached)
   )
  (init (-> this jmod-shock-tops 1) this (the-as uint 15) (joint-mod-base-flags attached))
  (init (-> this jmod-shock-tops 2) this (the-as uint 9) (joint-mod-base-flags attached))
  (init (-> this jmod-shock-tops 3) this (the-as uint 13) (joint-mod-base-flags attached))
  ((method-of-type joint-mod-set-local init)
   (-> this jmod-shock-mids 0)
   this
   (the-as uint 12)
   (joint-mod-base-flags attached trans)
   )
  (init (-> this jmod-shock-mids 1) this (the-as uint 16) (joint-mod-base-flags attached trans))
  (init (-> this jmod-shock-mids 2) this (the-as uint 10) (joint-mod-base-flags attached trans))
  (init (-> this jmod-shock-mids 3) this (the-as uint 14) (joint-mod-base-flags attached trans))
  ((method-of-type joint-mod-add-local init)
   (the-as joint-mod-add-local (-> this jmod-guns))
   this
   (the-as uint 17)
   (joint-mod-base-flags attached trans)
   )
  ((method-of-type joint-mod-add-local init)
   (the-as joint-mod-add-local (-> this jmod-guns 1))
   this
   (the-as uint 18)
   (joint-mod-base-flags attached trans)
   )
  (spawn-wheels!
    this
    (the-as skeleton-group (art-group-get-by-name *level* "skel-v-fox-wheel" (the-as (pointer level) #f)))
    (the-as skeleton-group (art-group-get-by-name *level* "skel-v-fox-wheel-blur" (the-as (pointer level) #f)))
    (the-as skeleton-group (art-group-get-by-name *level* "skel-v-snake-wheel" (the-as (pointer level) #f)))
    (the-as skeleton-group (art-group-get-by-name *level* "skel-v-snake-wheel-blur" (the-as (pointer level) #f)))
    )
  0
  (none)
  )
