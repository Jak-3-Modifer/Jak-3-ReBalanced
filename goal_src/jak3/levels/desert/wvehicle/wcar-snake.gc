;;-*-Lisp-*-
(in-package goal)

;; name: wcar-snake.gc
;; name in dgo: wcar-snake
;; dgos: LPATK, LFACCAR, WASALL

;; DECOMP BEGINS

(define *v-snake-loadout-menu-open?* #f)
(define *v-snake-loadout-menu-selection* 0)
(define *v-snake-vehicle-toughness-equipped?* #f)
(define *v-snake-turret-jammer-equipped?* #f)

(defun set-v-snake-regenerative-armor-equipped! ((equipped? symbol))
  (set! *v-snake-regenerative-armor-equipped?* equipped?)
  (unless equipped?
    (set! *sand-shark-repair-active?* #f)
    (set! *sand-shark-repair-update-seen?* #f)
    )
  (none)
  )

(defun set-v-snake-emergency-repair-equipped! ((equipped? symbol))
  (set! *v-snake-emergency-repair-equipped?* equipped?)
  (unless equipped?
    (set! *v-snake-emergency-repair-armed?* #f)
    )
  (none)
  )

(defun v-snake-loadout-equipped? ((selection int))
  (case selection
    ((1) *v-snake-regenerative-armor-equipped?*)
    ((2) *v-snake-emergency-repair-equipped?*)
    ((3) *v-snake-vehicle-toughness-equipped?*)
    ((4) *v-snake-turret-jammer-equipped?*)
    ((5) *v-snake-camouflage-equipped?*)
    ((6) *v-snake-damage-shield-equipped?*)
    (else #f))
  )

(defun v-snake-loadout-equipped-count ()
  (let ((count 0))
    (dotimes (i 6)
      (when (v-snake-loadout-equipped? (+ i 1)) (+! count 1)))
    count)
  )

(defun v-snake-toggle-loadout! ((selection int))
  ;; Only mutate the selected slot. None clears all without resetting cooldowns.
  (let ((equipped? (v-snake-loadout-equipped? selection)))
    (cond
      ((zero? selection)
       (set-v-snake-regenerative-armor-equipped! #f)
       (set-v-snake-emergency-repair-equipped! #f)
       (set! *v-snake-vehicle-toughness-equipped?* #f)
       (set! *v-snake-turret-jammer-equipped?* #f)
       (set! *v-snake-camouflage-equipped?* #f)
       (set! *v-snake-damage-shield-equipped?* #f)
       (v-snake-end-camouflage!)
       (v-snake-end-damage-shield!))
      ((or equipped? (< (v-snake-loadout-equipped-count) 2))
       (case selection
         ((1) (set-v-snake-regenerative-armor-equipped! (not equipped?)))
         ((2) (set-v-snake-emergency-repair-equipped! (not equipped?)))
         ((3) (set! *v-snake-vehicle-toughness-equipped?* (not equipped?)))
         ((4) (set! *v-snake-turret-jammer-equipped?* (not equipped?)))
         ((5)
          (set! *v-snake-camouflage-equipped?* (not equipped?))
          (unless *v-snake-camouflage-equipped?* (v-snake-end-camouflage!)))
         ((6)
          (set! *v-snake-damage-shield-equipped?* (not equipped?))
          (unless *v-snake-damage-shield-equipped?* (v-snake-end-damage-shield!)))))
      (else
       (format #t "[Sand Shark Loadout] two abilities equipped; unequip one first~%"))))
  (none)
  )

(defun close-v-snake-loadout-menu ()
  (set-master-mode 'game)
  (set! *v-snake-loadout-menu-open?* #f)
  (set! *popup-menu-open* #f)
  (none)
  )

(defun open-v-snake-loadout-menu ()
  (set! *v-snake-loadout-menu-selection*
        (cond
          (*v-snake-damage-shield-equipped?* 6)
          (*v-snake-camouflage-equipped?* 5)
          (*v-snake-turret-jammer-equipped?* 4)
          (*v-snake-vehicle-toughness-equipped?* 3)
          (*v-snake-emergency-repair-equipped?* 2)
          (*v-snake-regenerative-armor-equipped?* 1)
          (else 0)))
  (set! *v-snake-loadout-menu-open?* #t)
  (set! *popup-menu-open* #t)
  (set-master-mode 'menu)
  (sound-play "menu-pick")
  (none)
  )

(deftype v-snake (wcar-snake-base)
  ()
  )

(defmethod deactivate ((this v-snake))
  (when (= (handle->process (-> *v-snake-damage-shield-owner-storage* 0)) this)
    (v-snake-end-damage-shield!))
  (when (= (handle->process (-> *v-snake-camouflage-owner-storage* 0)) this)
    (format #t "[Sand Shark Camouflage] ending: vehicle deactivated/unloaded~%")
    (v-snake-end-camouflage!))
  ((method-of-type wcar-snake-base deactivate) this)
  (none)
  )

(defmethod apply-damage ((this v-snake) (amount float) (impact rigid-body-impact))
  ;; Match the Tough Puppy's damage hook; do not alter Jak or collision masks.
  (when (v-snake-damage-shield-protects? this)
    (set! amount 0.0))
  ;; Per-car Hero loadout: never enable the shared Vehicle Toughness secret.
  (when (and *v-snake-vehicle-toughness-equipped?*
             (logtest? (-> *game-info* secrets) (game-secrets hero-mode))
             (logtest? (vehicle-flag player-driving) (-> this v-flags)))
    (set! amount (/ amount 2)))
  ;; Record only damage that actually lowered the driven Sand Shark's HP.
  (let ((old-health (-> this hit-points)))
    ((method-of-type wcar-base apply-damage) this amount impact)
    (when (and *v-snake-regenerative-armor-equipped?*
               (logtest? (-> *game-info* secrets) (game-secrets hero-mode))
               (logtest? (vehicle-flag player-driving) (-> this v-flags))
               (< (-> this hit-points) old-health))
      (unless *sand-shark-repair-active?*
        (set! *sand-shark-repair-update-seen?* #f))
      (set! *sand-shark-repair-active?* #t)
      (set-time! *sand-shark-repair-time*)
      (format #t "Sand Shark damaged: HP ~f~%"
              (* (-> this hit-points) (-> this info damage hit-points)))))
  (none)
  )


(defmethod vehicle-method-62 ((this v-snake))
  (let ((s5-0 (-> this root root-prim)))
    (mem-copy!
      (the-as pointer (-> (the-as collide-shape-prim-group s5-0) child 0 local-sphere))
      (the-as pointer (new 'static 'vector :x 8192.0 :y 1638.4 :z 7864.32 :w 3276.8))
      16
      )
    (mem-copy!
      (the-as pointer (-> (the-as collide-shape-prim-group s5-0) child 1 local-sphere))
      (the-as pointer (new 'static 'vector :x -8192.0 :y 1638.4 :z 7864.32 :w 3276.8))
      16
      )
    (mem-copy!
      (the-as pointer (-> (the-as collide-shape-prim-group s5-0) child 2 local-sphere))
      (the-as pointer (new 'static 'vector :x 9011.2 :y 2048.0 :z -11878.4 :w 4915.2))
      16
      )
    (mem-copy!
      (the-as pointer (-> (the-as collide-shape-prim-group s5-0) child 3 local-sphere))
      (the-as pointer (new 'static 'vector :x -9011.2 :y 2048.0 :z -11878.4 :w 4915.2))
      16
      )
    (mem-copy!
      (the-as pointer (-> (the-as collide-shape-prim-group s5-0) child 4 local-sphere))
      (the-as pointer (new 'static 'vector :y 3276.8 :z 9011.2 :w 4505.6))
      16
      )
    (mem-copy!
      (the-as pointer (-> (the-as collide-shape-prim-group s5-0) child 5 local-sphere))
      (the-as pointer (new 'static 'vector :y 3686.4 :z -1638.4 :w 6144.0))
      16
      )
    (mem-copy!
      (the-as pointer (-> (the-as collide-shape-prim-group s5-0) child 6 local-sphere))
      (the-as pointer (new 'static 'vector :y 3276.8 :z -11878.4 :w 5734.4))
      16
      )
    (set! (-> (the-as collide-shape-prim-group s5-0) child 7 local-sphere w) 20889.6)
    )
  ((method-of-type wcar-base vehicle-method-62) this)
  0
  (none)
  )

(defmethod init-rbody-control! ((this v-snake))
  (initialize-skeleton
    this
    (the-as skeleton-group (art-group-get-by-name *level* "skel-v-snake" (the-as (pointer level) #f)))
    (the-as pair 0)
    )
  (setup-masks (-> this draw) 0 -1)
  (setup-masks (-> this draw) 1 0)
  (setup-masks (-> this draw) 4 0)
  (alloc-rbody-control! this *v-snake-constants*)
  ;; The shared firing method alternates 7- and 8-tick gaps for this vehicle.
  ;; Each barrel therefore fires every 15 ticks, giving 1200 RPM per barrel.
  (set! (-> this shoot-delay) (the-as uint 7))
  (set! (-> this local-gun-pos 0 quad) (-> (new 'static 'vector :x 3686.4 :y 5324.8 :z 6144.0 :w 1.0) quad))
  (vector-copy! (-> this local-gun-pos 1) (new 'static 'vector :x -3686.4 :y 5324.8 :z 6144.0 :w 1.0))
  (set! (-> this rider-hand-joint-array 0) 17)
  ((method-of-type joint-mod-rotate-local init)
   (-> this jmod-axles 0)
   this
   (the-as uint 5)
   (joint-mod-base-flags attached)
   )
  (init (-> this jmod-axles 1) this (the-as uint 6) (joint-mod-base-flags attached))
  (init (-> this jmod-axles 2) this (the-as uint 4) (joint-mod-base-flags attached))
  (init (-> this jmod-axles 3) this (the-as uint 7) (joint-mod-base-flags attached))
  ((method-of-type joint-mod-rotate-local init)
   (-> this jmod-shock-tops 0)
   this
   (the-as uint 11)
   (joint-mod-base-flags attached)
   )
  (init (-> this jmod-shock-tops 1) this (the-as uint 15) (joint-mod-base-flags attached))
  (init (-> this jmod-shock-tops 2) this (the-as uint 9) (joint-mod-base-flags attached))
  (init (-> this jmod-shock-tops 3) this (the-as uint 13) (joint-mod-base-flags attached))
  ((method-of-type joint-mod-set-local init)
   (-> this jmod-shock-mids 0)
   this
   (the-as uint 12)
   (joint-mod-base-flags attached trans)
   )
  (init (-> this jmod-shock-mids 1) this (the-as uint 16) (joint-mod-base-flags attached trans))
  (init (-> this jmod-shock-mids 2) this (the-as uint 10) (joint-mod-base-flags attached trans))
  (init (-> this jmod-shock-mids 3) this (the-as uint 14) (joint-mod-base-flags attached trans))
  ((method-of-type joint-mod-add-local init)
   (the-as joint-mod-add-local (-> this jmod-guns))
   this
   (the-as uint 18)
   (joint-mod-base-flags attached trans)
   )
  ((method-of-type joint-mod-add-local init)
   (the-as joint-mod-add-local (-> this jmod-guns 1))
   this
   (the-as uint 19)
   (joint-mod-base-flags attached trans)
   )
  (spawn-wheels!
    this
    (the-as skeleton-group (art-group-get-by-name *level* "skel-v-snake-wheel" (the-as (pointer level) #f)))
    (the-as skeleton-group (art-group-get-by-name *level* "skel-v-snake-wheel-blur" (the-as (pointer level) #f)))
    (the-as skeleton-group #f)
    (the-as skeleton-group #f)
    )
  0
  (none)
  )
