;;-*-Lisp-*-
(in-package goal)

;; name: wcar-mirage.gc
;; name in dgo: wcar-mirage
;; dgos: LPATK, LFACCAR, WASALL

;; DECOMP BEGINS

(deftype v-mirage (wcar-snake-base)
  ()
  )

;; Hero Mode Desert Mirage loadout.  It owns its selections so garage menus
;; for the other vehicles cannot change Mirage equipment.
(define *v-mirage-loadout-menu-open?* #f)
(define *v-mirage-loadout-menu-page* 0)
(define *v-mirage-loadout-menu-selection* 0)
(define *v-mirage-weapon-loadout* 0)
(define *v-mirage-ability-loadout* 0)
(define *v-mirage-defense-loadout* 0)
(define *v-mirage-vehicle-toughness-equipped?* #f)
(define *v-mirage-mass-inverter-cooldown-time* (the-as time-frame 0))
(define *v-mirage-mass-inverter-cooldown-active?* #f)
(define *v-mirage-damage-immunity-time* (the-as time-frame 0))
(define *v-mirage-damage-immunity-active?* #f)
(define *v-mirage-damage-immunity-cooldown-time* (the-as time-frame 0))
(define *v-mirage-damage-immunity-cooldown-active?* #f)
(define *v-mirage-repair-cooldown-time* (the-as time-frame 0))
(define *v-mirage-repair-cooldown-active?* #f)
(define *v-mirage-regenerative-armor-time* (the-as time-frame 0))
(define *v-mirage-regenerative-armor-active?* #f)
(define *v-mirage-camouflage-time* (the-as time-frame 0))
(define *v-mirage-camouflage-cooldown-time* (the-as time-frame 0))
(define *v-mirage-camouflage-cooldown-active?* #f)
(define *v-mirage-camouflage-active?* #f)
(define *v-mirage-jammer-fade-active?* #f)

(defun v-mirage-camouflage-hides-target? ()
  (if (and *v-mirage-camouflage-active?*
           *target*
           (focus-test? *target* pilot-riding)
           (= (-> *game-info* current-vehicle) (vehicle-type-u8 v-mirage)))
      #t
      #f))

(defun set-v-mirage-active-loadout! ((loadout int))
  (set! *v-mirage-weapon-loadout* loadout)
  (none))

(defun set-v-mirage-ability-loadout! ((loadout int))
  (set! *v-mirage-ability-loadout* loadout)
  (set! *v-mirage-vehicle-toughness-equipped?* (= loadout 2))
  (none))

(defun set-v-mirage-defense-loadout! ((loadout int))
  (set! *v-mirage-defense-loadout* loadout)
  (none))

(defun close-v-mirage-loadout-menu ()
  (set-master-mode 'game)
  (set! *v-mirage-loadout-menu-open?* #f)
  (set! *popup-menu-open* #f)
  (none))

(defun open-v-mirage-loadout-menu ()
  (set! *v-mirage-loadout-menu-page* 0)
  (set! *v-mirage-loadout-menu-selection* 0)
  (set! *v-mirage-loadout-menu-open?* #t)
  (set! *popup-menu-open* #t)
  (set-master-mode 'menu)
  (sound-play "menu-pick")
  (none))

(defun v-mirage-set-fade! ((this wvehicle) (amount uint) (active? symbol))
  (if active?
      (begin
        (logior! (-> this draw status) (draw-control-status force-fade))
        (set! (-> this draw force-fade) amount))
      (begin
        (set! (-> this draw force-fade) (the-as uint 128))
        (logclear! (-> this draw status) (draw-control-status force-fade))))
  (none))

(defun v-mirage-update-loadout! ((this v-mirage))
  (when (and (logtest? (vehicle-flag player-driving) (-> this v-flags))
             (cpad-pressed? 0 r1)
             (= *v-mirage-weapon-loadout* 1)
             (v-turtle-mass-inverter-unlocked?)
             (or (not *v-mirage-mass-inverter-cooldown-active?*)
                 (time-elapsed? *v-mirage-mass-inverter-cooldown-time* (seconds 8))))
    (process-spawn gun-gravity (-> this root trans) (-> this rbody matrix fvec)
                   :name "v-mirage-mass-inverter" :to *entity-pool*)
    (set-time! *v-mirage-mass-inverter-cooldown-time*)
    (set! *v-mirage-mass-inverter-cooldown-active?* #t))
  (when (and (logtest? (vehicle-flag player-driving) (-> this v-flags))
             (cpad-pressed? 0 right))
    (case *v-mirage-defense-loadout*
      ((4)
       (when (and (not *v-mirage-damage-immunity-active?*)
                  (or (not *v-mirage-damage-immunity-cooldown-active?*)
                      (time-elapsed? *v-mirage-damage-immunity-cooldown-time* (seconds 35))))
         (set-time! *v-mirage-damage-immunity-time*)
         (set! *v-mirage-damage-immunity-active?* #t)
         (set! *v-mirage-damage-immunity-cooldown-active?* #f)
         (sound-play "shield-on")))
      ((5)
       (when (and (< 0.0 (-> this hit-points)) (<= (-> this hit-points) 0.15)
                  (or (not *v-mirage-repair-cooldown-active?*)
                      (time-elapsed? *v-mirage-repair-cooldown-time* (seconds 40))))
         (set! (-> this hit-points) (fmin 1.0 (+ (-> this hit-points) 0.25)))
         (when (logtest? (-> *game-info* secrets) (game-secrets hero-mode))
           (sound-play "get-green-eco"))
         (set-time! *v-mirage-repair-cooldown-time*)
         (set! *v-mirage-repair-cooldown-active?* #t)))
      ((8)
       (when (and (not *v-mirage-camouflage-active?*)
                  (or (not *v-mirage-camouflage-cooldown-active?*)
                      (time-elapsed? *v-mirage-camouflage-cooldown-time* (seconds 25))))
         (set-time! *v-mirage-camouflage-time*)
         (set! *v-mirage-camouflage-active?* #t)
         (set! *v-mirage-camouflage-cooldown-active?* #f)
         (v-mirage-set-fade! (the-as wvehicle this) (the-as uint 13) #t)))))
  (when (and *v-mirage-damage-immunity-active?*
             (or (time-elapsed? *v-mirage-damage-immunity-time* (seconds 4))
                 (!= *v-mirage-defense-loadout* 4)))
    (set! *v-mirage-damage-immunity-active?* #f)
    (set-time! *v-mirage-damage-immunity-cooldown-time*)
    (set! *v-mirage-damage-immunity-cooldown-active?* #t))
  (when (and (= *v-mirage-ability-loadout* 3)
             (not (logtest? (vehicle-flag turbo-boost) (-> this v-flags))))
    (set! (-> this turbo-ready) (fmin 1.0 (+ (-> this turbo-ready) (* 0.5 (seconds-per-frame))))))
  (cond
    ((!= *v-mirage-ability-loadout* 7) (set! *v-mirage-regenerative-armor-active?* #f))
    ((and *v-mirage-regenerative-armor-active?*
          (time-elapsed? *v-mirage-regenerative-armor-time* (seconds 4)))
     (set! (-> this hit-points) (fmin 1.0 (+ (-> this hit-points) 0.033333335)))
     (if (>= (-> this hit-points) 1.0)
         (set! *v-mirage-regenerative-armor-active?* #f)
         (set-time! *v-mirage-regenerative-armor-time*))))
  (when (and *v-mirage-camouflage-active?*
             (or (time-elapsed? *v-mirage-camouflage-time* (seconds 10))
                 (!= *v-mirage-defense-loadout* 8)))
    (set! *v-mirage-camouflage-active?* #f)
    (set-time! *v-mirage-camouflage-cooldown-time*)
    (set! *v-mirage-camouflage-cooldown-active?* #t)
    (v-mirage-set-fade! (the-as wvehicle this) (the-as uint 128) #f))
  (cond
    (*v-mirage-camouflage-active?* (set! *v-mirage-jammer-fade-active?* #f))
    ((= *v-mirage-ability-loadout* 6)
     (unless *v-mirage-jammer-fade-active?*
       (set! *v-mirage-jammer-fade-active?* #t)
       (v-mirage-set-fade! (the-as wvehicle this) (the-as uint 115) #t)))
    (*v-mirage-jammer-fade-active?*
     (set! *v-mirage-jammer-fade-active?* #f)
     (v-mirage-set-fade! (the-as wvehicle this) (the-as uint 128) #f)))
  (none))

(defmethod deactivate ((this v-mirage))
  (when (or *v-mirage-camouflage-active?* *v-mirage-jammer-fade-active?*)
    (v-mirage-set-fade! (the-as wvehicle this) (the-as uint 128) #f))
  (set! *v-mirage-camouflage-active?* #f)
  (set! *v-mirage-jammer-fade-active?* #f)
  (set! *v-mirage-damage-immunity-active?* #f)
  ((method-of-type wcar-snake-base deactivate) this)
  (none))

(defmethod apply-damage ((this v-mirage) (amount float) (impact rigid-body-impact))
  (when (and *v-mirage-vehicle-toughness-equipped?*
             (logtest? (-> *game-info* secrets) (game-secrets hero-mode))
             (logtest? (vehicle-flag player-driving) (-> this v-flags)))
    (set! amount (/ amount 2)))
  (when *v-mirage-damage-immunity-active?* (set! amount 0.0))
  (when (and (= *v-mirage-ability-loadout* 7) (> amount 0.0))
    (set-time! *v-mirage-regenerative-armor-time*)
    (set! *v-mirage-regenerative-armor-active?* #t))
  ((method-of-type wcar-base apply-damage) this amount impact)
  (none))

(defmethod vehicle-method-77 ((this v-mirage))
  (v-mirage-update-loadout! this)
  ((method-of-type wvehicle vehicle-method-77) this)
  (none))


;; WARN: Return type mismatch (pointer process) vs none.
(defmethod wvehicle-method-169 ((this v-mirage))
  (sound-play "toad-shot-fire")
  (set! (-> this i-barrel) (logand (+ (-> this i-barrel) 1) 1))
  (let ((gp-1 (new 'stack-no-clear 'wcar-toad-stack-var0)))
    (set! (-> gp-1 barrel-idx) (-> this i-barrel))
    (set! (-> gp-1 vec10 x) 61440.0)
    (set! (-> gp-1 vec10 y) 204800.0)
    (set! (-> gp-1 vec10 z) 409600.0)
    (set! (-> gp-1 vec10 w) 163840.0)
    (matrix-copy! (-> gp-1 mat0) (-> this rbody matrix))
    (let ((v1-10 (new 'static 'inline-array vector 2
                   (new 'static 'vector :x 3686.4 :y 5324.8 :z 6144.0 :w 1.0)
                   (new 'static 'vector :x -3686.4 :y 5324.8 :z 6144.0 :w 1.0)
                   )
                 )
          )
      (vector-matrix*! (-> gp-1 vec0) (-> v1-10 (-> gp-1 barrel-idx)) (-> gp-1 mat0))
      )
    0
    (vector-reset! (-> gp-1 vec4))
    (set! (-> gp-1 vec4 z) (-> gp-1 vec10 y))
    (set! (-> gp-1 vec4 y) (* 0.2678 (-> gp-1 vec10 y)))
    (vector-copy! (-> gp-1 vec8) (-> gp-1 mat0 fvec))
    (vector-float*! (-> gp-1 vec9) (-> gp-1 vec8) (- (-> gp-1 vec10 z) (-> gp-1 vec10 x)))
    (vector+float*! (-> gp-1 vec3) (-> gp-1 vec0) (-> gp-1 vec8) (+ 32768.0 (-> gp-1 vec10 x)))
    (let ((s4-1 (new 'stack 'boxed-array collide-shape 128)))
      (set! (-> s4-1 length) (fill-actor-list-for-sphere
                               *actor-hash*
                               (-> gp-1 vec3)
                               (-> gp-1 vec9)
                               (-> gp-1 vec10 x)
                               (the-as (pointer collide-shape) (-> s4-1 data))
                               (-> s4-1 allocated-length)
                               -1
                               )
            )
      (let ((s4-2 (find-nearest-focusable
                    (the-as (array collide-shape) s4-1)
                    (-> gp-1 vec3)
                    (-> gp-1 vec10 z)
                    (search-info-flag attackable enemy attackable-priority high-priority)
                    (search-info-flag)
                    (-> gp-1 vec1)
                    (the-as vector #f)
                    8192.0
                    )
                  )
            )
        (when s4-2
          (vector-copy! (-> gp-1 vec6) (get-trans s4-2 3))
          (vector-copy! (-> gp-1 vec7) (get-transv s4-2))
          (vector+float*! (-> gp-1 vec2) (-> this rbody lin-velocity) (-> gp-1 vec8) (-> gp-1 vec10 y))
          (vector-! (-> gp-1 vec5) (-> gp-1 vec6) (-> gp-1 vec0))
          (set! (-> gp-1 vec11 x) (vector-dot (-> gp-1 vec8) (-> gp-1 vec5)))
          (vector-! (-> gp-1 vec5) (-> gp-1 vec7) (-> gp-1 vec2))
          (set! (-> gp-1 vec11 y) (vector-dot (-> gp-1 vec8) (-> gp-1 vec5)))
          (set! (-> gp-1 vec11 w) (fmax 0.1 (/ (-> gp-1 vec11 x) (fmax 4096.0 (- (-> gp-1 vec11 y))))))
          (set! (-> gp-1 vec11 z) (+ (-> gp-1 vec6 y) (* (-> gp-1 vec11 w) (-> gp-1 vec7 y))))
          (set! (-> gp-1 vec4 y) (+ (* (/ 1.0 (-> gp-1 vec11 w)) (- (-> gp-1 vec11 z) (-> gp-1 vec0 y)))
                                    (* (/ (-> gp-1 vec11 w) 2) (-> gp-1 vec10 w))
                                    )
                )
          (set! (-> gp-1 vec4 y) (* (-> gp-1 vec4 y) (/ 1.0 (fmax 0.1 (-> gp-1 mat0 uvec y)))))
          (set! (-> gp-1 vec4 y) (fmax (fmin (-> gp-1 vec4 y) (* 0.3638 (-> gp-1 vec10 y))) (* 0.0 (-> gp-1 vec10 y))))
          0
          )
        )
      )
    (vector-rotate*! (-> gp-1 vec2) (-> gp-1 vec4) (-> gp-1 mat0))
    (vector+! (-> gp-1 vec2) (-> gp-1 vec2) (-> this rbody lin-velocity))
    (set! (-> gp-1 params ent) (-> this entity))
    (set! (-> gp-1 params charge) 1.0)
    (set! (-> gp-1 params options) (projectile-options))
    (logclear! (-> gp-1 params options) (projectile-options po14 po15 po16))
    (set! (-> gp-1 params pos quad) (-> gp-1 vec0 quad))
    (vector-copy! (-> gp-1 params vel) (-> gp-1 vec2))
    (set! (-> gp-1 params notify-handle) (the-as handle #f))
    (set! (-> gp-1 params owner-handle) (process->handle this))
    (set! (-> gp-1 params target-handle) (the-as handle #f))
    (set! (-> gp-1 params target-pos quad) (the-as uint128 0))
    (set! (-> gp-1 params ignore-handle) (process->handle this))
    (let* ((v1-60 *game-info*)
           (a0-37 (+ (-> v1-60 attack-id) 1))
           )
      (set! (-> v1-60 attack-id) a0-37)
      (set! (-> gp-1 params attack-id) a0-37)
      )
    (set! (-> gp-1 params timeout) (seconds 4))
    (spawn-projectile v-toad-shot (-> gp-1 params) *rigid-body-queue-manager* *default-dead-pool*)
    )
  (none)
  )

(defmethod vehicle-method-62 ((this v-mirage))
  (let ((s5-0 (-> this root root-prim)))
    (mem-copy!
      (the-as pointer (-> (the-as collide-shape-prim-group s5-0) child 0 local-sphere))
      (the-as pointer (new 'static 'vector :x 8192.0 :y 1638.4 :z 7864.32 :w 3276.8))
      16
      )
    (mem-copy!
      (the-as pointer (-> (the-as collide-shape-prim-group s5-0) child 1 local-sphere))
      (the-as pointer (new 'static 'vector :x -8192.0 :y 1638.4 :z 7864.32 :w 3276.8))
      16
      )
    (mem-copy!
      (the-as pointer (-> (the-as collide-shape-prim-group s5-0) child 2 local-sphere))
      (the-as pointer (new 'static 'vector :x 9011.2 :y 2048.0 :z -11878.4 :w 4915.2))
      16
      )
    (mem-copy!
      (the-as pointer (-> (the-as collide-shape-prim-group s5-0) child 3 local-sphere))
      (the-as pointer (new 'static 'vector :x -9011.2 :y 2048.0 :z -11878.4 :w 4915.2))
      16
      )
    (mem-copy!
      (the-as pointer (-> (the-as collide-shape-prim-group s5-0) child 4 local-sphere))
      (the-as pointer (new 'static 'vector :y 3276.8 :z 9011.2 :w 4505.6))
      16
      )
    (mem-copy!
      (the-as pointer (-> (the-as collide-shape-prim-group s5-0) child 5 local-sphere))
      (the-as pointer (new 'static 'vector :y 3686.4 :z -1638.4 :w 6144.0))
      16
      )
    (mem-copy!
      (the-as pointer (-> (the-as collide-shape-prim-group s5-0) child 6 local-sphere))
      (the-as pointer (new 'static 'vector :y 3276.8 :z -11878.4 :w 5734.4))
      16
      )
    (set! (-> (the-as collide-shape-prim-group s5-0) child 7 local-sphere w) 20889.6)
    )
  ((method-of-type wcar-base vehicle-method-62) this)
  0
  (none)
  )

(defmethod init-rbody-control! ((this v-mirage))
  (initialize-skeleton
    this
    (the-as skeleton-group (art-group-get-by-name *level* "skel-v-mirage" (the-as (pointer level) #f)))
    (the-as pair 0)
    )
  (setup-masks (-> this draw) 0 -1)
  (setup-masks (-> this draw) 1 0)
  (setup-masks (-> this draw) 2 0)
  (alloc-rbody-control! this *v-mirage-constants*)
  ;; 300 game ticks per second in this game
  (set! (-> this shoot-delay) (the-as uint 200))
  (set! (-> this local-gun-pos 0 quad) (-> (new 'static 'vector :x 3686.4 :y 5324.8 :z 6144.0 :w 1.0) quad))
  (vector-copy! (-> this local-gun-pos 1) (new 'static 'vector :x -3686.4 :y 5324.8 :z 6144.0 :w 1.0))
  (set! (-> this rider-hand-joint-array 0) 17)
  ((method-of-type joint-mod-rotate-local init)
   (-> this jmod-axles 0)
   this
   (the-as uint 5)
   (joint-mod-base-flags attached)
   )
  (init (-> this jmod-axles 1) this (the-as uint 6) (joint-mod-base-flags attached))
  (init (-> this jmod-axles 2) this (the-as uint 4) (joint-mod-base-flags attached))
  (init (-> this jmod-axles 3) this (the-as uint 7) (joint-mod-base-flags attached))
  ((method-of-type joint-mod-rotate-local init)
   (-> this jmod-shock-tops 0)
   this
   (the-as uint 11)
   (joint-mod-base-flags attached)
   )
  (init (-> this jmod-shock-tops 1) this (the-as uint 15) (joint-mod-base-flags attached))
  (init (-> this jmod-shock-tops 2) this (the-as uint 9) (joint-mod-base-flags attached))
  (init (-> this jmod-shock-tops 3) this (the-as uint 13) (joint-mod-base-flags attached))
  ((method-of-type joint-mod-set-local init)
   (-> this jmod-shock-mids 0)
   this
   (the-as uint 12)
   (joint-mod-base-flags attached trans)
   )
  (init (-> this jmod-shock-mids 1) this (the-as uint 16) (joint-mod-base-flags attached trans))
  (init (-> this jmod-shock-mids 2) this (the-as uint 10) (joint-mod-base-flags attached trans))
  (init (-> this jmod-shock-mids 3) this (the-as uint 14) (joint-mod-base-flags attached trans))
  ((method-of-type joint-mod-add-local init)
   (the-as joint-mod-add-local (-> this jmod-guns))
   this
   (the-as uint 18)
   (joint-mod-base-flags attached trans)
   )
  ((method-of-type joint-mod-add-local init)
   (the-as joint-mod-add-local (-> this jmod-guns 1))
   this
   (the-as uint 19)
   (joint-mod-base-flags attached trans)
   )
  (spawn-wheels!
    this
    (the-as skeleton-group (art-group-get-by-name *level* "skel-v-fox-wheel" (the-as (pointer level) #f)))
    (the-as skeleton-group (art-group-get-by-name *level* "skel-v-fox-wheel-blur" (the-as (pointer level) #f)))
    (the-as skeleton-group #f)
    (the-as skeleton-group #f)
    )
  0
  (none)
  )
