    (set! (-> this avg-drive-wheel-radius) (/ (-> v1-19 float0) (the float (-> v1-19 byte0))))
    (set! (-> this wheel-rev) (/ (-> v1-19 float2) (-> this avg-drive-wheel-radius)))
