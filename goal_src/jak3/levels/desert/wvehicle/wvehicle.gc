                     (- (the-as uint (-> s4-0 mat uvec w)) (the-as uint (-> this shift-time))))
             (set! (-> this shift-state) (the-as uint 3))
             (set! (-> this shift-time) (the-as uint (-> s4-0 mat uvec w)))
             )
           )
          ((= v1-47 3)
           (seek! (-> this clutch-grab) (-> s4-0 mat uvec z)
                  (* (if (tough-puppy-manual-gears-active? this)
                         (tough-puppy-clutch-release-rate this) 8.0) arg0))
           (when (!= (-> this next-gear-select) (-> this gear-select))
             (set! (-> this shift-state) (the-as uint 1))
             (set! (-> this shift-time) (the-as uint (-> s4-0 mat uvec w)))
             )
           (when (= (-> this clutch-grab) (-> s4-0 mat uvec z))
             (set! (-> this shift-state) (the-as uint 0))
             (set! (-> this shift-time) (the-as uint (-> s4-0 mat uvec w)))
             )
           )
          )
        )
      )
    (set! (-> this gear-ratio) (wvehicle-effective-gear-ratio this))
    (set! (-> this final-drive-ratio)
          (v-turtle-tuning-final-drive this (-> s5-0 transmission final-drive-ratio)))
    (set! (-> this total-gear-ratio) (* (-> this final-drive-ratio) (-> this gear-ratio)))
    (set! (-> this inv-total-gear-ratio) (/ 1.0 (-> this total-gear-ratio)))
    (set! (-> this engine-max-torque)
          (v-turtle-tuning-engine-torque this (-> s5-0 engine max-torque)))
    (set! (-> this clutch-inertia) (* 0.0 (-> s5-0 transmission inertia)))
    )
  0
  (none)
  )

(defmethod wvehicle-method-163 ((this wvehicle))
  (let ((s5-0 (-> this info))
        (s4-0 (new 'stack-no-clear 'matrix))
        )
    (set! (-> s4-0 rvec z) (-> this controls throttle))
    (set! (-> s4-0 uvec x) (vector-dot (-> this rbody matrix rvec) (-> this rbody ang-velocity)))
    (set! (-> s4-0 rvec w) (-> this rbody matrix fvec y))
    (set! (-> s4-0 uvec y) (+ (-> s4-0 rvec w) (* -1.0 (-> s4-0 uvec x))))
    (if (and (< (cos 12743.111) (-> s4-0 rvec w))
             (< (-> s4-0 uvec x) -0.1)
             (and (< 1.0 (-> s4-0 uvec y))
                  (not (logtest? (-> this wheel 0 flags) 2))
                  (not (logtest? (-> this wheel 1 flags) 2))
                  (logtest? (-> this wheel 2 flags) 2)
                  (logtest? (-> this wheel 3 flags) 2)
                  )
             )
        (set! (-> s4-0 rvec z) 0.0)
        )
    (set! (-> this engine-torque)
          (if (tough-puppy-engine-stalled? this) 0.0
              (wvehicle-method-166 this (-> this engine-rpm) (-> s4-0 rvec z))))
    (when (and (tough-puppy-manual-gears-active? this)
               (not (tough-puppy-engine-stalled? this)))
      ;; Poor clutch engagement temporarily chokes positive engine output. The
      ;; car keeps moving, but acceleration falls away until the bog clears.
      (when (and (> *tough-puppy-bog-remaining* 0.0)
                 (> (-> this engine-torque) 0.0))
        (set! (-> this engine-torque)
              (* (-> this engine-torque)
                 (fmax 0.18 (- 1.0 (* 0.75 *tough-puppy-bog-severity*))))))
      ;; Low-RPM/high-gear lugging: weak, lightly surging torque, not camera shake.
      (when (and (> (-> this gear-select) 1) (< (-> this engine-rpm) 1800.0)
                 (> (-> this engine-torque) 0.0))
        (set! (-> this engine-torque)
              (* (-> this engine-torque)
                 (fmax 0.25 (fmin 1.0 (/ (-> this engine-rpm) 1800.0)))
                 (+ 0.92 (* 0.08 (sin (* 1747.6267 (the float (current-time)))))))))
      ;; Closed-throttle pumping drag is transmitted only through the clutch.
      (when (and (< (-> this controls throttle) 0.05)
                 (> (-> this engine-rpm) (+ (-> this info engine idle-rpm) 200.0)))
        (set! (-> this engine-torque)
              (* -1.0 (tough-puppy-engine-braking this) (-> this engine-max-torque)
                 (/ (-> this engine-rpm) (-> this info engine peak-torque-rpm))))))
    (let ((f0-13 0.0))
      (dotimes (v1-23 (-> s5-0 physics-model wheel-count))
        (let ((a0-9 (-> this wheel v1-23 info)))
          (if (wvehicle-wheel-driven? this a0-9)
              (+! f0-13 (-> a0-9 inertia))
              )
