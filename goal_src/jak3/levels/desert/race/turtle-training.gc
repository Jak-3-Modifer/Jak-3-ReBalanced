(deftype turtle-training-goal (structure)
  ((pos  vector  :inline)
   )
  )


(deftype task-manager-desert-turtle-training (task-manager)
  ((goal-array       turtle-training-goal  7 :inline)
   (door-plane       vector                :inline)
   (start-pos        vector                :inline)
   (goal-pos         vector                :inline)
   (player-pos       vector                :inline)
   (player-vel       vector                :inline)
   (player-controls  vehicle-controls      :inline)
   (test-time        time-frame)
   (max-count        int16)
   (show-message?    symbol)
   )
  (:methods
    (print-training-text (_type_ text-id) none)
    )
  )


(defmethod set-time-limit ((this task-manager-desert-turtle-training))
  (let ((t9-0 (method-of-type task-manager set-time-limit)))
    (t9-0 this)
    )
  (vector-copy! (-> this start-pos) (new 'static 'vector :x 11540444.0 :y 91835.19 :z 956374.6 :w 1.0))
  (vector-copy! (-> this door-plane) (new 'static 'vector :z 1.0 :w 1.0))
  (set! (-> this door-plane w)
        (- (vector-dot (-> this door-plane) (new 'static 'vector :x 9277440.0 :y 125747.2 :z 957235.2 :w 1.0)))
        )
  (set! (-> this max-count) 0)
  (let ((a0-8 (entity-by-name "training-1")))
    (when a0-8
      (let* ((sv-16 (new 'static 'res-tag))
             (v1-7 (res-lump-data a0-8 'actor-groups (pointer actor-group) :tag-ptr (& sv-16)))
             )
        (cond
          ((and v1-7 (nonzero? (-> sv-16 elt-count)))
           (set! (-> this max-count) (-> v1-7 0 length))
           (dotimes (a0-13 (-> this max-count))
             (let ((a1-7 (-> v1-7 0 data a0-13 actor)))
               (vector-copy! (-> this goal-array a0-13 pos) (-> a1-7 extra trans))
               )
             )
           )
          (else
            (format 0 "ERROR: task-manager-desert-turtle-training: missing actor-group!~%")
            )
          )
        )
      )
    )
  (spawn-dust-storm-randomizer this)
  (none)
  )

(defmethod print-training-text ((this task-manager-desert-turtle-training) (arg0 text-id))
  (let ((hero-clutch-text?
          (and (= arg0 (text-id text-0587))
               (logtest? (-> *game-info* secrets) (game-secrets hero-mode))))
        (hero-compact-text?
          (and (or (= arg0 (text-id text-0587)) (= arg0 (text-id text-0589)))
               (logtest? (-> *game-info* secrets) (game-secrets hero-mode))))
        (s5-0
          (new 'stack 'font-context *font-default-matrix* 70 20 0.0 (font-color orange) (font-flags shadow kerning))
          )
        )
    (set-scale! s5-0 (if hero-compact-text? 0.48 0.7))
    (set-width! s5-0 (if hero-compact-text? 464 370))
    (set-height! s5-0 (if hero-compact-text? 82 70))
    (set! (-> s5-0 origin x)
          (the float (- (if hero-compact-text? 256 201) (the int (/ (-> s5-0 width) 2)))))
    (set! (-> s5-0 origin y) (if hero-compact-text? 276.0 290.0))
    (set! (-> s5-0 flags) (font-flags shadow kerning middle-vert large))
    (let ((s4-0 print-game-text))
      (if hero-clutch-text?
          (format (clear *temp-string*)
                  "Blue bar: engine RPM. Orange marker: target RPM.~%Hold <PAD_L2>, shift with <PAD_DPAD_UP> or <PAD_DPAD_DOWN>, then match the markers.")
          (format (clear *temp-string*) (lookup-text! *common-text* arg0 #f) 1))
      ;; Text from the localization database is already encoded for the game
      ;; font.  Only encode the source-authored Hero string containing PAD tags.
      (if hero-clutch-text?
          (begin
            (pc-encode-utf8-string *temp-string* *pc-encoded-temp-string*)
            (s4-0 *pc-encoded-temp-string* s5-0 #f
                  (if hero-compact-text? 68 44)
                  (bucket-id hud-draw-hud-alpha)))
          (s4-0 *temp-string* s5-0 #f
                (if hero-compact-text? 68 44)
                (bucket-id hud-draw-hud-alpha)))
      )
    )
  0
  (none)
  )

(defun print-hero-training-text ((this task-manager-desert-turtle-training) (arg0 string))
  (let ((font
          (new 'stack 'font-context *font-default-matrix* 70 20 0.0
               (font-color orange) (font-flags shadow kerning))))
    ;; Wide, compact two-line box that stays inside the 4:3 safe area.
    (set-scale! font 0.48)
    (set-width! font 464)
    (set-height! font 82)
    (set! (-> font origin x) 24.0)
    (set! (-> font origin y) 276.0)
    (set! (-> font flags) (font-flags shadow kerning middle-vert large))
    (format (clear *temp-string*) arg0)
    ;; The hero lessons are authored in source rather than the text database,
    ;; so run their controller tags through the same PC encoding path.
    (pc-encode-utf8-string *temp-string* *pc-encoded-temp-string*)
    (print-game-text *pc-encoded-temp-string* font #f 68 (bucket-id hud-draw-hud-alpha)))
  (none)
  )

(defun turtle-training-spawn-arrow! ((this task-manager-desert-turtle-training))
  (let ((params (new 'stack-no-clear 'task-arrow-params)))
    (vector-copy! (-> params pos) (-> this goal-pos))
    (quaternion-identity! (-> params quat))
    (set! (-> params flags) (task-arrow-flags))
    (set! (-> params map-icon) (the-as uint 12))
    (set! (-> this arrow) (process->handle (task-arrow-spawn params this))))
  (none)
  )

(defmethod task-manager-method-26 ((this task-manager-desert-turtle-training))
  (let ((t9-0 (method-of-type task-manager task-manager-method-26)))
    (t9-0 this)
    )
  (let ((a0-3 (handle->process (-> this player-vehicle))))
    (when (not a0-3)
      (let ((v1-5 *target*))
        (if (and v1-5 (focus-test? v1-5 pilot-riding))
            (set! (-> this player-vehicle) (-> v1-5 pilot vehicle))
            )
        )
      )
    (when a0-3
      (vector-copy! (-> this player-pos) (-> (the-as process-drawable a0-3) root trans))
      (vector-copy! (-> this player-vel) (-> (the-as process-drawable a0-3) root transv))
      (copy-vehicle-controls! (the-as wvehicle a0-3) (-> this player-controls))
      0
      )
    )
  0
  (none)
  )

(defstate active (task-manager-desert-turtle-training)
  :virtual #t
  :code (behavior ()
    (set-setting! 'pilot-exit #f 0.0 0)
    (set-setting! 'pilot-death #t 0.0 0)
    (set-setting! 'scarf 'abs 1.0 0)
    (set-setting! 'goggles 'abs 1.0 0)
    (let ((t1-4 1))
      (set-setting! 'vehicles 'set (shr t1-4 32) t1-4)
      )
    (add-process *gui-control* self (gui-channel query) (gui-action play) (-> self name) -99.0 0)
    (while (not (handle->process (-> self player-vehicle)))
      (suspend)
      )
    (suspend)
    (send-event (handle->process (-> self player-vehicle)) 'ignore-damage #t)
    (set-time! (-> self test-time))
    ;Time to get your clutch lessons in fellas
    (when (not (logtest? (-> *game-info* secrets) (game-secrets hero-mode)))
      (vector-copy! (-> self goal-pos) (-> self goal-array 0 pos))
      (turtle-training-spawn-arrow! self))
    ;; Keep the original opening delay, but do not print the automatic-
    ;; transmission "Hold X to accelerate" prompt.
    (suspend-for (seconds 4)
      (format 0 "")
      )
    (suspend-for (seconds 0.25)
      )
    ;; Hero Mode first teaches the manual Turtle before revealing checkpoint 1.
    ;; Normal Mode keeps the original automatic-transmission lesson flow.
    (when (logtest? (-> *game-info* secrets) (game-secrets hero-mode))
      (let ((vehicle (the-as wvehicle (handle->process (-> self player-vehicle))))
            (damaged-hp 0.0))
        ;; Stop one, Start the stalled engine and make one smooth launch in first gear.
        (when vehicle
          (set! (-> vehicle gear-select) 1)
          (set! (-> vehicle next-gear-select) 1)
          (set! (-> vehicle v-flags)
                (the-as vehicle-flag
                        (logclear (-> vehicle v-flags) (vehicle-flag reverse-gear))))
          (tough-puppy-stall-engine! vehicle))
        (until (and vehicle
                    (not (tough-puppy-engine-stalled? vehicle))
                    (= (-> vehicle gear-select) 1)
                    (= (-> vehicle shift-state) 0)
                    (not (cpad-hold? 0 l2))
                    (< 20480.0 (vector-length (-> self player-vel))))
          (print-hero-training-text
            self
            "While holding <PAD_L2>, hold <PAD_X> to rev the engine.~%Release <PAD_L2> to accelerate.")
          (set! vehicle (the-as wvehicle (handle->process (-> self player-vehicle))))
          (suspend))
        (sound-play "special-pickup")
        (suspend-for (seconds 0.35))

        ;; 2. shift that gear nice and good, like a good boy
        (until (and vehicle
                    (= (-> vehicle gear-select) 2)
                    (= (-> vehicle shift-state) 0)
                    (not (cpad-hold? 0 l2))
                    (not (tough-puppy-engine-stalled? vehicle)))
          (print-hero-training-text
            self
            "Hold <PAD_L2>, press <PAD_DPAD_UP> to shift to Gear 2,~%then release <PAD_L2>.")
          (set! vehicle (the-as wvehicle (handle->process (-> self player-vehicle))))
          (suspend))
        (sound-play "special-pickup")
        (suspend-for (seconds 0.35))
        (until (and vehicle
                    (= (-> vehicle gear-select) 3)
                    (= (-> vehicle shift-state) 0)
                    (not (cpad-hold? 0 l2))
                    (not (tough-puppy-engine-stalled? vehicle)))
          (print-hero-training-text
            self
            "Hold <PAD_L2>, press <PAD_DPAD_UP> to shift to Gear 3,~%then release <PAD_L2>.")
          (set! vehicle (the-as wvehicle (handle->process (-> self player-vehicle))))
          (suspend))
        (sound-play "special-pickup")
        (suspend-for (seconds 0.35))

        ;; #3 Let the player identify to not redline the engine or they will die a fiery death HAHHAHA!!!!!!!!
        (until (and vehicle
                    (>= (-> vehicle engine-rpm) (* 0.75 (-> vehicle info engine max-rpm)))
                    (< (-> vehicle engine-rpm) (* 0.9 (-> vehicle info engine max-rpm))))
          (print-hero-training-text
            self
            "The number shows your current gear.~%The bar shows engine speed. Shift before entering the red section.")
          (set! vehicle (the-as wvehicle (handle->process (-> self player-vehicle))))
          (suspend))
        (sound-play "special-pickup")
        (suspend-for (seconds 5)
          (print-hero-training-text
            self
            "The number shows your current gear.~%The bar shows engine speed. Shift before entering the red section."))

        ;; 4. Damage the Turtle by three HP, then let the shared clean-shift
        ;; reward prove itself by restoring at least one HP.
        ;; Refresh the rider vehicle after the timed prompt; the previous
        ;; process handle may no longer be valid after a level/task transition.
        (set! vehicle (the-as wvehicle (handle->process (-> self player-vehicle))))
        (when vehicle
          (set! damaged-hp
                (fmax 0.1
                      (- (-> vehicle hit-points)
                         (* 3.0 (-> vehicle info damage inv-hit-points)))))
          (set! (-> vehicle hit-points) damaged-hp))
        (until (and vehicle (> (-> vehicle hit-points) damaged-hp))
          (print-hero-training-text
            self
            "Hold <PAD_L2>, select <PAD_DPAD_UP_DOWN> and match the blue bar end with the orange marker.~%Release <PAD_L2> for a clean shift.")
          (set! vehicle (the-as wvehicle (handle->process (-> self player-vehicle))))
          (suspend))
        (sound-play "g-eco-pickup")
        (set! (-> vehicle draw color-emissive y) 0.8)
        (suspend-for (seconds 0.3)
          (print-hero-training-text self "Clean shift! Vehicle HP restored."))
        (set! (-> vehicle draw color-emissive y) 0.0)))
    (when (logtest? (-> *game-info* secrets) (game-secrets hero-mode))
      (vector-copy! (-> self goal-pos) (-> self goal-array 0 pos))
      (turtle-training-spawn-arrow! self))
    (set! (-> self time-limit) (seconds 30))
    (set-time! (-> self start-time))
    (until #f
      (print-training-text self (text-id text-0583))
      (if (< 102400.0 (vector-length (-> self player-vel)))
          (goto cfg-29)
          )
      (suspend)
      )
    #f
    (until #f
      (label cfg-29)
      (if (< (vector-vector-xz-distance (-> self player-pos) (-> self goal-pos)) 40960.0)
          (goto cfg-33)
          )
      (suspend)
      )
    #f
    (label cfg-33)
    (sound-play "special-pickup")
    (send-event (handle->process (-> self arrow)) 'leave)
    (set! (-> self arrow) (the-as handle #f))
    (send-event (handle->process (-> self hud-timer)) 'hide-and-die)
    (set! (-> self start-time) 0)
    (suspend-for (seconds 0.25)
      )
    (set! (-> self show-message?) #f)
    (vector-copy! (-> self goal-pos) (-> self goal-array 1 pos))
    (let ((gp-5 (new 'stack-no-clear 'task-arrow-params)))
      (vector-copy! (-> gp-5 pos) (-> self goal-pos))
      (quaternion-identity! (-> gp-5 quat))
      (set! (-> gp-5 flags) (task-arrow-flags))
      (set! (-> gp-5 map-icon) (the-as uint 12))
      (set! (-> self arrow) (process->handle (task-arrow-spawn gp-5 self)))
      )
    (set! (-> self time-limit) (seconds 30))
    (set-time! (-> self start-time))
    (until #f
      (if (< (vector-vector-xz-distance (-> self player-pos) (-> self goal-pos)) 245760.0)
          (set! (-> self show-message?) #t)
          )
      (when (-> self show-message?)
        (print-training-text self (text-id text-0584))
        (if (and (< 0.1 (-> self player-controls brake)) (< (vector-length (-> self player-vel)) 8192.0))
            (goto cfg-68)
            )
        )
      (suspend)
      )
    #f
    (label cfg-68)
    (sound-play "special-pickup")
    (send-event (handle->process (-> self arrow)) 'leave)
    (set! (-> self arrow) (the-as handle #f))
    (send-event (handle->process (-> self hud-timer)) 'hide-and-die)
    (set! (-> self start-time) 0)
    (suspend-for (seconds 0.25)
      )
    (set! (-> self time-limit) (seconds 28))
    (set-time! (-> self start-time))
    (set-time! (-> self test-time))
    (if (logtest? (-> *game-info* secrets) (game-secrets hero-mode))
        (let ((vehicle (the-as wvehicle (handle->process (-> self player-vehicle)))))
          (when vehicle
            ;; 6. The brake checkpoint becomes a controlled stall-and-restart
            ;; lesson. Stop all residual motion so the relaunch is unambiguous.
            (vector-reset! (-> vehicle rbody lin-velocity))
            (vector-reset! (-> vehicle rbody ang-velocity))
            (set! (-> vehicle gear-select) 1)
            (set! (-> vehicle next-gear-select) 1)
            (tough-puppy-stall-engine! vehicle))
          (until #f
            (print-hero-training-text
              self
              "Hold <PAD_L2> and press <PAD_X> to restart and rev the engine.~%Release <PAD_L2> to move.")
            (set! vehicle (the-as wvehicle (handle->process (-> self player-vehicle))))
            (when (and vehicle
                       (not (tough-puppy-engine-stalled? vehicle))
                       (= (-> vehicle gear-select) 1)
                       (= (-> vehicle shift-state) 0)
                       (not (cpad-hold? 0 l2))
                       (< 20480.0 (vector-length (-> self player-vel))))
              (goto cfg-91))
            (suspend)))
        (until #f
          (print-training-text self (text-id text-0587))
          (if (not (cpad-hold? 0 l2))
              (set-time! (-> self test-time))
              )
          (if (time-elapsed? (-> self test-time) (seconds 0.665))
              (goto cfg-91)
              )
          (suspend)
          ))
    #f
    (label cfg-91)
    (sound-play "special-pickup")
    (send-event (handle->process (-> self hud-timer)) 'hide-and-die)
    (set! (-> self start-time) 0)
    (suspend-for (seconds 0.25)
      )
    (set! (-> self show-message?) #f)
    (vector-copy! (-> self goal-pos) (-> self goal-array 2 pos))
    (let ((gp-10 (new 'stack-no-clear 'task-arrow-params)))
      (vector-copy! (-> gp-10 pos) (-> self goal-pos))
      (quaternion-identity! (-> gp-10 quat))
      (set! (-> gp-10 flags) (task-arrow-flags))
      (set! (-> gp-10 map-icon) (the-as uint 12))
      (set! (-> self arrow) (process->handle (task-arrow-spawn gp-10 self)))
      )
    (set! (-> self time-limit) (seconds 30))
    (set-time! (-> self start-time))
    (until #f
      (let ((f0-5 (vector-vector-xz-distance (-> self player-pos) (-> self goal-pos))))
        (cond
          ((-> self show-message?)
           (if (< 163840.0 f0-5)
               (set! (-> self show-message?) #f)
               )
           )
          (else
            (if (< f0-5 40960.0)
                (begin
                  (set! (-> self show-message?) #t)
                  (set-time! (-> self test-time)))
                )
            )
          )
        )
      (when (-> self show-message?)
        (if (logtest? (-> *game-info* secrets) (game-secrets hero-mode))
            (print-hero-training-text
              self
              "If stalled, hold <PAD_L2> and <PAD_SQUARE> to rev the engine.~%Release <PAD_L2> to reverse.")
            (print-training-text self (text-id text-0588)))
        (let ((v1-176 (handle->process (-> self player-vehicle))))
          (when v1-176
            (if (and (logtest? (vehicle-flag reverse-gear) (-> (the-as wvehicle v1-176) v-flags))
                     (< 36864.0 (vector-length (-> self player-vel)))
                     (or (not (logtest? (-> *game-info* secrets) (game-secrets hero-mode)))
                         (time-elapsed? (-> self test-time) (seconds 8.45)))
                     )
