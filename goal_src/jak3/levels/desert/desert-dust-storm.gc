            (if (-> this is-intro?)
                (launch-particles (-> *part-id-table* 1422) s4-0)
                (launch-particles (-> *part-id-table* 1421) s4-0)
                )
            )
          )
        (#t
          (if (-> this is-intro?)
              (launch-particles (-> *part-id-table* 1422) s4-0)
              (launch-particles (-> *part-id-table* 1421) s4-0)
              )
          )
        )
      )
    )
  (none)
  )

;; WARN: Return type mismatch int vs handle.
(defun create-dust-storm ((arg0 process-tree) (arg1 level))
  (let ((s5-0 (get-process *default-dead-pool* desert-dust-storm #x4000 1)))
    (the-as
      handle
      (process->handle
        (-> (when s5-0
              (let ((t9-1 (method-of-type desert-dust-storm activate)))
                (t9-1 (the-as desert-dust-storm s5-0) arg0 "desert-dust-storm" (the-as pointer #x70004000))
                )
              (run-now-in-process s5-0 desert-dust-storm-init-by-other arg1 'track (target-pos 0))
              (-> s5-0 ppointer)
              )
            0
            )
        )
      )
    )
  )

(defmethod desert-dust-storm-method-20 ((this desert-dust-storm))
  (set! (-> this intensity-target) (-> *setting-control* user-current fog-special-interp-targ))
  (set! (-> this intensity-rate) (-> *setting-control* user-current fog-special-interp-rate))
  (seek! (-> this intensity) (-> this intensity-target) (* (-> this intensity-rate) (seconds-per-frame)))
  (let ((f28-0 (-> this intensity))
        (f30-0 (-> this intensity-rate))
        (s5-0 #f)
        )
    (cond
      ((and (-> this next-state) (= (-> this next-state name) 'hold-pos))
       (set! f28-0 (fmin 0.8 (-> this intensity)))
       (set! f30-0 0.3)
       (set! s5-0 #f)
       )
      ((< (vector-vector-xz-distance (math-camera-pos) (-> this fog-plane-origin)) 81920.0)
       (let ((s5-2 (vector-! (new 'stack-no-clear 'vector) (math-camera-pos) (-> this fog-plane-origin))))
         0.0
         0.0
         #t
         (let* ((f0-12 (vector-dot s5-2 (-> this fog-plane-dir)))
                (f0-13 (fmax 0.0 f0-12))
                (f1-5 (/ f0-13 (meters 15)))
                (f0-15 (fmax 0.0 (fmin 1.0 f1-5)))
                )
           (set! f28-0 (lerp (fmin 0.8 (-> this intensity)) (-> this intensity) f0-15))
           )
         )
       (set! f30-0 0.3)
       (set! s5-0 #t)
       )
      )
    (let* ((f1-10 (* f28-0 (-> *setting-control* user-current dust-storm-fog-scalar)))
           (f1-12 (fmax 0.0 (fmin 1.0 f1-10)))
           (v1-24 *mood-control*)
           (f0-19 (fmax 0.0 (fmin 1.0 f1-12)))
           )
      (set! (-> v1-24 target-special-interp) f0-19)
      (set! (-> v1-24 rate-special-interp) f30-0)
      (if s5-0
          (set! (-> v1-24 current-special-interp) f0-19)
          )
      )
    )
  0
  (when *target*
    (let* ((f30-1 (* 10.0 *duststorm-wind-vel*))
           (f28-1 0.5)
           (f26-0 3.5)
           (v1-33 (/ (the-as int (rand-uint31-gen *random-generator*)) 256))
           (v1-34 (the-as number (logior #x3f800000 v1-33)))
           (f30-2 (* f30-1 (+ f28-1 (* f26-0 (+ -1.0 (the-as float v1-34))))))
           (s5-3 (new 'stack-no-clear 'vector))
           )
      (vector-copy! s5-3 *duststorm-wind-vec*)
      (let* ((f28-2 -0.3)
             (f26-1 0.6)
             (v1-41 (/ (the-as int (rand-uint31-gen *random-generator*)) 256))
             (v1-42 (the-as number (logior #x3f800000 v1-41)))
             )
        (set! (-> s5-3 y) (+ f28-2 (* f26-1 (+ -1.0 (the-as float v1-42))) (-> s5-3 y)))
        )
      (vector-float*! s5-3 s5-3 f30-2)
      (let ((t1-0 (new 'static 'vector)))
        (vector-copy! t1-0 s5-3)
        (set-setting! 'global-wind #f 0.0 t1-0)
        )
      )
    (when (and (-> *setting-control* user-current duststorm-push-player?)
               (not (focus-test? *target* pilot-riding))
               (not (and (-> this next-state) (= (-> this next-state name) 'hold-pos)))
               )
      (let ((a0-18 (-> *target* control)))
        (if (or (not (and a0-18 (logtest? (-> a0-18 status) (collide-status on-surface))))
                (< 8192.0 (vector-length (get-transv *target*)))
                )
            (send-event
              *target*
              'push-trans
              (vector-float*! (new 'stack-no-clear 'vector) *duststorm-wind-vec* (* *duststorm-wind-vel* (seconds-per-frame))) ;; og:preserve-this normalize speed to per-sec instead of per-frame, and nerf to better match PS2 fps
              (seconds 0.11)
              )
            )
        )
      )
    )
  (let ((f0-36 (fmax 0.0 (fmin 1.0 (-> this intensity)))))
    0.0
    1.0
    (let* ((f1-24 (- 1.0 (* (- 1.0 f0-36) (- 1.0 f0-36))))
           (f30-4 (* (fmax 0.0 (fmin 1.0 f1-24)) (-> *setting-control* user-current dust-storm-sound-scalar)))
           (f28-3 (lerp 1.0 0.95 f30-4))
           (f1-29 (* (lerp 0.4 1.0 f30-4) (/ 1.0 f28-3)))
           (f0-43 (fmax 0.0 (fmin 1.0 f1-29)))
           )
      (if (= f30-4 0.0)
          (sound-stop (-> this wind-sound))
          (sound-play-by-name
            (static-sound-name "storm-wind")
            (-> this wind-sound)
            (the int (* 1024.0 f0-43))
            0
            0
            (sound-group)
            #t
            )
          )
      )
    )
  (cond
    ((< 1.0 (-> this intensity))
     (let ((f0-48 (+ -1.0 (-> this intensity))))
       0.0
       (let ((a2-8 (new 'stack-no-clear 'vector)))
         (vector-copy! a2-8 (-> *time-of-day-context* current-fog fog-color))
         (set! (-> a2-8 w) (* 128.0 f0-48))
         (set! (-> this enabled-screen-filter?) #t)
         (setup *screen-filter* a2-8 a2-8 10000.0
                ;;(bucket-id generic-sprite-1)
                ;; og:preserve-this
                ;; Modified to put this into a nearby bucket with same settings
                ;; that uses DirectRenderer in the C++ renderer.
                ;; otherwise, it goes to the Generic renderer, which doesn't know how to
                ;; handle drawing through Direct.
                (bucket-id tex-hud-pris2)
                 #x20000 #x30003 #t)
         )
       )
     )
    (else
      (when (-> this enabled-screen-filter?)
        (disable *screen-filter*)
        (set! (-> this enabled-screen-filter?) #f)
        )
      )
    )
  (if (not (paused?))
      (set! (-> *mood-control* current-special-interp)
            (seek
              (-> *mood-control* current-special-interp)
              (-> *mood-control* target-special-interp)
              (* (-> *mood-control* rate-special-interp) (seconds-per-frame))
              )
            )
      )
  )

(defun desert-activate ((arg0 level))
  (let ((v0-0 (create-dust-storm *entity-pool* arg0)))
    (set! (-> *game-info* dust-storm) v0-0)
    v0-0
    )
  )

;; WARN: Return type mismatch symbol vs none.
(defun desert-deactivate ()
  (send-event (handle->process (-> *game-info* dust-storm)) 'die)
  (set! (-> *game-info* dust-storm) (the-as handle #f))
  (none)
  )

;; Each level callback slot resolves only its first entry. Run both systems
;; through one callback instead of registering duplicate activation slots.
(defun desert-with-flut-activate ((owner level))
  (desert-activate owner)
  (desert-unlocked-flut-manager-activate owner)
  (none))

(defun desert-with-flut-deactivate ((owner level))
  (desert-unlocked-flut-manager-deactivate owner)
  (desert-deactivate)
  (none))

;; River Rock Collector: native GOAL orthographic prototype.
;; Coordinates are local meters inside the river, independently of the entry point.
;; Runtime economy only: never writes money, artifact fields, or save data.
(deftype river-rock (structure)
  ((id int32) (state int32) (appearance int32) (material int32)
   (fake int32) (capacity int32) (size int32) (scoops int32)
   (required int32) (swing int32) (selected symbol)
   (x float) (y float) (speed float) (age float) (partial-until float)
   (yield int32)))

(define *rr-rocks* (new 'static 'inline-array river-rock 256))
(define *rr-materials* (new 'static 'array int32 4))
(define *rr-capacities* (new 'static 'array int32 4 1 2 4 6))
(define *rr-yields* (new 'static 'array int32 4 1 2 3 4))
(define *rr-appearance-thresholds* (new 'static 'array int32 3 65 87 97))
(define *rr-fake-percent* (new 'static 'array int32 4 0 20 20 20))
;; Rows: net upgrade, carrying upgrade. Four material costs per upgrade.
(define *rr-upgrade-prices* (new 'static 'array int32 8 10 3 0 0 20 0 3 0))
(define *desert-resource-match-pos*
  (new 'static 'vector :x (meters 3033.70) :y (meters 8.63) :z (meters 1681.03) :w 1.0))
(define *rr-radius* (meters 3))
(define *rr-debug-marker?* #t)
(define *rr-debug-color* (new 'static 'rgba :r 32 :g 255 :b 160 :a 128))
(define *rr-open?* #f)
(define *rr-mode* 0) ;; 0 river, 1 inventory, 2 bank, 3 summary, 4 discard confirmation.
(define *rr-return-mode* 1)
(define *rr-tab* 0) ;; net / carrying inventory
(define *rr-cursor* 0)
(define *rr-round* 1)
(define *rr-time* 0.0)
(define *rr-duration* 90.0)
(define *rr-spawn-time* 0.0)
(define *rr-player-x* 0.0)
(define *rr-player-y* 17.0)
(define *rr-face-x* 0.0)
(define *rr-face-y* -1.0)
(define *rr-player-speed* 3.5)
(define *rr-current* 0.5)
(define *rr-net-max* 5)
(define *rr-player-max* 20)
(define *rr-next-id* 1)
(define *rr-swing-id* 0)
(define *rr-swing-age* 1.0)
(define *rr-windup* 0.15)
(define *rr-active* 0.20)
(define *rr-recovery* 0.40)
(define *rr-second-scoop-window* 1.5)
(define *rr-caught* 0)
(define *rr-deposited* 0)
(define *rr-goal* 8)
(define *rr-message* "")
(define *rr-notice-time* 0.0)
(define *rr-manager-handle* (new 'static 'array handle 1))
;; A zero-filled handle is not GOAL #f. Initialize before the activation
;; callback can pass it to handle->process during Desert startup.
(set! (-> *rr-manager-handle* 0) (the-as handle #f))
(define *rr-bank-inventory?* #f)

(defmacro rr-text (fmt &rest args)
  `(begin (format (clear *temp-string*) ,fmt ,@args) *temp-string*))

(defun rr-notice ((message string))
  (set! *rr-message* message) (set! *rr-notice-time* 2.5) (none))

(defun rr-used ((state int))
  (let ((total 0))
    (dotimes (i 256)
      (let ((rock (-> *rr-rocks* i)))
        (when (= (-> rock state) state) (+! total (-> rock capacity)))))
    total))

(defun rr-count ((state int))
  (let ((total 0))
    (dotimes (i 256) (when (= (-> *rr-rocks* i state) state) (1+! total)))
    total))

(defun rr-identity ((rock river-rock))
  (if (> (-> rock fake) 0)
      (case (-> rock appearance)
        ((1) "FOOL'S RED - ORDINARY ROCK") ((2) "FOOL'S BLUE - ORDINARY ROCK")
        (else "FOOL'S YELLOW - ORDINARY ROCK"))
      (case (-> rock material)
        ((0) "ORDINARY ROCK") ((1) "GENUINE RED ECO CRYSTAL")
        ((2) "GENUINE BLUE ECO CRYSTAL") (else "GENUINE YELLOW ECO CRYSTAL"))))

(defun rr-label ((text string) (x int) (y int) (scale float) (color font-color))
  (let ((font (new 'stack 'font-context *font-default-matrix* x y 0.0 color
                   (font-flags shadow kerning large))))
    ;; Native game font, independent of the PC debug-font scale setting.
    ;; Coordinates share the sprite renderer's 512 x 416 virtual canvas.
    (set-width! font (- 488 x)) (set-height! font 28) (set-scale! font scale)
    (pc-encode-utf8-string text *pc-encoded-temp-string*)
    (let ((width (-> (get-string-length *pc-encoded-temp-string* font) length)))
      (when (> width (-> font width))
        (set-scale! font (* scale (/ (-> font width) width)))))
    (print-game-text *pc-encoded-temp-string* font #f 44 (bucket-id hud-draw-hud-alpha)))
  (none))

;; Dedicated presentation data, supplied from the user's captured camera.
;; Coordinates are internal world units, not meters.
(define *rr-camera-position*
  (new 'static 'vector :x 12640663.0 :y 73928.539 :z 6901868.0 :w 1.0))
(define *rr-camera-rotation*
  (new 'static 'matrix
    :rvec (new 'static 'vector :x 0.1546 :z 0.9879)
    :uvec (new 'static 'vector :x -0.8331 :y 0.5375 :z 0.1303)
    :fvec (new 'static 'vector :x -0.5310 :y -0.8432 :z 0.0831)
    :trans (new 'static 'vector :w 1.0)))
(define *rr-camera-fov* (degrees 64))
(define *rr-saved-camera-position* (new 'static 'vector))
(define *rr-saved-camera-rotation* (new 'static 'matrix))
(define *rr-saved-camera-fov* (degrees 64))
(define *rr-presentation-handles* (new 'static 'array handle 3))
(dotimes (i 3) (set! (-> *rr-presentation-handles* i) (the-as handle #f)))
(define *rr-presentation-active?* #f)
(define *rr-player-was-hidden?* #f)
(define *rr-player-grab-owned?* #f)

(defun rr-presentation-enter ((owner process))
  (let ((ready? #f))
    (when (and *target* (-> *target* draw) *camera* *camera-combiner*
               (not *rr-presentation-active?*)
               (not (focus-test? *target* grabbed))
               (logtest? (-> *target* control status) (collide-status on-surface))
               (process-grab? *target* #f))
      ;; Hold only Jak with the normal scripted-interaction state. Keep the
      ;; global game clock, world actors, water, and ambience running.
      (set! *rr-player-grab-owned?* #t)
      (vector-copy! *rr-saved-camera-position* (-> *camera-combiner* trans))
      (matrix-copy! *rr-saved-camera-rotation* (-> *camera-combiner* inv-camera-rot))
      (set! *rr-saved-camera-fov* (-> *camera-combiner* fov))
      (set! *rr-player-was-hidden?*
        (logtest? (-> *target* draw status) (draw-control-status no-draw)))
      (set! (-> *rr-presentation-handles* 0) (process->handle *target*))
      (set! (-> *rr-presentation-handles* 1) (process->handle *camera*))
      (set! (-> *rr-presentation-handles* 2) (process->handle owner))
      (set! *rr-presentation-active?* #t)
      ;; Settings belong to this manager; existing camera settings remain below them.
      (set-setting *setting-control* owner 'mode-name 'cam-really-fixed 0.0 0)
      (set-setting *setting-control* owner 'fov 'hi *rr-camera-fov* 0)
      (set-setting *setting-control* owner 'allow-pause #f 0.0 0)
      (apply-settings *setting-control*)
      (send-event *target* 'draw #f)
      ;; Use the normal camera event once, never the debug-camera state each frame.
      (let ((pose (new 'stack 'transformq)))
        (vector-copy! (-> pose trans) *rr-camera-position*)
        (matrix->quaternion (-> pose quat) *rr-camera-rotation*)
        (quaternion-normalize! (-> pose quat))
        (send-event *camera* 'teleport-to-transformq pose))
      (when (-> *camera* slave)
        ;; cam-slave-init-vars may apply *camera-init-mat*. Seed the actual
        ;; controller, not just the combiner, so running frames retain our view.
        (vector-copy! (-> *camera* slave 0 trans) *rr-camera-position*)
        (vector-copy! (-> *camera* slave 0 saved-pt) *rr-camera-position*)
        (matrix-copy! (-> *camera* slave 0 tracking inv-mat) *rr-camera-rotation*)
        (set! (-> *camera* slave 0 fov) *rr-camera-fov*))
      (send-event *camera-combiner* 'stop-tracking)
      (set! ready? #t))
    ready?))

(defun rr-presentation-exit ()
  (when *rr-presentation-active?*
    (set! *rr-presentation-active?* #f)
    (let ((player (as-type (handle->process (-> *rr-presentation-handles* 0)) target))
          (camera (handle->process (-> *rr-presentation-handles* 1)))
          (owner (handle->process (-> *rr-presentation-handles* 2))))
      (when owner
        (remove-setting *setting-control* owner 'mode-name)
        (remove-setting *setting-control* owner 'fov)
        (remove-setting *setting-control* owner 'allow-pause)
        (apply-settings *setting-control*))
      (when player
        (send-event player 'draw (not *rr-player-was-hidden?*))
        (when (and *rr-player-grab-owned?* (focus-test? player grabbed))
          (process-release? player)))
      (set! *rr-player-grab-owned?* #f)
      ;; Do not reposition a replacement camera or interrupt a new movie/menu.
      (when (and camera (= camera *camera*) *camera-combiner*
                 player (= player *target*)
                 (not (focus-test? player dead inactive teleporting))
                 (= (level-status? *level* 'desert #f) 'active)
                 (or (= *master-mode* 'menu) (= *master-mode* 'game)))
        (let ((pose (new 'stack 'transformq)))
          (vector-copy! (-> pose trans) *rr-saved-camera-position*)
          (matrix->quaternion (-> pose quat) *rr-saved-camera-rotation*)
          (send-event camera 'teleport-to-transformq pose))
        (when (-> *camera* slave)
          (matrix-copy! (-> *camera* slave 0 tracking inv-mat) *rr-saved-camera-rotation*)
          (set! (-> *camera* slave 0 fov) *rr-saved-camera-fov*))))
    (dotimes (i 3) (set! (-> *rr-presentation-handles* i) (the-as handle #f))))
  (none))

(defun rr-close ()
  (when *rr-open?*
    (set! *rr-open?* #f)
    (rr-presentation-exit)
    (set! *popup-menu-open* #f)
    (cpad-clear! 0 triangle circle x square select start))
  (none))

(defun rr-new-round ()
  ;; Carried and stored whole rocks survive replay; only river rocks are recycled.
  (dotimes (i 256)
    (when (= (-> *rr-rocks* i state) 1) (set! (-> *rr-rocks* i state) 0)))
  (set! *rr-time* 0.0) (set! *rr-spawn-time* 1.0)
  (set! *rr-swing-age* 1.0) (set! *rr-caught* 0) (set! *rr-deposited* 0)
  (set! *rr-goal* (+ 8 (min 10 (- *rr-round* 1))))
  (set! *rr-player-x* 0.0) (set! *rr-player-y* 17.0)
  (set! *rr-face-x* 0.0) (set! *rr-face-y* -1.0)
  (set! *rr-mode* 0) (none))

(defun rr-spawn ()
  (when (< (rr-count 1) 32)
    (let ((slot -1))
      (dotimes (i 256)
        (when (and (< slot 0) (zero? (-> *rr-rocks* i state))) (set! slot i)))
      (when (>= slot 0)
        (let* ((rock (-> *rr-rocks* slot)) (roll (rand-vu-int-count 100))
               (kind (cond ((< roll (-> *rr-appearance-thresholds* 0)) 0)
                           ((< roll (-> *rr-appearance-thresholds* 1)) 1)
                           ((< roll (-> *rr-appearance-thresholds* 2)) 2) (else 3))))
          (set! (-> rock id) *rr-next-id*) (1+! *rr-next-id*)
          (set! (-> rock state) 1) (set! (-> rock appearance) kind)
          (set! (-> rock material) kind) (set! (-> rock fake) 0)
          (when (< (rand-vu-int-count 100) (-> *rr-fake-percent* kind))
            (set! (-> rock material) 0) (set! (-> rock fake) (+ 1 (rand-vu-int-count 2))))
          (set! (-> rock capacity) (-> *rr-capacities* kind))
          (set! (-> rock size) (if (>= kind 2) 2 1))
          (set! (-> rock required) (if (>= kind 2) 2 1))
          (set! (-> rock scoops) 0) (set! (-> rock swing) -1)
          (set! (-> rock selected) #f) (set! (-> rock age) 0.0)
          (set! (-> rock partial-until) 0.0)
          (set! (-> rock x) (+ -7.0 (* 14.0 (rand-vu)))) (set! (-> rock y) 0.0)
          (set! (-> rock speed) (* (+ 1.4 (* 0.10 (the float kind)))
                                         (+ 1.0 (* 0.04 (the float (min 10 (- *rr-round* 1)))))))
          (set! (-> rock yield)
                (if (> (-> rock fake) 0) (-> rock capacity) (-> *rr-yields* kind)))))))
  (none))

(defun rr-catch ((rock river-rock))
  (let* ((dx (- (-> rock x) *rr-player-x*)) (dy (- (-> rock y) *rr-player-y*))
         (dist2 (+ (* dx dx) (* dy dy))))
    (when (and (= (-> rock state) 1) (!= (-> rock swing) *rr-swing-id*)
               (<= dist2 (* 1.25 1.25))
               (or (< dist2 0.0001)
                   (>= (+ (* dx *rr-face-x*) (* dy *rr-face-y*)) (* 0.642788 (sqrtf dist2)))))
      (set! (-> rock swing) *rr-swing-id*)
      (cond
        ((> (+ (rr-used 2) (-> rock capacity)) *rr-net-max*) (rr-notice "NET FULL - TRANSFER OR DISCARD"))
        (else
          (when (> *rr-time* (-> rock partial-until)) (set! (-> rock scoops) 0))
          (1+! (-> rock scoops))
          (set! (-> rock partial-until) (+ *rr-time* *rr-second-scoop-window*))
          (if (>= (-> rock scoops) (-> rock required))
              (begin (set! (-> rock state) 2) (1+! *rr-caught*) (rr-notice "CAUGHT - OPEN INVENTORY TO IDENTIFY"))
              (rr-notice "SCOOP AGAIN TO SECURE THIS ROCK"))))))
  (none))

(defun rr-tick ((dt float))
  (let* ((level (min 10 (- *rr-round* 1)))
         (surge (if (>= *rr-time* 60.0) 1.3 1.0))
         (rate (* (+ 30.0 (* 2.0 (the float (min 9 level)))) surge))
         (mx 0.0) (my 0.0))
    (set! *rr-current* (* (fmin 1.5 (+ 0.5 (* 0.1 (the float level)))) surge))
    (when (cpad-hold? 0 left l-analog-left) (-! mx 1.0))
    (when (cpad-hold? 0 right l-analog-right) (+! mx 1.0))
    (when (cpad-hold? 0 up l-analog-up) (-! my 1.0))
    (when (cpad-hold? 0 down l-analog-down) (+! my 1.0))
    (let ((len (sqrtf (+ (* mx mx) (* my my)))))
      (when (> len 0.0)
        (set! mx (/ mx len)) (set! my (/ my len))
        (set! *rr-face-x* mx) (set! *rr-face-y* my)))
    (set! *rr-player-x* (fmax -7.5 (fmin 7.5 (+ *rr-player-x* (* mx *rr-player-speed* dt)))))
    (set! *rr-player-y* (fmax 1.5 (fmin 18.0 (+ *rr-player-y*
      (* (+ (* my *rr-player-speed*) *rr-current*) dt)))))
    (+! *rr-time* dt) (+! *rr-swing-age* dt) (-! *rr-spawn-time* dt)
    (when (and (cpad-pressed? 0 x) (>= *rr-swing-age* (+ *rr-windup* *rr-active* *rr-recovery*)))
      (set! *rr-swing-age* 0.0) (1+! *rr-swing-id*) (cpad-clear! 0 x))
    (when (<= *rr-spawn-time* 0.0)
      (set! *rr-spawn-time* (/ 60.0 rate)) (rr-spawn)
      (when (and (>= *rr-round* 3) (< (rand-vu-int-count 100) 20))
        (rr-spawn)
        (when (>= *rr-round* 5) (rr-spawn))
        (when (>= *rr-round* 8) (rr-spawn))))
    (dotimes (i 256)
      (let ((rock (-> *rr-rocks* i)))
        (when (= (-> rock state) 1)
          (+! (-> rock age) dt)
          (+! (-> rock y) (* (+ (* (-> rock speed) surge) *rr-current*) dt))
          (if (or (> (-> rock y) 20.0) (> (-> rock age) 30.0))
              (set! (-> rock state) 0)
              (when (and (>= *rr-swing-age* *rr-windup*)
                         (< *rr-swing-age* (+ *rr-windup* *rr-active*)))
                (rr-catch rock))))))
    (when (>= *rr-time* *rr-duration*)
      (set! *rr-mode* 2) (set! *rr-cursor* 0)
      (rr-notice "ROUND ENDED - DEPOSIT YOUR CARRIED ROCKS")))
  (none))

(defun rr-choose-rock ((row int) (state int))
  (let ((found -1) (index 0))
    (dotimes (i 256)
      (when (= (-> *rr-rocks* i state) state)
        (when (= row index) (set! found i)) (1+! index)))
    found))

(defun rr-clear-selection ()
  (dotimes (i 256) (set! (-> *rr-rocks* i selected) #f)) (none))

(defun rr-selected-count ((state int))
  (let ((count 0))
    (dotimes (i 256)
      (when (and (= (-> *rr-rocks* i state) state) (-> *rr-rocks* i selected)) (1+! count)))
    count))

(defun rr-select-current ((state int))
  (let ((slot (rr-choose-rock *rr-cursor* state)))
    (when (>= slot 0) (set! (-> *rr-rocks* slot selected) #t)))
  (none))

(defun rr-transfer ((from int) (to int) (maximum int))
  (let ((selected 0) (blocked #f))
    (dotimes (i 256)
      (when (and (= (-> *rr-rocks* i state) from) (-> *rr-rocks* i selected)) (1+! selected)))
    (when (zero? selected) (rr-select-current from))
    ;; Transfer in the same stable slot order displayed in the menu.
    (dotimes (i 256)
      (let ((rock (-> *rr-rocks* i)))
        (when (and (= (-> rock state) from) (-> rock selected))
          (if (<= (+ (rr-used to) (-> rock capacity)) maximum)
              (begin (set! (-> rock state) to) (set! (-> rock selected) #f)
                     (when (= to 4) (1+! *rr-deposited*)))
              (set! blocked #t)))))
    (rr-notice (if blocked "SOME ROCKS DID NOT FIT - KEPT IN SOURCE" "WHOLE ROCKS TRANSFERRED")))
  (none))

(defun rr-process ()
  (let ((count 0))
    (dotimes (i 256)
      (let ((rock (-> *rr-rocks* i)))
        (when (= (-> rock state) 4)
          (+! (-> *rr-materials* (-> rock material)) (-> rock yield))
          (set! (-> rock state) 0) (set! (-> rock selected) #f) (1+! count))))
    (rr-notice (if (> count 0) "STORED ROCKS PROCESSED ONCE" "NO STORED ROCKS TO PROCESS")))
  (none))

(defun rr-buy ((upgrade int))
  (let ((enough #t) (owned (if (zero? upgrade) (> *rr-net-max* 5) (> *rr-player-max* 20))))
    (dotimes (kind 4)
      (when (< (-> *rr-materials* kind) (-> *rr-upgrade-prices* (+ (* upgrade 4) kind))) (set! enough #f)))
    (cond (owned (rr-notice "UPGRADE ALREADY OWNED"))
          ((not enough) (rr-notice "NOT ENOUGH PROCESSED MATERIALS"))
          (else
            (dotimes (kind 4) (-! (-> *rr-materials* kind) (-> *rr-upgrade-prices* (+ (* upgrade 4) kind))))
            (if (zero? upgrade) (set! *rr-net-max* 8) (set! *rr-player-max* 30))
            (rr-notice "UPGRADE PURCHASED - RUNTIME ONLY"))))
  (none))

(defun rr-menu-input ()
  (cond
    ((= *rr-mode* 4)
     (cond ((cpad-pressed? 0 x)
            (dotimes (i 256)
              (let ((rock (-> *rr-rocks* i)))
                (when (and (-> rock selected) (= (-> rock state) (+ 2 *rr-tab*)))
                  (set! (-> rock state) 0) (set! (-> rock selected) #f))))
            (set! *rr-mode* *rr-return-mode*) (rr-notice "SELECTED ROCKS DISCARDED"))
           ((cpad-pressed? 0 circle) (set! *rr-mode* *rr-return-mode*))))
    ((= *rr-mode* 1)
     (when (cpad-pressed? 0 l1 r1)
       (set! *rr-tab* (- 1 *rr-tab*)) (set! *rr-cursor* 0) (rr-clear-selection))
     (when (cpad-pressed? 0 up) (set! *rr-cursor* (max 0 (- *rr-cursor* 1))))
     (when (cpad-pressed? 0 down) (1+! *rr-cursor*))
     (set! *rr-cursor* (min *rr-cursor* (max 0 (- (rr-count (+ 2 *rr-tab*)) 1))))
     (when (cpad-pressed? 0 square)
       (let ((slot (rr-choose-rock *rr-cursor* (+ 2 *rr-tab*))))
         (when (>= slot 0)
           (set! (-> *rr-rocks* slot selected) (not (-> *rr-rocks* slot selected))))))
     (when (cpad-pressed? 0 x)
       (if (and *rr-bank-inventory?* (= *rr-tab* 1))
           (rr-transfer 3 4 1000)
           (rr-transfer (+ 2 *rr-tab*) (- 3 *rr-tab*) (if (zero? *rr-tab*) *rr-player-max* *rr-net-max*))))
     (when (cpad-pressed? 0 triangle)
       (when (zero? (rr-selected-count (+ 2 *rr-tab*))) (rr-select-current (+ 2 *rr-tab*)))
       (set! *rr-return-mode* 1) (set! *rr-mode* 4))
     (when (cpad-pressed? 0 circle)
       (rr-clear-selection) (set! *rr-mode* (if *rr-bank-inventory?* 2 0)) (set! *rr-cursor* 0)))
    ((= *rr-mode* 2)
     (when (cpad-pressed? 0 up) (set! *rr-cursor* (max 0 (- *rr-cursor* 1))))
     (when (cpad-pressed? 0 down) (set! *rr-cursor* (min 6 (+ *rr-cursor* 1))))
     (when (cpad-pressed? 0 circle)
       (if (>= *rr-time* *rr-duration*) (set! *rr-mode* 3) (set! *rr-mode* 0)))
     (when (cpad-pressed? 0 x)
       (case *rr-cursor*
         ((0) (set! *rr-bank-inventory?* #t) (set! *rr-mode* 1) (set! *rr-tab* 1) (set! *rr-cursor* 0) (rr-clear-selection))
         ((1) ;; All carrying rocks selected explicitly by this menu action.
          (dotimes (i 256)
            (set! (-> *rr-rocks* i selected) (= (-> *rr-rocks* i state) 3)))
          (rr-transfer 3 4 1000))
         ((2) (rr-process)) ((3) (rr-buy 0)) ((4) (rr-buy 1))
         ((5) (set! *rr-mode* 3)) ((6) (rr-close)))))
    ((= *rr-mode* 3)
     (when (cpad-pressed? 0 x)
       (when (>= *rr-deposited* *rr-goal*) (1+! *rr-round*)) (rr-new-round))
     (when (cpad-pressed? 0 triangle) (set! *rr-mode* 2) (set! *rr-cursor* 0))
     (when (cpad-pressed? 0 circle) (rr-close))))
  (cpad-clear! 0 up down left right x square triangle circle l1 r1)
  (none))

;; Rendering-only palette and geometry. The simulation remains in local meters.
(define *rr-ui-water* (new 'static 'rgba :r 21 :g 62 :b 73 :a 128))
(define *rr-ui-deep* (new 'static 'rgba :r 16 :g 45 :b 54 :a 128))
(define *rr-ui-sand* (new 'static 'rgba :r 117 :g 91 :b 58 :a 128))
(define *rr-ui-metal* (new 'static 'rgba :r 130 :g 103 :b 71 :a 128))
(define *rr-ui-panel* (new 'static 'rgba :r 32 :g 26 :b 20 :a 128))
(define *rr-ui-ink* (new 'static 'rgba :r 16 :g 16 :b 14 :a 128))
(define *rr-ui-accent* (new 'static 'rgba :r 199 :g 142 :b 58 :a 128))
(define *rr-ui-inventory* (new 'static 'rgba :r 137 :g 154 :b 103 :a 128))
(define *rr-ui-cream* (new 'static 'rgba :r 232 :g 211 :b 168 :a 128))
(define *rr-ui-red* (new 'static 'rgba :r 190 :g 69 :b 48 :a 128))
(define *rr-ui-last-caught* 0)
(define *rr-ui-catch-flash* 0.0)

(defun rr-screen-x ((x float)) (+ 256 (the int (* x 25.0))))
(defun rr-screen-y ((y float)) (+ 106 (the int (* y 10.6))))

(defun rr-ui-rect ((buf dma-buffer) (x int) (y int) (w int) (h int) (color rgba))
  (when (and (> w 0) (> h 0)) (draw-sprite2d-xy buf x y w h color #x3fffff))
  (none))

(defun rr-ui-line ((buf dma-buffer) (x0 int) (y0 int) (x1 int) (y1 int) (color rgba))
  ;; Short, bounded raster segments, using the existing sprite primitive.
  (let ((steps (min 32 (max 1 (/ (max (abs (- x1 x0)) (abs (- y1 y0))) 2)))))
    (dotimes (i (+ steps 1))
      (let ((t (/ (the float i) (the float steps))))
        (rr-ui-rect buf (+ x0 (the int (* t (the float (- x1 x0)))))
          (+ y0 (the int (* t (the float (- y1 y0))))) 2 2 color))))
  (none))

(defun rr-ui-oval ((buf dma-buffer) (x int) (y int) (rx int) (ry int) (color rgba))
  ;; Faceted silhouette, with a fixed eight-scanline budget.
  (dotimes (i 8)
    (let* ((v (- (/ (+ (the float i) 0.5) 4.0) 1.0))
           (half (max 1 (the int (* (the float rx) (sqrtf (fmax 0.0 (- 1.0 (* v v)))))))))
      (rr-ui-rect buf (- x half) (+ (- y ry) (/ (* i ry) 4))
        (* half 2) (max 1 (+ 1 (/ ry 4))) color)))
  (none))

(defun rr-ui-capacity ((buf dma-buffer) (x int) (used int) (maximum int) (color rgba))
  (rr-ui-rect buf x 87 208 9 *rr-ui-metal*)
  (rr-ui-rect buf (+ x 1) 88 206 7 *rr-ui-ink*)
  (rr-ui-rect buf (+ x 2) 89 (the int (* 204.0 (/ (the float used) (the float maximum))))
    5 (if (>= used maximum) *rr-ui-red* color))
  (none))

(defun rr-ui-rock ((buf dma-buffer) (rock river-rock))
  (let* ((x (rr-screen-x (-> rock x))) (y (rr-screen-y (-> rock y)))
         (large? (= (-> rock size) 2)) (rx (if large? 10 8)) (ry (if large? 7 6))
         (stone (if (= (-> rock fake) 1)
                    (new 'static 'rgba :r 136 :g 123 :b 110 :a 128)
                    (new 'static 'rgba :r 119 :g 117 :b 111 :a 128))))
    (rr-ui-oval buf (+ x 1) (+ y 2) (+ rx 1) ry *rr-ui-deep*)
    (rr-ui-oval buf x y rx ry stone)
    ;; Same cracks on every appearance: no outline, glow, or fake marker.
    (rr-ui-line buf (- x 4) (- y 3) (- x 1) (- y 1)
      (new 'static 'rgba :r 82 :g 79 :b 72 :a 90))
    (when (> (-> rock appearance) 0)
      (let ((speck (case (-> rock appearance)
              ((1) (if (= (-> rock fake) 2)
                       (new 'static 'rgba :r 199 :g 91 :b 73 :a 128)
                       (new 'static 'rgba :r 226 :g 67 :b 53 :a 128)))
              ((2) (if (= (-> rock fake) 2)
                       (new 'static 'rgba :r 91 :g 145 :b 191 :a 128)
                       (new 'static 'rgba :r 61 :g 136 :b 225 :a 128)))
              (else (if (= (-> rock fake) 2)
                        (new 'static 'rgba :r 207 :g 189 :b 89 :a 128)
                        (new 'static 'rgba :r 240 :g 205 :b 54 :a 128)))))
            (offset (mod (the int (* (-> rock age) 3.0)) 3)))
        (rr-ui-oval buf (+ x 2 offset) (- y 1) 3 2 speck))))
  (none))

(defun rr-ui-player ((buf dma-buffer))
  (let* ((x (rr-screen-x *rr-player-x*)) (y (rr-screen-y *rr-player-y*))
         (active? (and (>= *rr-swing-age* *rr-windup*)
                       (< *rr-swing-age* (+ *rr-windup* *rr-active*))))
         (ready? (>= *rr-swing-age* (+ *rr-windup* *rr-active* *rr-recovery*)))
         (angle (if (< *rr-swing-age* (+ *rr-windup* *rr-active*))
                    (+ (degrees -50) (* (degrees 100)
                      (fmin 1.0 (/ *rr-swing-age* (+ *rr-windup* *rr-active*))))) 0.0))
         (fx (- (* *rr-face-x* (cos angle)) (* *rr-face-y* (sin angle))))
         (fy (+ (* *rr-face-y* (cos angle)) (* *rr-face-x* (sin angle))))
         (nx (rr-screen-x (+ *rr-player-x* (* fx 0.95))))
         (ny (rr-screen-y (+ *rr-player-y* (* fy 0.95))))
         (net-color (if active? *rr-ui-cream* (if ready? *rr-ui-accent* *rr-ui-metal*))))
    ;; Boots, broad coat shoulders, head and green hair make a human silhouette.
    (rr-ui-oval buf x (+ y 3) 9 5 *rr-ui-deep*)
    (rr-ui-rect buf (- x 6) (+ y 3) 4 5 *rr-ui-ink*)
    (rr-ui-rect buf (+ x 2) (+ y 3) 4 5 *rr-ui-ink*)
    (rr-ui-oval buf x y 8 5 *rr-ui-accent*)
    (rr-ui-rect buf (- x 5) (- y 1) 10 3
      (new 'static 'rgba :r 65 :g 80 :b 83 :a 128))
    (let ((hx (+ x (the int (* *rr-face-x* 4.0))))
          (hy (+ y (the int (* *rr-face-y* 4.0)))))
      (rr-ui-oval buf hx (- hy 1) 4 3 *rr-ui-cream*)
      (rr-ui-rect buf (- hx 4) (- hy 4) 8 2 *rr-ui-inventory*))
    ;; Directional handle and elliptical hoop, with visible mesh during a scoop.
    (rr-ui-line buf x y nx ny *rr-ui-metal*)
    (dotimes (i 12)
      (let ((a (* (the float i) (degrees 30))))
        (rr-ui-rect buf (+ nx (the int (* 8.0 (cos a))))
          (+ ny (the int (* 5.0 (sin a)))) 2 2 net-color)))
    (rr-ui-line buf (- nx 5) ny (+ nx 5) ny net-color)
    (rr-ui-line buf nx (- ny 3) nx (+ ny 3) net-color)
    (when active?
      ;; The displayed arc uses exactly the gameplay reach and 100-degree cone.
      (dotimes (i 7)
        (let* ((a (+ (degrees -50) (* (the float i) (/ (degrees 100) 6.0))))
               (ax (- (* *rr-face-x* (cos a)) (* *rr-face-y* (sin a))))
               (ay (+ (* *rr-face-y* (cos a)) (* *rr-face-x* (sin a)))))
          (rr-ui-rect buf (rr-screen-x (+ *rr-player-x* (* ax 1.25)))
            (rr-screen-y (+ *rr-player-y* (* ay 1.25))) 3 2 *rr-ui-cream*))))
    (when (> *rr-ui-catch-flash* 0.0)
      (rr-ui-oval buf x (- y 13) 3 2 *rr-ui-inventory*)))
  (none))

(defun rr-ui-name ((rock river-rock))
  (if (> (-> rock fake) 0)
      (case (-> rock appearance) ((1) "Fool's Red / Rock") ((2) "Fool's Blue / Rock")
            (else "Fool's Yellow / Rock"))
      (case (-> rock material) ((0) "Ordinary Rock") ((1) "Red Eco Crystal")
            ((2) "Blue Eco Crystal") (else "Yellow Eco Crystal"))))

(defun rr-draw ()
  (let* ((net (rr-used 2)) (player (rr-used 3))
         (seconds (max 0 (the int (- *rr-duration* *rr-time*))))
         (bank? (and (> *rr-player-y* 15.8) (< (fabs *rr-player-x*) 1.8)))
         (cooldown (+ *rr-windup* *rr-active* *rr-recovery*)))
    (when (> *rr-caught* *rr-ui-last-caught*) (set! *rr-ui-catch-flash* 0.8))
    (set! *rr-ui-last-caught* *rr-caught*)
    (set! *rr-ui-catch-flash* (fmax 0.0 (- *rr-ui-catch-flash* (seconds-per-frame))))
    (with-dma-buffer-add-bucket ((buf (-> *display* frames (-> *display* on-screen) global-buf))
                                (bucket-id hud-draw-hud-alpha))
      ;; Only compact HUD panels; the actual level fills the collection area.
      (rr-ui-rect buf 20 12 472 86 *rr-ui-panel*)
      (rr-ui-rect buf 20 98 472 2 *rr-ui-metal*)
      (rr-ui-rect buf 20 344 472 60 *rr-ui-panel*)
      ;; Thin guides preserve readability without masking the world.
      (rr-ui-rect buf 54 106 2 212 *rr-ui-metal*)
      (rr-ui-rect buf 456 106 2 212 *rr-ui-metal*)
      (rr-ui-rect buf 56 106 400 1 *rr-ui-metal*)
      (when bank?
        (rr-ui-rect buf 207 338 98 3 *rr-ui-inventory*))
      (dotimes (i 256)
        (when (= (-> *rr-rocks* i state) 1) (rr-ui-rock buf (-> *rr-rocks* i))))
      (rr-ui-player buf)
      (rr-ui-capacity buf 36 net *rr-net-max* *rr-ui-accent*)
      (rr-ui-capacity buf 268 player *rr-player-max* *rr-ui-inventory*)
      ;; Small scoop recovery meter; no change to the actual attack timer.
      (rr-ui-rect buf 425 352 48 5 *rr-ui-ink*)
      (rr-ui-rect buf 425 352 (the int (* 48.0 (fmin 1.0 (/ *rr-swing-age* cooldown))))
        5 *rr-ui-inventory*)
      (when (> *rr-mode* 0)
        (rr-ui-rect buf 38 105 436 236 *rr-ui-metal*)
        (rr-ui-rect buf 41 108 430 230 *rr-ui-panel*)
        (when (= *rr-mode* 1)
          (rr-ui-rect buf 48 (+ 151 (* (mod *rr-cursor* 6) 24)) 414 22
            (new 'static 'rgba :r 72 :g 78 :b 50 :a 128)))
        (when (= *rr-mode* 2)
          (rr-ui-rect buf 48 (+ 139 (* *rr-cursor* 23)) 414 21
            (new 'static 'rgba :r 72 :g 78 :b 50 :a 128))))
      (when (or (> *rr-notice-time* 0.0) (and (>= *rr-time* 60.0) (< *rr-time* 63.0)))
        (rr-ui-rect buf 30 386 452 16 *rr-ui-panel*)
        (rr-ui-rect buf 30 386 3 16 *rr-ui-accent*)))
    (rr-label "RIVER ROCK COLLECTOR" 88 20 0.62 (font-color default))
    (rr-label (rr-text "ROUND ~D  |  TIME ~D:~A~D" *rr-round* (/ seconds 60)
                      (if (< (mod seconds 60) 10) "0" "") (mod seconds 60))
      36 46 0.40 (font-color white))
    (rr-label (rr-text "CURRENT: ~A" (cond ((< *rr-current* 0.8) "LOW")
                    ((< *rr-current* 1.3) "MODERATE") (else "STRONG")))
      292 46 0.40 (font-color default))
    (rr-label (rr-text "NET: ~D/~D~A" net *rr-net-max* (if (>= net *rr-net-max*) " FULL" ""))
      36 69 0.44 (if (>= net *rr-net-max*) (font-color red) (font-color white)))
    (rr-label (rr-text "PLAYER: ~D/~D~A" player *rr-player-max* (if (>= player *rr-player-max*) " FULL" ""))
      268 69 0.44 (if (>= player *rr-player-max*) (font-color red) (font-color white)))
    (cond
      ((zero? *rr-mode*)
       (rr-label "<PAD_DPAD_UP><PAD_DPAD_DOWN><PAD_DPAD_LEFT><PAD_DPAD_RIGHT> MOVE    <PAD_X> SCOOP" 38 348 0.40 (font-color white))
       (rr-label "<PAD_SQUARE> INVENTORY   <PAD_CIRCLE> EXIT" 38 371 0.40 (font-color white))
       (rr-label (if bank? "<PAD_TRIANGLE> DEPOSIT / PROCESS" "RIVERBANK")
         154 321 0.36 (if bank? (font-color green) (font-color default))))
      ((= *rr-mode* 1)
       (rr-label (if (zero? *rr-tab*) "NET INVENTORY" "PLAYER INVENTORY") 56 114 0.52 (font-color default))
       (rr-label "RESOURCE                       SPACE" 56 137 0.34 (font-color menu-flag-off))
       (let ((start (* (/ *rr-cursor* 6) 6)))
         (dotimes (row 6)
           (let* ((n (+ start row)) (slot (rr-choose-rock n (+ 2 *rr-tab*))))
             (when (>= slot 0)
               (let ((rock (-> *rr-rocks* slot)))
                 (rr-label (rr-text "~A ~A" (if (-> rock selected) "*" " ") (rr-ui-name rock))
                   58 (+ 156 (* row 24)) 0.42 (font-color white))
                 (rr-label (rr-text "~D" (-> rock capacity)) 432 (+ 156 (* row 24)) 0.42 (font-color white)))))))
       (when (zero? (rr-count (+ 2 *rr-tab*)))
         (rr-label "No rocks in this inventory." 80 198 0.45 (font-color menu-flag-off)))
       (rr-label (if (and *rr-bank-inventory?* (= *rr-tab* 1))
                     "<PAD_X> DEPOSIT SELECTED WHOLE ROCKS" "<PAD_X> TRANSFER TO OTHER INVENTORY")
         56 307 0.36 (font-color default))
       (rr-label "<PAD_L1><PAD_R1> BAG  <PAD_SQUARE> SELECT  <PAD_TRIANGLE> DISCARD" 38 348 0.36 (font-color white))
       (rr-label "<PAD_DPAD_UP><PAD_DPAD_DOWN> CHOOSE   <PAD_CIRCLE> RETURN" 38 371 0.40 (font-color white)))
      ((= *rr-mode* 2)
       (rr-label "RIVERBANK WORKSHOP" 56 114 0.52 (font-color default))
       (dotimes (row 7)
         (rr-label
           (case row ((0) "View / select carried rocks") ((1) "Deposit all carried rocks")
             ((2) (rr-text "Process stored rocks (~D)" (rr-count 4)))
             ((3) (rr-text "Net 8: ~D Rock + ~D Red" (-> *rr-upgrade-prices* 0) (-> *rr-upgrade-prices* 1)))
             ((4) (rr-text "Player 30: ~D Rock + ~D Blue" (-> *rr-upgrade-prices* 4) (-> *rr-upgrade-prices* 6)))
             ((5) "Round summary") (else "Exit to Desert"))
           62 (+ 143 (* row 23)) 0.43 (if (= row *rr-cursor*) (font-color default) (font-color white))))
       (rr-label "<PAD_DPAD_UP><PAD_DPAD_DOWN> CHOOSE   <PAD_X> CONFIRM" 38 348 0.40 (font-color white))
       (rr-label "<PAD_CIRCLE> RETURN  /  RUNTIME UPGRADES" 38 371 0.36 (font-color menu-flag-off)))
      ((= *rr-mode* 3)
       (rr-label (if (>= *rr-deposited* *rr-goal*) "OBJECTIVE COMPLETE" "OBJECTIVE UNMET")
         72 130 0.58 (font-color default))
       (rr-label (rr-text "Deposited: ~D / ~D whole rocks" *rr-deposited* *rr-goal*) 64 174 0.46 (font-color white))
       (rr-label "Carried rocks remain intact." 64 216 0.44 (font-color white))
       (rr-label "Deposit, then select Process at the bank." 64 243 0.38 (font-color menu-flag-off))
       (rr-label "<PAD_X> NEXT / REPLAY   <PAD_TRIANGLE> BANK" 38 348 0.40 (font-color white))
       (rr-label "<PAD_CIRCLE> EXIT TO DESERT" 38 371 0.40 (font-color white)))
      ((= *rr-mode* 4)
       (rr-label "DISCARD SELECTED ROCKS?" 64 151 0.54 (font-color orange))
       (rr-label "Discarded rocks cannot be recovered." 64 207 0.40 (font-color white))
       (rr-label "<PAD_X> DISCARD   <PAD_CIRCLE> CANCEL" 38 348 0.44 (font-color white))))
    (if (or (> *rr-notice-time* 0.0) (and (>= *rr-time* 60.0) (< *rr-time* 63.0)))
      (rr-label (if (> *rr-notice-time* 0.0) *rr-message* "CURRENT INCREASING - WATCH UPSTREAM")
        40 389 0.34 (font-color default))
    (if (or (= *rr-mode* 2) (= *rr-mode* 3))
        (rr-label (rr-text "MATERIALS   ROCK ~D   RED ~D   BLUE ~D   YELLOW ~D"
          (-> *rr-materials* 0) (-> *rr-materials* 1) (-> *rr-materials* 2) (-> *rr-materials* 3))
          36 391 0.32 (font-color default))
        (rr-label (rr-text "CAUGHT ~D   |   DEPOSIT GOAL ~D/~D   |   STORED ~D"
          *rr-caught* *rr-deposited* *rr-goal* (rr-count 4)) 36 391 0.34 (font-color menu-flag-off)))))
  (none))
(defun rr-update ((owner process))
  ;; Temporary locator: no actors, map registrations, or persistent handles.
  (when (and *rr-debug-marker?* *target* (not *rr-open?*)
             (= *master-mode* 'game)
             (logtest? (-> *game-info* secrets) (game-secrets hero-mode))
             (= (level-status? *level* 'desert #f) 'active)
             (not (load-in-progress? *level*)))
    (add-debug-sphere #t (bucket-id debug-no-zbuf1)
      *desert-resource-match-pos* *rr-radius* *rr-debug-color*)
    (let ((top (new 'stack 'vector)))
      (vector-copy! top *desert-resource-match-pos*)
      (+! (-> top y) (meters 60))
      (add-debug-line #t (bucket-id debug-no-zbuf1)
        *desert-resource-match-pos* top *rr-debug-color* #f (the-as rgba -1)))
    (add-debug-line #t (bucket-id debug-no-zbuf1)
      (target-pos 0) *desert-resource-match-pos* *rr-debug-color* #f (the-as rgba -1))
    (rr-label (rr-text "ROCK COLLECTOR: ~D METERS"
      (the int (/ (vector-vector-distance (target-pos 0) *desert-resource-match-pos*) (meters 1))))
      100 110 0.30 (font-color cyan))
    (rr-label "3033.70 / 8.63 / 1681.03 - ENTER ON FOOT" 70 132 0.23 (font-color white)))
  (cond
    (*rr-open?*
     (cond
       ((or (not *target*) (focus-test? *target* dead inactive teleporting)
            (not (logtest? (-> *game-info* secrets) (game-secrets hero-mode)))
            (!= (level-status? *level* 'desert #f) 'active)
            (!= *master-mode* 'game) (not *popup-menu-open*)) (rr-close))
       (else
         (let ((dt (fmin 0.05 (seconds-per-frame))))
           (when (> *rr-notice-time* 0.0) (-! *rr-notice-time* dt))
           (if (zero? *rr-mode*)
               (cond
                 ((cpad-pressed? 0 circle) (rr-close))
                 ((cpad-pressed? 0 square)
                  (set! *rr-bank-inventory?* #f)
                  (rr-clear-selection) (set! *rr-mode* 1) (set! *rr-tab* 0) (set! *rr-cursor* 0))
                 ((and (cpad-pressed? 0 triangle) (> *rr-player-y* 15.8) (< (fabs *rr-player-x*) 1.8))
                  (set! *rr-mode* 2) (set! *rr-cursor* 0))
                 (else (rr-tick dt)))
               (rr-menu-input)))
         (when *rr-open?* (rr-draw))
         (cpad-clear! 0 x square circle triangle))))
    ((and *target* (= *master-mode* 'game) (not *popup-menu-open*)
          (logtest? (-> *game-info* secrets) (game-secrets hero-mode))
          (= (level-status? *level* 'desert #f) 'active)
          (not (focus-test? *target* dead inactive disable teleporting pilot-riding flut board grabbed))
          (logtest? (-> *target* control status) (collide-status on-surface))
          (>= (-> *display* base-clock frame-counter) (-> *game-info* letterbox-time))
          (>= (-> *display* base-clock frame-counter) (-> *game-info* blackout-time))
          (< (vector-vector-distance-squared (target-pos 0) *desert-resource-match-pos*) (square *rr-radius*)))
     (when (can-display-query? owner "river-rock-collector" -99.0)
       (rr-label "Press <PAD_TRIANGLE> to Collect Rocks" 60 330 0.40 (font-color default))
       (when (cpad-pressed? 0 triangle)
         (cpad-clear! 0 triangle)
         (when (rr-presentation-enter owner)
         (rr-new-round)
         (set! *rr-open?* #t) (set! *popup-menu-open* #t)
         (format #t "[river-rock] opened at trigger; distance=~m~%"
           (vector-vector-distance (target-pos 0) *desert-resource-match-pos*)))))))
  (none))

(deftype desert-resource-match-manager (process) () (:state-methods idle))
(defmethod deactivate ((this desert-resource-match-manager))
  (rr-close)
  ((method-of-type process deactivate) this)
  (none))
(defstate idle (desert-resource-match-manager)
  :virtual #t :trans (behavior () (rr-update self)) :code sleep-code)
(defbehavior desert-resource-match-manager-init-by-other desert-resource-match-manager ()
  (process-mask-clear! (-> self mask) menu pause)
  (format #t "[river-rock] manager ready at (3033.70, 8.63, 1681.03), radius 3m~%")
  (go-virtual idle))
(defun desert-resource-match-start ()
  (when (not (handle->process (-> *rr-manager-handle* 0)))
    (format #t "[river-rock] starting manager (initialized handle)~%")
    (let ((existing (process-by-name "desert-resource-match" *active-pool*)))
      (if existing
          (set! (-> *rr-manager-handle* 0) (process->handle existing))
          (let ((proc (process-spawn desert-resource-match-manager :name "desert-resource-match" :to *entity-pool*)))
            (when proc (set! (-> *rr-manager-handle* 0) (ppointer->handle proc)))))))
  (none))
(defun desert-resource-match-stop ()
  (rr-close) (kill-by-type desert-resource-match-manager *active-pool*)
  (set! (-> *rr-manager-handle* 0) (the-as handle #f)) (none))
(defun desert-with-flut-and-resource-match-activate ((owner level))
  (desert-with-flut-activate owner) (desert-resource-match-start) (none))
(defun desert-with-flut-and-resource-match-deactivate ((owner level))
  (desert-resource-match-stop) (desert-with-flut-deactivate owner) (none))
