            (if (-> this is-intro?)
                (launch-particles (-> *part-id-table* 1422) s4-0)
                (launch-particles (-> *part-id-table* 1421) s4-0)
                )
            )
          )
        (#t
          (if (-> this is-intro?)
              (launch-particles (-> *part-id-table* 1422) s4-0)
              (launch-particles (-> *part-id-table* 1421) s4-0)
              )
          )
        )
      )
    )
  (none)
  )

;; WARN: Return type mismatch int vs handle.
(defun create-dust-storm ((arg0 process-tree) (arg1 level))
  (let ((s5-0 (get-process *default-dead-pool* desert-dust-storm #x4000 1)))
    (the-as
      handle
      (process->handle
        (-> (when s5-0
              (let ((t9-1 (method-of-type desert-dust-storm activate)))
                (t9-1 (the-as desert-dust-storm s5-0) arg0 "desert-dust-storm" (the-as pointer #x70004000))
                )
              (run-now-in-process s5-0 desert-dust-storm-init-by-other arg1 'track (target-pos 0))
              (-> s5-0 ppointer)
              )
            0
            )
        )
      )
    )
  )

(defmethod desert-dust-storm-method-20 ((this desert-dust-storm))
  (set! (-> this intensity-target) (-> *setting-control* user-current fog-special-interp-targ))
  (set! (-> this intensity-rate) (-> *setting-control* user-current fog-special-interp-rate))
  (seek! (-> this intensity) (-> this intensity-target) (* (-> this intensity-rate) (seconds-per-frame)))
  (let ((f28-0 (-> this intensity))
        (f30-0 (-> this intensity-rate))
        (s5-0 #f)
        )
    (cond
      ((and (-> this next-state) (= (-> this next-state name) 'hold-pos))
       (set! f28-0 (fmin 0.8 (-> this intensity)))
       (set! f30-0 0.3)
       (set! s5-0 #f)
       )
      ((< (vector-vector-xz-distance (math-camera-pos) (-> this fog-plane-origin)) 81920.0)
       (let ((s5-2 (vector-! (new 'stack-no-clear 'vector) (math-camera-pos) (-> this fog-plane-origin))))
         0.0
         0.0
         #t
         (let* ((f0-12 (vector-dot s5-2 (-> this fog-plane-dir)))
                (f0-13 (fmax 0.0 f0-12))
                (f1-5 (/ f0-13 (meters 15)))
                (f0-15 (fmax 0.0 (fmin 1.0 f1-5)))
                )
           (set! f28-0 (lerp (fmin 0.8 (-> this intensity)) (-> this intensity) f0-15))
           )
         )
       (set! f30-0 0.3)
       (set! s5-0 #t)
       )
      )
    (let* ((f1-10 (* f28-0 (-> *setting-control* user-current dust-storm-fog-scalar)))
           (f1-12 (fmax 0.0 (fmin 1.0 f1-10)))
           (v1-24 *mood-control*)
           (f0-19 (fmax 0.0 (fmin 1.0 f1-12)))
           )
      (set! (-> v1-24 target-special-interp) f0-19)
      (set! (-> v1-24 rate-special-interp) f30-0)
      (if s5-0
          (set! (-> v1-24 current-special-interp) f0-19)
          )
      )
    )
  0
  (when *target*
    (let* ((f30-1 (* 10.0 *duststorm-wind-vel*))
           (f28-1 0.5)
           (f26-0 3.5)
           (v1-33 (/ (the-as int (rand-uint31-gen *random-generator*)) 256))
           (v1-34 (the-as number (logior #x3f800000 v1-33)))
           (f30-2 (* f30-1 (+ f28-1 (* f26-0 (+ -1.0 (the-as float v1-34))))))
           (s5-3 (new 'stack-no-clear 'vector))
           )
      (vector-copy! s5-3 *duststorm-wind-vec*)
      (let* ((f28-2 -0.3)
             (f26-1 0.6)
             (v1-41 (/ (the-as int (rand-uint31-gen *random-generator*)) 256))
             (v1-42 (the-as number (logior #x3f800000 v1-41)))
             )
        (set! (-> s5-3 y) (+ f28-2 (* f26-1 (+ -1.0 (the-as float v1-42))) (-> s5-3 y)))
        )
      (vector-float*! s5-3 s5-3 f30-2)
      (let ((t1-0 (new 'static 'vector)))
        (vector-copy! t1-0 s5-3)
        (set-setting! 'global-wind #f 0.0 t1-0)
        )
      )
    (when (and (-> *setting-control* user-current duststorm-push-player?)
               (not (focus-test? *target* pilot-riding))
               (not (and (-> this next-state) (= (-> this next-state name) 'hold-pos)))
               )
      (let ((a0-18 (-> *target* control)))
        (if (or (not (and a0-18 (logtest? (-> a0-18 status) (collide-status on-surface))))
                (< 8192.0 (vector-length (get-transv *target*)))
                )
            (send-event
              *target*
              'push-trans
              (vector-float*! (new 'stack-no-clear 'vector) *duststorm-wind-vec* (* *duststorm-wind-vel* (seconds-per-frame))) ;; og:preserve-this normalize speed to per-sec instead of per-frame, and nerf to better match PS2 fps
              (seconds 0.11)
              )
            )
        )
      )
    )
  (let ((f0-36 (fmax 0.0 (fmin 1.0 (-> this intensity)))))
    0.0
    1.0
    (let* ((f1-24 (- 1.0 (* (- 1.0 f0-36) (- 1.0 f0-36))))
           (f30-4 (* (fmax 0.0 (fmin 1.0 f1-24)) (-> *setting-control* user-current dust-storm-sound-scalar)))
           (f28-3 (lerp 1.0 0.95 f30-4))
           (f1-29 (* (lerp 0.4 1.0 f30-4) (/ 1.0 f28-3)))
           (f0-43 (fmax 0.0 (fmin 1.0 f1-29)))
           )
      (if (= f30-4 0.0)
          (sound-stop (-> this wind-sound))
          (sound-play-by-name
            (static-sound-name "storm-wind")
            (-> this wind-sound)
            (the int (* 1024.0 f0-43))
            0
            0
            (sound-group)
            #t
            )
          )
      )
    )
  (cond
    ((< 1.0 (-> this intensity))
     (let ((f0-48 (+ -1.0 (-> this intensity))))
       0.0
       (let ((a2-8 (new 'stack-no-clear 'vector)))
         (vector-copy! a2-8 (-> *time-of-day-context* current-fog fog-color))
         (set! (-> a2-8 w) (* 128.0 f0-48))
         (set! (-> this enabled-screen-filter?) #t)
         (setup *screen-filter* a2-8 a2-8 10000.0
                ;;(bucket-id generic-sprite-1)
                ;; og:preserve-this
                ;; Modified to put this into a nearby bucket with same settings
                ;; that uses DirectRenderer in the C++ renderer.
                ;; otherwise, it goes to the Generic renderer, which doesn't know how to
                ;; handle drawing through Direct.
                (bucket-id tex-hud-pris2)
                 #x20000 #x30003 #t)
         )
       )
     )
    (else
      (when (-> this enabled-screen-filter?)
        (disable *screen-filter*)
        (set! (-> this enabled-screen-filter?) #f)
        )
      )
    )
  (if (not (paused?))
      (set! (-> *mood-control* current-special-interp)
            (seek
              (-> *mood-control* current-special-interp)
              (-> *mood-control* target-special-interp)
              (* (-> *mood-control* rate-special-interp) (seconds-per-frame))
              )
            )
      )
  )

(defun desert-activate ((arg0 level))
  (let ((v0-0 (create-dust-storm *entity-pool* arg0)))
    (set! (-> *game-info* dust-storm) v0-0)
    v0-0
    )
  )

;; WARN: Return type mismatch symbol vs none.
(defun desert-deactivate ()
  (send-event (handle->process (-> *game-info* dust-storm)) 'die)
  (set! (-> *game-info* dust-storm) (the-as handle #f))
  (none)
  )

;; Each level callback slot resolves only its first entry. Run both systems
;; through one callback instead of registering duplicate activation slots.
(defun desert-with-flut-activate ((owner level))
  (desert-activate owner)
  (desert-unlocked-flut-manager-activate owner)
  (none))

(defun desert-with-flut-deactivate ((owner level))
  (desert-unlocked-flut-manager-deactivate owner)
  (desert-deactivate)
  (none))

;; Hero Mode resource-matching minigame.

(define *desert-resource-match-pos*
  ;; 3033.70, 8.63, 1681.03 meters.
  (new 'static 'vector :x 12426035.2 :y 35348.48 :z 6885498.88 :w 1.0))
(define *desert-resource-match-open?* #f)
(define *desert-resource-match-grid* (new 'static 'array int32 72))
(define *desert-resource-match-visited* (new 'static 'array int32 72))
(define *desert-resource-match-clear* (new 'static 'array int32 72))
(define *desert-resource-match-queue* (new 'static 'array int32 72))
(define *desert-resource-match-collected* (new 'static 'array int32 4))
(define *desert-resource-match-x* 2)
(define *desert-resource-match-y* 11)
(define *desert-resource-match-rotation* 0)
(define *desert-resource-match-a* 1)
(define *desert-resource-match-b* 1)
(define *desert-resource-match-drop-tick* 0)
(define *desert-resource-match-score* 0)
(define *desert-resource-match-chain* 0)
(define *desert-resource-match-state* 0)
(define *desert-resource-match-goal* 40)
(define *desert-resource-match-near-trigger?* #f)
(define *desert-resource-match-inside-trigger?* #f)
(define *desert-resource-match-radius-color*
  (new 'static 'rgba :r #x40 :g #xff :b #x40 :a #x80))

(defun desert-resource-match-random ()
  (let ((roll (rand-vu-int-count 100)))
    (cond ((< roll 50) 1) ((< roll 75) 2) ((< roll 92) 3) (else 4))))

(defun desert-resource-match-bx ((x int) (rotation int))
  (+ x (case rotation ((1) 1) ((3) -1) (else 0))))

(defun desert-resource-match-by ((y int) (rotation int))
  (+ y (case rotation ((0) 1) ((2) -1) (else 0))))

(defun desert-resource-match-cell-open? ((x int) (y int))
  (and (>= x 0) (< x 6) (>= y 0)
       (or (>= y 12) (zero? (-> *desert-resource-match-grid* (+ x (* y 6)))))))

(defun desert-resource-match-fits? ((x int) (y int) (rotation int))
  (and (desert-resource-match-cell-open? x y)
       (desert-resource-match-cell-open?
         (desert-resource-match-bx x rotation)
         (desert-resource-match-by y rotation))))

(defun desert-resource-match-spawn! ()
  (set! *desert-resource-match-x* 2)
  (set! *desert-resource-match-y* 11)
  (set! *desert-resource-match-rotation* 0)
  (set! *desert-resource-match-a* (desert-resource-match-random))
  (set! *desert-resource-match-b* (desert-resource-match-random))
  (set! *desert-resource-match-drop-tick* 0)
  (when (not (desert-resource-match-fits? 2 11 0))
    (set! *desert-resource-match-state* 2))
  (none))

(defun desert-resource-match-reset! ()
  (dotimes (i 72)
    (set! (-> *desert-resource-match-grid* i) 0)
    (set! (-> *desert-resource-match-visited* i) 0)
    (set! (-> *desert-resource-match-clear* i) 0))
  (dotimes (i 4) (set! (-> *desert-resource-match-collected* i) 0))
  (set! *desert-resource-match-score* 0)
  (set! *desert-resource-match-chain* 0)
  (set! *desert-resource-match-state* 0)
  (desert-resource-match-spawn!)
  (none))

(defun desert-resource-match-close! ()
  (when *desert-resource-match-open?*
    (set! *desert-resource-match-open?* #f)
    (set! *popup-menu-open* #f)
    (set-master-mode 'game))
  (none))

(defun desert-resource-match-enqueue! ((index int) (material int) (tail int))
  (if (and (>= index 0) (< index 72)
           (zero? (-> *desert-resource-match-visited* index))
           (= (-> *desert-resource-match-grid* index) material))
      (begin
        (set! (-> *desert-resource-match-visited* index) 1)
        (set! (-> *desert-resource-match-queue* tail) index)
        (+ tail 1))
      tail))

(defun desert-resource-match-gravity! ()
  (dotimes (x 6)
    (let ((write-y 0))
      (dotimes (y 12)
        (let* ((source (+ x (* y 6)))
               (material (-> *desert-resource-match-grid* source)))
          (when (> material 0)
            (let ((dest (+ x (* write-y 6))))
              (when (!= dest source)
                (set! (-> *desert-resource-match-grid* dest) material)
                (set! (-> *desert-resource-match-grid* source) 0)))
            (1+! write-y))))))
  (none))

(defun desert-resource-match-clear! ((chain int))
  (dotimes (i 72)
    (set! (-> *desert-resource-match-visited* i) 0)
    (set! (-> *desert-resource-match-clear* i) 0))
  (dotimes (start 72)
    (let ((material (-> *desert-resource-match-grid* start)))
      (when (and (> material 0) (zero? (-> *desert-resource-match-visited* start)))
        (let ((head 0) (tail 1))
          (set! (-> *desert-resource-match-visited* start) 1)
          (set! (-> *desert-resource-match-queue* 0) start)
          (while (< head tail)
            (let* ((cell (-> *desert-resource-match-queue* head))
                   (x (mod cell 6)) (y (/ cell 6)))
              (1+! head)
              (when (> x 0) (set! tail (desert-resource-match-enqueue! (- cell 1) material tail)))
              (when (< x 5) (set! tail (desert-resource-match-enqueue! (+ cell 1) material tail)))
              (when (> y 0) (set! tail (desert-resource-match-enqueue! (- cell 6) material tail)))
              (when (< y 11) (set! tail (desert-resource-match-enqueue! (+ cell 6) material tail)))))
          (when (>= tail 4)
            (dotimes (member tail)
              (set! (-> *desert-resource-match-clear*
                        (-> *desert-resource-match-queue* member)) 1)))))))
  (let ((cleared 0))
    (dotimes (i 72)
      (when (!= (-> *desert-resource-match-clear* i) 0)
        (let ((material (-> *desert-resource-match-grid* i)))
          (when (> material 0)
            (1+! (-> *desert-resource-match-collected* (- material 1)))
            (1+! cleared)))
        (set! (-> *desert-resource-match-grid* i) 0)))
    (when (> cleared 0)
      (+! *desert-resource-match-score* (* cleared 10 chain))
      (desert-resource-match-gravity!))
    (> cleared 0)))

(defun desert-resource-match-lock! ()
  (let ((bx (desert-resource-match-bx *desert-resource-match-x* *desert-resource-match-rotation*))
        (by (desert-resource-match-by *desert-resource-match-y* *desert-resource-match-rotation*)))
    (if (or (>= *desert-resource-match-y* 12) (>= by 12))
        (set! *desert-resource-match-state* 2)
        (begin
          (set! (-> *desert-resource-match-grid*
                    (+ *desert-resource-match-x* (* *desert-resource-match-y* 6)))
                *desert-resource-match-a*)
          (set! (-> *desert-resource-match-grid* (+ bx (* by 6))) *desert-resource-match-b*)
          (let ((chain 1))
            (while (desert-resource-match-clear! chain) (1+! chain))
            (set! *desert-resource-match-chain* (- chain 1)))
          (if (>= (+ (-> *desert-resource-match-collected* 0)
                       (-> *desert-resource-match-collected* 1)
                       (-> *desert-resource-match-collected* 2)
                       (-> *desert-resource-match-collected* 3))
                  *desert-resource-match-goal*)
              (set! *desert-resource-match-state* 1)
              (desert-resource-match-spawn!)))))
  (none))

(defun desert-resource-match-drop! ()
  (if (desert-resource-match-fits?
        *desert-resource-match-x* (- *desert-resource-match-y* 1)
        *desert-resource-match-rotation*)
      (1-! *desert-resource-match-y*)
      (desert-resource-match-lock!))
  (none))

(defun desert-resource-match-draw-cell ((x int) (y int) (material int))
  (when (and (> material 0) (>= y 0) (< y 12))
    (let ((sx (+ 117 (* x 24))) (sy (- 333 (* y 24))))
      (with-dma-buffer-add-bucket ((buf (-> *display* frames (-> *display* on-screen) global-buf))
                                   (bucket-id hud-draw-hud-alpha))
        (draw-sprite2d-xy buf sx sy 21 21
          (case material
            ((1) (new 'static 'rgba :r 132 :g 136 :b 148 :a 255))
            ((2) (new 'static 'rgba :r 232 :g 64 :b 52 :a 255))
            ((3) (new 'static 'rgba :r 54 :g 142 :b 246 :a 255))
            (else (new 'static 'rgba :r 244 :g 205 :b 48 :a 255))) #x3fffff))))
  (none))

(defun desert-resource-match-draw ()
  (let ((font (new 'stack 'font-context *font-default-matrix* 56 48 0.0
                   (font-color default) (font-flags shadow kerning))))
    (with-dma-buffer-add-bucket ((buf (-> *display* frames (-> *display* on-screen) global-buf))
                                 (bucket-id hud-draw-hud-alpha))
      (draw-sprite2d-xy buf 72 30 368 390 (new 'static 'rgba :r 8 :g 12 :b 20 :a 224) #x3fffff)
      (draw-sprite2d-xy buf 76 34 360 382 (new 'static 'rgba :r 27 :g 37 :b 51 :a 232) #x3fffff)
      (draw-sprite2d-xy buf 112 61 154 298 (new 'static 'rgba :r 5 :g 8 :b 13 :a 245) #x3fffff))
    (dotimes (i 72)
      (let ((material (-> *desert-resource-match-grid* i)))
        (when (> material 0) (desert-resource-match-draw-cell (mod i 6) (/ i 6) material))))
    (when (zero? *desert-resource-match-state*)
      (desert-resource-match-draw-cell *desert-resource-match-x* *desert-resource-match-y*
                                        *desert-resource-match-a*)
      (desert-resource-match-draw-cell
        (desert-resource-match-bx *desert-resource-match-x* *desert-resource-match-rotation*)
        (desert-resource-match-by *desert-resource-match-y* *desert-resource-match-rotation*)
        *desert-resource-match-b*))
    (set! (-> font flags) (font-flags shadow kerning middle middle-vert large))
    (set-width! font 360) (set-height! font 50) (set! (-> font origin x) 256.0)
    (set-scale! font 0.40) (set! (-> font color) (font-color cyan))
    (format (clear *temp-string*) "RESOURCE MATCH")
    (pc-encode-utf8-string *temp-string* *pc-encoded-temp-string*)
    (print-game-text *pc-encoded-temp-string* font #f 44 (bucket-id hud-draw-hud-alpha))
    (set! (-> font flags) (font-flags shadow kerning))
    (set-width! font 155) (set! (-> font origin x) 282.0) (set-scale! font 0.25)
    (set! (-> font color) (font-color default))
    (set! (-> font origin y) 82.0)
    (format (clear *temp-string*) "GOAL ~D/~D"
      (+ (-> *desert-resource-match-collected* 0) (-> *desert-resource-match-collected* 1)
         (-> *desert-resource-match-collected* 2) (-> *desert-resource-match-collected* 3))
      *desert-resource-match-goal*)
    (pc-encode-utf8-string *temp-string* *pc-encoded-temp-string*)
    (print-game-text *pc-encoded-temp-string* font #f 44 (bucket-id hud-draw-hud-alpha))
    (set! (-> font origin y) 116.0)
    (format (clear *temp-string*) "SCORE ~D" *desert-resource-match-score*)
    (pc-encode-utf8-string *temp-string* *pc-encoded-temp-string*)
    (print-game-text *pc-encoded-temp-string* font #f 44 (bucket-id hud-draw-hud-alpha))
    (set! (-> font origin y) 150.0)
    (format (clear *temp-string*) "CHAIN ~D" *desert-resource-match-chain*)
    (pc-encode-utf8-string *temp-string* *pc-encoded-temp-string*)
    (print-game-text *pc-encoded-temp-string* font #f 44 (bucket-id hud-draw-hud-alpha))
    (dotimes (i 4)
      (set! (-> font origin y) (+ 220.0 (* (the float i) 30.0)))
      (format (clear *temp-string*) "~A  ~D"
        (case i ((0) "ROCK") ((1) "RED") ((2) "BLUE") (else "YELLOW"))
        (-> *desert-resource-match-collected* i))
      (pc-encode-utf8-string *temp-string* *pc-encoded-temp-string*)
      (print-game-text *pc-encoded-temp-string* font #f 44 (bucket-id hud-draw-hud-alpha)))
    (set! (-> font flags) (font-flags shadow kerning middle middle-vert))
    (set-width! font 390) (set! (-> font origin x) 256.0) (set! (-> font origin y) 399.0)
    (set-scale! font 0.22)
    (format (clear *temp-string*)
      (if (zero? *desert-resource-match-state*)
          "<PAD_DPAD_LEFT><PAD_DPAD_RIGHT> MOVE  <PAD_DPAD_DOWN> DROP  <PAD_X> ROTATE  <PAD_CIRCLE> EXIT"
          "<PAD_X> RESTART  <PAD_CIRCLE> EXIT"))
    (pc-encode-utf8-string *temp-string* *pc-encoded-temp-string*)
    (print-game-text *pc-encoded-temp-string* font #f 44 (bucket-id hud-draw-hud-alpha)))
  (none))

(defun desert-resource-match-update ()
  ;; Temporary world-space visualization of the exact 3-meter interaction sphere.
  (when (logtest? (-> *game-info* secrets) (game-secrets hero-mode))
    (add-debug-sphere
      #t
      (bucket-id debug-no-zbuf1)
      *desert-resource-match-pos*
      (meters 3.0)
      *desert-resource-match-radius-color*))
  (when *target*
    (let* ((distance
             (vector-vector-distance (target-pos 0) *desert-resource-match-pos*))
           (distance-squared (* distance distance))
           (hero? (logtest? (-> *game-info* secrets) (game-secrets hero-mode)))
           (near? (and hero? (< distance-squared (square (meters 25.0)))))
           (inside? (and hero? (< distance-squared (square (meters 3.0))))))
      (when (neq? near? *desert-resource-match-near-trigger?*)
        (set! *desert-resource-match-near-trigger?* near?)
        (when near?
          (format #t "[resource-match] near trigger; jak=(~m, ~m, ~m) distance=~m~%"
                  (-> (target-pos 0) x) (-> (target-pos 0) y) (-> (target-pos 0) z)
                  distance)))
      (when (neq? inside? *desert-resource-match-inside-trigger?*)
        (set! *desert-resource-match-inside-trigger?* inside?)
        (format #t "[resource-match] inside radius: ~A; hero: ~A; eligible: ~A~%"
                inside? hero? (and inside? (not *popup-menu-open*))))))
  (cond
    (*desert-resource-match-open?*
     (when (and (zero? *desert-resource-match-state*) (cpad-pressed? 0 left right))
       (let ((nx (+ *desert-resource-match-x* (if (cpad-pressed? 0 left) -1 1))))
         (when (desert-resource-match-fits? nx *desert-resource-match-y* *desert-resource-match-rotation*)
           (set! *desert-resource-match-x* nx) (sound-play "menu-pick")))
       (cpad-clear! 0 left right))
     (when (and (zero? *desert-resource-match-state*) (cpad-pressed? 0 x))
       (let ((nr (mod (+ *desert-resource-match-rotation* 1) 4)))
         (cond
           ((desert-resource-match-fits? *desert-resource-match-x* *desert-resource-match-y* nr)
            (set! *desert-resource-match-rotation* nr))
           ((desert-resource-match-fits? (- *desert-resource-match-x* 1) *desert-resource-match-y* nr)
            (1-! *desert-resource-match-x*) (set! *desert-resource-match-rotation* nr))
           ((desert-resource-match-fits? (+ *desert-resource-match-x* 1) *desert-resource-match-y* nr)
            (1+! *desert-resource-match-x*) (set! *desert-resource-match-rotation* nr))))
       (cpad-clear! 0 x))
     (when (and (!= *desert-resource-match-state* 0) (cpad-pressed? 0 x))
       (desert-resource-match-reset!) (cpad-clear! 0 x))
     (when (zero? *desert-resource-match-state*)
       (1+! *desert-resource-match-drop-tick*)
       (when (>= *desert-resource-match-drop-tick* (if (cpad-hold? 0 down l-analog-down) 3 20))
         (set! *desert-resource-match-drop-tick* 0) (desert-resource-match-drop!)))
     (when (cpad-pressed? 0 circle triangle)
       (desert-resource-match-close!) (cpad-clear! 0 circle triangle))
     (desert-resource-match-draw))
    ((and (logtest? (-> *game-info* secrets) (game-secrets hero-mode))
          *target* (not *popup-menu-open*)
          (< (vector-vector-distance-squared (target-pos 0) *desert-resource-match-pos*)
             (square (meters 3.0))))
     (let ((font (new 'stack 'font-context *font-default-matrix* 56 330 0.0
                      (font-color default) (font-flags shadow kerning middle middle-vert large))))
       (set-width! font 400) (set-height! font 80) (set-scale! font 0.7)
       (format (clear *temp-string*) "Press <PAD_TRIANGLE> to collect resources")
       (pc-encode-utf8-string *temp-string* *pc-encoded-temp-string*)
       (print-game-text *pc-encoded-temp-string* font #f 44 (bucket-id hud-draw-hud-alpha)))
     (when (cpad-pressed? 0 triangle)
       (format #t "[resource-match] Triangle detected; opening minigame~%")
       (desert-resource-match-reset!)
       (set! *desert-resource-match-open?* #t)
       (set! *popup-menu-open* #t)
       (set-master-mode 'menu)
       (cpad-clear! 0 triangle)
       (format #t "[resource-match] initialized: open=~A state=~D~%"
               *desert-resource-match-open?* *desert-resource-match-state*))))
  (none))

(deftype desert-resource-match-manager (process) ()
  (:state-methods idle))

(define *desert-resource-match-manager-process*
  (the-as (pointer desert-resource-match-manager) #f))

(defstate idle (desert-resource-match-manager)
  :virtual #t
  :trans (behavior () (desert-resource-match-update))
  :code sleep-code)

(defbehavior desert-resource-match-manager-init-by-other desert-resource-match-manager ()
  (process-mask-clear! (-> self mask) menu pause)
  (go-virtual idle))

(defun desert-resource-match-start ()
  (when (not *desert-resource-match-manager-process*)
    (set! *desert-resource-match-manager-process*
          (process-spawn desert-resource-match-manager :name "desert-resource-match" :to *entity-pool*))
    (format #t "[resource-match] manager running; trigger=(3033.70, 8.63, 1681.03), radius=3.0m~%"))
  (none))

(defun desert-resource-match-stop ()
  (desert-resource-match-close!)
  (kill-by-type desert-resource-match-manager *active-pool*)
  (set! *desert-resource-match-manager-process* #f)
  (none))

(defun desert-with-flut-and-resource-match-activate ((owner level))
  (desert-with-flut-activate owner)
  (desert-resource-match-start)
  (none))

(defun desert-with-flut-and-resource-match-deactivate ((owner level))
  (desert-resource-match-stop)
  (desert-with-flut-deactivate owner)
  (none))
