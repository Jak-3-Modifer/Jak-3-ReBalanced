;;-*-Lisp-*-
(in-package goal)

(define-extern *v-turtle-tuning-category* int)
(define-extern *v-turtle-tuning-selection* int)
(define-extern v-turtle-tuning-category-count (function int int))
(define-extern v-turtle-tuning-index-at (function int int int))
(define-extern v-turtle-tuning-open! (function none))
(define-extern v-turtle-tuning-close! (function none))
(define-extern v-turtle-tuning-apply! (function none))
(define-extern v-turtle-tuning-adjust! (function int int none))
(define-extern v-turtle-tuning-reset-selected! (function int none))
(define-extern v-turtle-tuning-reset-all! (function none))
(define-extern v-turtle-tuning-value (function int symbol float))
(define-extern v-turtle-tuning-min-value (function int float))
(define-extern v-turtle-tuning-max-value (function int float))
(define-extern turtle-tuning-parameter-price (function int int))
(define-extern turtle-tuning-total-cost (function int))
(define-extern *v-turtle-tuning-confirm?* symbol)

;; name: wasdoors-init.gc
;; name in dgo: wasdoors-init
;; dgos: WSD

;; DECOMP BEGINS

(define *v-turtle-loadout-trigger-pos*
  (new 'static 'vector :x 9348997.12 :y 126648.32 :z 698982.4 :w 1.0)
  )

(define *v-snake-loadout-trigger-pos*
  ;; 2297.25, 31.71, 173.46 in garage world-space meters.
  (new 'static 'vector :x 9409536.0 :y 129884.16 :z 710492.16 :w 1.0)
  )

;; Hero Mode prototype trigger for the falling-rock collection minigame.
;; 2264.97, 9.46, -42.28 in Wasdoors world-space meters.
(define *wasdoors-rock-catcher-trigger-pos*
  (new 'static 'vector :x 9277317.12 :y 38748.16 :z -173178.88 :w 1.0)
  )

(define *wasdoors-rock-catcher-open?* #f)
(define *wasdoors-rock-catcher-grid* (new 'static 'array int32 72))
(define *wasdoors-rock-catcher-visited* (new 'static 'array int32 72))
(define *wasdoors-rock-catcher-clear* (new 'static 'array int32 72))
(define *wasdoors-rock-catcher-queue* (new 'static 'array int32 72))
(define *wasdoors-rock-catcher-collected* (new 'static 'array int32 4))
(define *wasdoors-rock-catcher-pair-x* 2)
(define *wasdoors-rock-catcher-pair-y* 11)
(define *wasdoors-rock-catcher-pair-rotation* 0)
(define *wasdoors-rock-catcher-pair-a* 1)
(define *wasdoors-rock-catcher-pair-b* 1)
(define *wasdoors-rock-catcher-drop-tick* 0)
(define *wasdoors-rock-catcher-score* 0)
(define *wasdoors-rock-catcher-last-chain* 0)
;; 0 = playing, 1 = collection goal reached, 2 = board filled.
(define *wasdoors-rock-catcher-state* 0)
;; Runtime-only prototype goal.  No saved inventory is modified.
(define *wasdoors-rock-catcher-goal* 40)

(defun wasdoors-rock-catcher-random-material ()
  ;; Rock 50%, red 25%, blue 17%, yellow 8%.
  (let ((roll (rand-vu-int-count 100)))
    (cond
      ((< roll 50) 1)
      ((< roll 75) 2)
      ((< roll 92) 3)
      (else 4)
      )
    )
  )

(defun wasdoors-rock-catcher-pair-b-x ((x int) (rotation int))
  (+ x (case rotation ((1) 1) ((3) -1) (else 0)))
  )

(defun wasdoors-rock-catcher-pair-b-y ((y int) (rotation int))
  (+ y (case rotation ((0) 1) ((2) -1) (else 0)))
  )

(defun wasdoors-rock-catcher-cell-open? ((x int) (y int))
  (and (>= x 0)
       (< x 6)
       (>= y 0)
       (or (>= y 12)
           (zero? (-> *wasdoors-rock-catcher-grid* (+ x (* y 6))))))
  )

(defun wasdoors-rock-catcher-pair-fits? ((x int) (y int) (rotation int))
  (and (wasdoors-rock-catcher-cell-open? x y)
       (wasdoors-rock-catcher-cell-open?
         (wasdoors-rock-catcher-pair-b-x x rotation)
         (wasdoors-rock-catcher-pair-b-y y rotation)))
  )

(defun wasdoors-rock-catcher-spawn-pair! ()
  (set! *wasdoors-rock-catcher-pair-x* 2)
  (set! *wasdoors-rock-catcher-pair-y* 11)
  (set! *wasdoors-rock-catcher-pair-rotation* 0)
  (set! *wasdoors-rock-catcher-pair-a* (wasdoors-rock-catcher-random-material))
  (set! *wasdoors-rock-catcher-pair-b* (wasdoors-rock-catcher-random-material))
  (set! *wasdoors-rock-catcher-drop-tick* 0)
  (when (not (wasdoors-rock-catcher-pair-fits?
               *wasdoors-rock-catcher-pair-x*
               *wasdoors-rock-catcher-pair-y*
               *wasdoors-rock-catcher-pair-rotation*))
    (set! *wasdoors-rock-catcher-state* 2)
    )
  (none)
  )

(defun wasdoors-reset-rock-catcher ()
  (dotimes (index 72)
    (set! (-> *wasdoors-rock-catcher-grid* index) 0)
    (set! (-> *wasdoors-rock-catcher-visited* index) 0)
    (set! (-> *wasdoors-rock-catcher-clear* index) 0)
    )
  (dotimes (index 4)
    (set! (-> *wasdoors-rock-catcher-collected* index) 0)
    )
  (set! *wasdoors-rock-catcher-score* 0)
  (set! *wasdoors-rock-catcher-last-chain* 0)
  (set! *wasdoors-rock-catcher-state* 0)
  (wasdoors-rock-catcher-spawn-pair!)
  (none)
  )

(defun wasdoors-close-rock-catcher ()
  (when *wasdoors-rock-catcher-open?*
    (set! *wasdoors-rock-catcher-open?* #f)
    (set! *popup-menu-open* #f)
    (set-master-mode 'game)
    )
  (none)
  )

(defun wasdoors-rock-catcher-draw-cell ((x int) (y int) (material int))
  (let ((screen-x (+ 117 (* x 24)))
        (screen-y (- 333 (* y 24))))
    (when (and (> material 0) (>= y 0) (< y 12))
      (with-dma-buffer-add-bucket ((buf (-> *display* frames (-> *display* on-screen) global-buf))
                                   (bucket-id hud-draw-hud-alpha))
        (draw-sprite2d-xy buf screen-x screen-y 21 21
          (case material
            ((1) (new 'static 'rgba :r 132 :g 136 :b 148 :a 255))
            ((2) (new 'static 'rgba :r 232 :g 64 :b 52 :a 255))
            ((3) (new 'static 'rgba :r 54 :g 142 :b 246 :a 255))
            (else (new 'static 'rgba :r 244 :g 205 :b 48 :a 255)))
          #x3fffff)
        (draw-sprite2d-xy buf (+ screen-x 4) (+ screen-y 3) 8 5
          (new 'static 'rgba :r 255 :g 255 :b 255 :a 100) #x3fffff)
        )
      )
    )
  (none)
  )

(defun wasdoors-draw-rock-catcher ()
  (let ((font (new 'stack 'font-context *font-default-matrix* 56 65 0.0
                   (font-color default)
                   (font-flags shadow kerning)
                   )))
    ;; The board remains a self-contained 2D overlay.  Its collection totals
    ;; are deliberately not connected to persistent inventory in this milestone.
    (with-dma-buffer-add-bucket ((buf (-> *display* frames (-> *display* on-screen) global-buf))
                                 (bucket-id hud-draw-hud-alpha))
      (draw-sprite2d-xy buf 72 30 368 390 (new 'static 'rgba :r 8 :g 12 :b 20 :a 224) #x3fffff)
      (draw-sprite2d-xy buf 76 34 360 382 (new 'static 'rgba :r 27 :g 37 :b 51 :a 232) #x3fffff)
      (draw-sprite2d-xy buf 112 61 154 298 (new 'static 'rgba :r 5 :g 8 :b 13 :a 245) #x3fffff)
      (draw-sprite2d-xy buf 116 65 146 290 (new 'static 'rgba :r 18 :g 24 :b 32 :a 255) #x3fffff)
      )
    (dotimes (index 72)
      (let ((material (-> *wasdoors-rock-catcher-grid* index)))
        (when (> material 0)
          (wasdoors-rock-catcher-draw-cell (mod index 6) (/ index 6) material)
          )
        )
      )
    (when (zero? *wasdoors-rock-catcher-state*)
      (wasdoors-rock-catcher-draw-cell
        *wasdoors-rock-catcher-pair-x*
        *wasdoors-rock-catcher-pair-y*
        *wasdoors-rock-catcher-pair-a*)
      (wasdoors-rock-catcher-draw-cell
        (wasdoors-rock-catcher-pair-b-x
          *wasdoors-rock-catcher-pair-x* *wasdoors-rock-catcher-pair-rotation*)
        (wasdoors-rock-catcher-pair-b-y
          *wasdoors-rock-catcher-pair-y* *wasdoors-rock-catcher-pair-rotation*)
        *wasdoors-rock-catcher-pair-b*)
      )
    (set! (-> font flags) (font-flags shadow kerning middle middle-vert large))
    (set-width! font 360)
    (set-height! font 50)
    (set! (-> font origin x) 256.0)
    (set! (-> font origin y) 48.0)
    (set-scale! font 0.40)
    (set! (-> font color) (font-color cyan))
    (format (clear *temp-string*) "RESOURCE MATCH")
    (pc-encode-utf8-string *temp-string* *pc-encoded-temp-string*)
    (print-game-text *pc-encoded-temp-string* font #f 44 (bucket-id hud-draw-hud-alpha))
    (set! (-> font flags) (font-flags shadow kerning))
    (set-width! font 155)
    (set! (-> font origin x) 282.0)
    (set! (-> font origin y) 82.0)
    (set-scale! font 0.25)
    (set! (-> font color) (font-color default))
    (format (clear *temp-string*) "GOAL: ~D / ~D"
            (+ (-> *wasdoors-rock-catcher-collected* 0)
               (-> *wasdoors-rock-catcher-collected* 1)
               (-> *wasdoors-rock-catcher-collected* 2)
               (-> *wasdoors-rock-catcher-collected* 3))
            *wasdoors-rock-catcher-goal*)
    (pc-encode-utf8-string *temp-string* *pc-encoded-temp-string*)
    (print-game-text *pc-encoded-temp-string* font #f 44 (bucket-id hud-draw-hud-alpha))
    (set! (-> font origin y) 116.0)
    (format (clear *temp-string*) "SCORE: ~D" *wasdoors-rock-catcher-score*)
    (pc-encode-utf8-string *temp-string* *pc-encoded-temp-string*)
    (print-game-text *pc-encoded-temp-string* font #f 44 (bucket-id hud-draw-hud-alpha))
    (set! (-> font origin y) 150.0)
    (format (clear *temp-string*) "CHAIN: ~D" *wasdoors-rock-catcher-last-chain*)
    (pc-encode-utf8-string *temp-string* *pc-encoded-temp-string*)
    (print-game-text *pc-encoded-temp-string* font #f 44 (bucket-id hud-draw-hud-alpha))
    (set! (-> font origin y) 202.0)
    (set! (-> font color) (font-color menu-parent))
    (format (clear *temp-string*) "COLLECTED")
    (pc-encode-utf8-string *temp-string* *pc-encoded-temp-string*)
    (print-game-text *pc-encoded-temp-string* font #f 44 (bucket-id hud-draw-hud-alpha))
    (set! (-> font color) (font-color default))
    (set! (-> font origin y) 232.0)
    (format (clear *temp-string*) "ROCK       ~D" (-> *wasdoors-rock-catcher-collected* 0))
    (pc-encode-utf8-string *temp-string* *pc-encoded-temp-string*)
    (print-game-text *pc-encoded-temp-string* font #f 44 (bucket-id hud-draw-hud-alpha))
    (set! (-> font origin y) 258.0)
    (format (clear *temp-string*) "RED        ~D" (-> *wasdoors-rock-catcher-collected* 1))
    (pc-encode-utf8-string *temp-string* *pc-encoded-temp-string*)
    (print-game-text *pc-encoded-temp-string* font #f 44 (bucket-id hud-draw-hud-alpha))
    (set! (-> font origin y) 284.0)
    (format (clear *temp-string*) "BLUE       ~D" (-> *wasdoors-rock-catcher-collected* 2))
    (pc-encode-utf8-string *temp-string* *pc-encoded-temp-string*)
    (print-game-text *pc-encoded-temp-string* font #f 44 (bucket-id hud-draw-hud-alpha))
    (set! (-> font origin y) 310.0)
    (format (clear *temp-string*) "YELLOW     ~D" (-> *wasdoors-rock-catcher-collected* 3))
    (pc-encode-utf8-string *temp-string* *pc-encoded-temp-string*)
    (print-game-text *pc-encoded-temp-string* font #f 44 (bucket-id hud-draw-hud-alpha))
    (when (!= *wasdoors-rock-catcher-state* 0)
      (set! (-> font flags) (font-flags shadow kerning middle middle-vert large))
      (set-width! font 320)
      (set! (-> font origin x) 256.0)
      (set! (-> font origin y) 368.0)
      (set-scale! font 0.34)
      (set! (-> font color) (if (= *wasdoors-rock-catcher-state* 1)
                                (font-color green)
                                (font-color red)))
      (format (clear *temp-string*)
              (if (= *wasdoors-rock-catcher-state* 1) "COLLECTION COMPLETE" "BOARD FULL"))
      (pc-encode-utf8-string *temp-string* *pc-encoded-temp-string*)
      (print-game-text *pc-encoded-temp-string* font #f 44 (bucket-id hud-draw-hud-alpha))
      )
    (set! (-> font flags) (font-flags shadow kerning middle middle-vert))
    (set-width! font 390)
    (set! (-> font origin x) 256.0)
    (set! (-> font origin y) 399.0)
    (set-scale! font 0.22)
    (set! (-> font color) (font-color default))
    (format (clear *temp-string*)
            (if (zero? *wasdoors-rock-catcher-state*)
                "<PAD_DPAD_LEFT><PAD_DPAD_RIGHT> MOVE  <PAD_DPAD_DOWN> DROP  <PAD_X> ROTATE  <PAD_CIRCLE> EXIT"
                "<PAD_X> RESTART     <PAD_CIRCLE> EXIT"))
    (pc-encode-utf8-string *temp-string* *pc-encoded-temp-string*)
    (print-game-text *pc-encoded-temp-string* font #f 44 (bucket-id hud-draw-hud-alpha))
    )
  (none)
  )

(defun wasdoors-rock-catcher-enqueue! ((index int) (material int) (tail int))
  (if (and (>= index 0)
           (< index 72)
           (zero? (-> *wasdoors-rock-catcher-visited* index))
           (= (-> *wasdoors-rock-catcher-grid* index) material))
      (begin
        (set! (-> *wasdoors-rock-catcher-visited* index) 1)
        (set! (-> *wasdoors-rock-catcher-queue* tail) index)
        (+ tail 1))
      tail)
  )

(defun wasdoors-rock-catcher-apply-gravity! ()
  (dotimes (x 6)
    (let ((write-y 0))
      (dotimes (y 12)
        (let* ((source (+ x (* y 6)))
               (material (-> *wasdoors-rock-catcher-grid* source)))
          (when (> material 0)
            (let ((dest (+ x (* write-y 6))))
              (when (!= dest source)
                (set! (-> *wasdoors-rock-catcher-grid* dest) material)
                (set! (-> *wasdoors-rock-catcher-grid* source) 0)
                )
              )
            (1+! write-y)
            )
          )
        )
      )
    )
  (none)
  )

(defun wasdoors-rock-catcher-clear-matches! ((chain int))
  (dotimes (index 72)
    (set! (-> *wasdoors-rock-catcher-visited* index) 0)
    (set! (-> *wasdoors-rock-catcher-clear* index) 0)
    )
  (dotimes (start 72)
    (let ((material (-> *wasdoors-rock-catcher-grid* start)))
      (when (and (> material 0)
                 (zero? (-> *wasdoors-rock-catcher-visited* start)))
        (let ((head 0)
              (tail 1))
          (set! (-> *wasdoors-rock-catcher-visited* start) 1)
          (set! (-> *wasdoors-rock-catcher-queue* 0) start)
          (while (< head tail)
            (let* ((cell (-> *wasdoors-rock-catcher-queue* head))
                   (x (mod cell 6))
                   (y (/ cell 6)))
              (1+! head)
              (when (> x 0)
                (set! tail (wasdoors-rock-catcher-enqueue! (- cell 1) material tail)))
              (when (< x 5)
                (set! tail (wasdoors-rock-catcher-enqueue! (+ cell 1) material tail)))
              (when (> y 0)
                (set! tail (wasdoors-rock-catcher-enqueue! (- cell 6) material tail)))
              (when (< y 11)
                (set! tail (wasdoors-rock-catcher-enqueue! (+ cell 6) material tail)))
              )
            )
          (when (>= tail 4)
            (dotimes (member tail)
              (set! (-> *wasdoors-rock-catcher-clear*
                        (-> *wasdoors-rock-catcher-queue* member)) 1)
              )
            )
          )
        )
      )
    )
  (let ((cleared 0))
    (dotimes (index 72)
      (when (!= (-> *wasdoors-rock-catcher-clear* index) 0)
        (let ((material (-> *wasdoors-rock-catcher-grid* index)))
          (when (> material 0)
            (1+! (-> *wasdoors-rock-catcher-collected* (- material 1)))
            (1+! cleared)
            )
          )
        (set! (-> *wasdoors-rock-catcher-grid* index) 0)
        )
      )
    (when (> cleared 0)
      (+! *wasdoors-rock-catcher-score* (* cleared 10 chain))
      (wasdoors-rock-catcher-apply-gravity!)
      )
    (> cleared 0)
    )
  )

(defun wasdoors-rock-catcher-lock-pair! ()
  (let ((bx (wasdoors-rock-catcher-pair-b-x
              *wasdoors-rock-catcher-pair-x* *wasdoors-rock-catcher-pair-rotation*))
        (by (wasdoors-rock-catcher-pair-b-y
              *wasdoors-rock-catcher-pair-y* *wasdoors-rock-catcher-pair-rotation*)))
    (if (or (>= *wasdoors-rock-catcher-pair-y* 12) (>= by 12))
        (set! *wasdoors-rock-catcher-state* 2)
        (begin
          (set! (-> *wasdoors-rock-catcher-grid*
                    (+ *wasdoors-rock-catcher-pair-x* (* *wasdoors-rock-catcher-pair-y* 6)))
                *wasdoors-rock-catcher-pair-a*)
          (set! (-> *wasdoors-rock-catcher-grid* (+ bx (* by 6)))
                *wasdoors-rock-catcher-pair-b*)
          (let ((chain 1))
            (while (wasdoors-rock-catcher-clear-matches! chain)
              (1+! chain)
              )
            (set! *wasdoors-rock-catcher-last-chain* (- chain 1))
            )
          (if (>= (+ (-> *wasdoors-rock-catcher-collected* 0)
                       (-> *wasdoors-rock-catcher-collected* 1)
                       (-> *wasdoors-rock-catcher-collected* 2)
                       (-> *wasdoors-rock-catcher-collected* 3))
                  *wasdoors-rock-catcher-goal*)
              (set! *wasdoors-rock-catcher-state* 1)
              (wasdoors-rock-catcher-spawn-pair!))
          )
        )
    )
  (none)
  )

(defun wasdoors-rock-catcher-drop! ()
  (if (wasdoors-rock-catcher-pair-fits?
        *wasdoors-rock-catcher-pair-x*
        (- *wasdoors-rock-catcher-pair-y* 1)
        *wasdoors-rock-catcher-pair-rotation*)
      (1-! *wasdoors-rock-catcher-pair-y*)
      (wasdoors-rock-catcher-lock-pair!))
  (none)
  )

(defun wasdoors-update-rock-catcher ()
  (cond
    ((not (logtest? (-> *game-info* secrets) (game-secrets hero-mode)))
     (wasdoors-close-rock-catcher)
     )
    (*wasdoors-rock-catcher-open?*
     (when (and (zero? *wasdoors-rock-catcher-state*)
                (cpad-pressed? 0 left right))
       (let ((new-x (+ *wasdoors-rock-catcher-pair-x*
                       (if (cpad-pressed? 0 left) -1 1))))
         (when (wasdoors-rock-catcher-pair-fits?
                 new-x *wasdoors-rock-catcher-pair-y*
                 *wasdoors-rock-catcher-pair-rotation*)
           (set! *wasdoors-rock-catcher-pair-x* new-x)
           (sound-play "menu-pick")
           )
         )
       (cpad-clear! 0 left right)
       )
     (when (and (zero? *wasdoors-rock-catcher-state*)
                (cpad-pressed? 0 x))
       (let ((new-rotation (mod (+ *wasdoors-rock-catcher-pair-rotation* 1) 4)))
         (cond
           ((wasdoors-rock-catcher-pair-fits?
              *wasdoors-rock-catcher-pair-x* *wasdoors-rock-catcher-pair-y* new-rotation)
            (set! *wasdoors-rock-catcher-pair-rotation* new-rotation)
            (sound-play "menu-pick"))
           ((wasdoors-rock-catcher-pair-fits?
              (- *wasdoors-rock-catcher-pair-x* 1) *wasdoors-rock-catcher-pair-y* new-rotation)
            (1-! *wasdoors-rock-catcher-pair-x*)
            (set! *wasdoors-rock-catcher-pair-rotation* new-rotation)
            (sound-play "menu-pick"))
           ((wasdoors-rock-catcher-pair-fits?
              (+ *wasdoors-rock-catcher-pair-x* 1) *wasdoors-rock-catcher-pair-y* new-rotation)
            (1+! *wasdoors-rock-catcher-pair-x*)
            (set! *wasdoors-rock-catcher-pair-rotation* new-rotation)
            (sound-play "menu-pick"))
           (else (sound-play "menu-back"))
           )
         )
       (cpad-clear! 0 x)
       )
     (when (and (!= *wasdoors-rock-catcher-state* 0)
                (cpad-pressed? 0 x))
       (wasdoors-reset-rock-catcher)
       (sound-play "menu-pick")
       (cpad-clear! 0 x)
       )
     (when (zero? *wasdoors-rock-catcher-state*)
       (1+! *wasdoors-rock-catcher-drop-tick*)
       (when (>= *wasdoors-rock-catcher-drop-tick*
                 (if (cpad-hold? 0 down l-analog-down) 3 20))
         (set! *wasdoors-rock-catcher-drop-tick* 0)
         (wasdoors-rock-catcher-drop!)
         )
       )
     (when (cpad-pressed? 0 circle triangle)
       (wasdoors-close-rock-catcher)
       (cpad-clear! 0 circle triangle)
       )
     (wasdoors-draw-rock-catcher)
     )
    ((and *target*
          (not (focus-test? *target* pilot-riding))
          (< (vector-vector-distance-squared (target-pos 0) *wasdoors-rock-catcher-trigger-pos*)
             (square 8192.0)))
     (let ((font (new 'stack 'font-context *font-default-matrix* 56 330 0.0
                      (font-color default)
                      (font-flags shadow kerning)
                      )))
       (set! (-> font flags) (font-flags shadow kerning middle middle-vert large))
       (set-width! font 400)
       (set-height! font 80)
       (set-scale! font 0.7)
       (format (clear *temp-string*) "Press <PAD_X> to collect resources")
       (pc-encode-utf8-string *temp-string* *pc-encoded-temp-string*)
       (print-game-text *pc-encoded-temp-string* font #f 44 (bucket-id hud-draw-hud-alpha))
       )
     (when (cpad-pressed? 0 x)
       (wasdoors-reset-rock-catcher)
       (set! *wasdoors-rock-catcher-open?* #t)
       (set! *popup-menu-open* #t)
       (set-master-mode 'menu)
       (cpad-clear! 0 x)
       )
     )
    )
  (none)
  )

(defun wasdoors-v-turtle-faster-boost-unlocked? ()
  (task-node-open? (game-task-node desert-course-race-resolution))
  )

(defun wasdoors-draw-v-turtle-loadout-option-line ((font font-context) (text string) (y float) (selected? symbol) (equipped? symbol))
  (set! (-> font origin y) y)
  (set! (-> font color) (cond
                          (equipped? (font-color orange))
                          (selected? (font-color progress-old-selected))
                          (else (font-color default))
                          ))
  (format (clear *temp-string*) text)
  (pc-encode-utf8-string *temp-string* *pc-encoded-temp-string*)
  (print-game-text *pc-encoded-temp-string* font #f 44 (bucket-id hud-draw-hud-alpha))
  (none)
  )

(defun wasdoors-v-turtle-tuning-parameter-name ((index int))
  (case index
    ((0) "ENGINE POWER")
    ((1) "REV RESPONSE")
    ((2) "Steering Response")
    ((3) "Front Grip")
    ((4) "Rear Grip")
    ((5) "Brake Strength")
    ((6) "Front Suspension Stiffness")
    ((7) "Rear Suspension Stiffness")
    ((8) "Suspension Damping")
    ((9) "ENGINE DRAG")
    (else "POWERBAND")
    )
  )

(defun wasdoors-v-turtle-tuning-category-name ()
  (case *v-turtle-tuning-category*
    ((0) "ENGINE")
    ((1) "HANDLING")
    (else "SUSPENSION")
    )
  )

(defun wasdoors-draw-v-turtle-tuning-bar ((index int) (y int))
  "Draw the applied tune as a filled bar and the pending tune as an orange marker."
  (let* ((min-value (v-turtle-tuning-min-value index))
         (max-value (v-turtle-tuning-max-value index))
         (value-range (- max-value min-value))
         ;; Rev response is intentionally inverse: less inertia means a fuller
         ;; response bar and moving Right always improves the displayed stat.
         (current-ratio (if (> value-range 0.0)
                            (fmin 1.0
                                  (fmax 0.0
                                        (/ (if (= index 1)
                                               (- max-value (v-turtle-tuning-value index #f))
                                               (- (v-turtle-tuning-value index #f) min-value))
                                           value-range)))
                            0.0))
         (proposed-ratio (if (> value-range 0.0)
                             (fmin 1.0
                                   (fmax 0.0
                                         (/ (if (= index 1)
                                                (- max-value (v-turtle-tuning-value index #t))
                                                (- (v-turtle-tuning-value index #t) min-value))
                                            value-range)))
                             0.0))
         (bar-x 76)
         (bar-width 340)
         (fill-width (the int (* current-ratio (the float bar-width))))
         (marker-x (+ bar-x (the int (* proposed-ratio (the float bar-width)))))
         )
    (with-dma-buffer-add-bucket ((buf (-> *display* frames (-> *display* on-screen) global-buf))
                                  (bucket-id hud-draw-hud-alpha))
      (draw-sprite2d-xy buf bar-x y bar-width 8
                        (new 'static 'rgba :r 18 :g 24 :b 30 :a 210) #x3fffff)
      (draw-sprite2d-xy buf (+ bar-x 2) (+ y 2) (max 0 (- fill-width 4)) 4
                        (new 'static 'rgba :r 48 :g 196 :b 244 :a 255) #x3fffff)
      (draw-sprite2d-xy buf (- marker-x 2) (- y 2) 4 12
                        (new 'static 'rgba :r 255 :g 160 :b 32 :a 255) #x3fffff))
    )
  (none)
  )

(defun wasdoors-draw-v-turtle-loadout-menu ()
  (let ((font (new 'stack 'font-context *font-default-matrix* 56 65 0.0
                   (font-color default)
                   (font-flags shadow kerning)
                   )))
    (set! (-> font flags) (font-flags shadow kerning large))
    (set-width! font 400)
    (set-height! font 50)

    ;; Category or submenu title.
    (set-scale! font 0.48)
    (set! (-> font color) (font-color cyan))
    (case *v-turtle-loadout-menu-page*
      ((0) (format (clear *temp-string*) "Tough Puppy Loadout"))
      ((1) (format (clear *temp-string*) "Weapons"))
      ((2) (format (clear *temp-string*) "Abilities"))
      ((3) (format (clear *temp-string*) "Defense"))
      (else (format (clear *temp-string*) "VEHICLE TUNING"))
      )
    (pc-encode-utf8-string *temp-string* *pc-encoded-temp-string*)
    (print-game-text *pc-encoded-temp-string* font #f 44 (bucket-id hud-draw-hud-alpha))

    (set-scale! font 0.4)
    (when (= *v-turtle-loadout-menu-page* 4)
      (set-scale! font 0.23)
      (format (clear *temp-string*)
              "TURTLE     BALANCE: ~D ORBS"
              (the int (-> *game-info* money)))
      (wasdoors-draw-v-turtle-loadout-option-line
        font
        *temp-string*
        92.0
        #f
        #f)
      (set-scale! font 0.4))
    (case *v-turtle-loadout-menu-page*
      ((0)
       (wasdoors-draw-v-turtle-loadout-option-line
         font
         (if (= *v-turtle-loadout-menu-selection* 0) "> Weapons" "  Weapons")
         135.0
         (= *v-turtle-loadout-menu-selection* 0)
         #f
         )
       (wasdoors-draw-v-turtle-loadout-option-line
         font
         (if (= *v-turtle-loadout-menu-selection* 1) "> Abilities" "  Abilities")
         185.0
         (= *v-turtle-loadout-menu-selection* 1)
         #f
         )
       (wasdoors-draw-v-turtle-loadout-option-line
         font
         (if (= *v-turtle-loadout-menu-selection* 2) "> Defense" "  Defense")
         235.0
         (= *v-turtle-loadout-menu-selection* 2)
         #f
         )
       (wasdoors-draw-v-turtle-loadout-option-line
         font
         (if (= *v-turtle-loadout-menu-selection* 3) "> Tuning" "  Tuning")
         285.0
         (= *v-turtle-loadout-menu-selection* 3)
         #f
         )
       )
      ((1)
       (wasdoors-draw-v-turtle-loadout-option-line
         font
         (if (= *v-turtle-loadout-menu-selection* 0) "> None" "  None")
         150.0
         (= *v-turtle-loadout-menu-selection* 0)
         (= *v-turtle-weapon-loadout* 0)
         )
       (wasdoors-draw-v-turtle-loadout-option-line
         font
         (if (v-turtle-mass-inverter-unlocked?)
             (if (= *v-turtle-loadout-menu-selection* 1) "> Mass Inverter" "  Mass Inverter")
             (if (= *v-turtle-loadout-menu-selection* 1) "> ???" "  ???"))
         205.0
         (= *v-turtle-loadout-menu-selection* 1)
         (and (v-turtle-mass-inverter-unlocked?)
              (= *v-turtle-weapon-loadout* 1))
         )
       )
      ((2)
       (wasdoors-draw-v-turtle-loadout-option-line
         font
         (if (= *v-turtle-loadout-menu-selection* 0) "> None" "  None")
         90.0
         (= *v-turtle-loadout-menu-selection* 0)
         (= *v-turtle-ability-loadout* 0)
         )
       (wasdoors-draw-v-turtle-loadout-option-line
         font
         (if (= *v-turtle-loadout-menu-selection* 1) "> Vehicle Toughness" "  Vehicle Toughness")
         130.0
         (= *v-turtle-loadout-menu-selection* 1)
         *v-turtle-vehicle-toughness-equipped?*
         )
       (wasdoors-draw-v-turtle-loadout-option-line
         font
         (if (wasdoors-v-turtle-faster-boost-unlocked?)
             (if (= *v-turtle-loadout-menu-selection* 2) "> Faster Boost Cooldown" "  Faster Boost Cooldown")
             (if (= *v-turtle-loadout-menu-selection* 2) "> ???" "  ???"))
         170.0
         (= *v-turtle-loadout-menu-selection* 2)
         (and (wasdoors-v-turtle-faster-boost-unlocked?)
              (= *v-turtle-ability-loadout* 3))
         )
       (wasdoors-draw-v-turtle-loadout-option-line
         font
         (if (= *v-turtle-loadout-menu-selection* 3) "> Turret Jammer" "  Turret Jammer")
         210.0
         (= *v-turtle-loadout-menu-selection* 3)
         (= *v-turtle-ability-loadout* 6)
         )
       (wasdoors-draw-v-turtle-loadout-option-line
         font
         (if (= *v-turtle-loadout-menu-selection* 4) "> Regenerative Armor" "  Regenerative Armor")
         250.0
         (= *v-turtle-loadout-menu-selection* 4)
         (= *v-turtle-ability-loadout* 7)
         )
      )
      ((3)
        (wasdoors-draw-v-turtle-loadout-option-line
          font
          (if (= *v-turtle-loadout-menu-selection* 0) "> None" "  None")
          120.0
          (= *v-turtle-loadout-menu-selection* 0)
          (= *v-turtle-defense-loadout* 0)
          )
        (wasdoors-draw-v-turtle-loadout-option-line
          font
          (if (= *v-turtle-loadout-menu-selection* 1) "> Damage Shield" "  Damage Shield")
          155.0
          (= *v-turtle-loadout-menu-selection* 1)
          (= *v-turtle-defense-loadout* 4)
          )
        (wasdoors-draw-v-turtle-loadout-option-line
          font
          (if (= *v-turtle-loadout-menu-selection* 2) "> Emergency Repair" "  Emergency Repair")
          195.0
          (= *v-turtle-loadout-menu-selection* 2)
          (= *v-turtle-defense-loadout* 5)
          )
        (wasdoors-draw-v-turtle-loadout-option-line
          font
          (if (= *v-turtle-loadout-menu-selection* 3) "> Camouflage" "  Camouflage")
          235.0
          (= *v-turtle-loadout-menu-selection* 3)
          (= *v-turtle-defense-loadout* 8)
          )
        )
      (else
        ;; Submit the bars first so all labels render clearly over them.
        (dotimes (row (v-turtle-tuning-category-count *v-turtle-tuning-category*))
          (let ((index (v-turtle-tuning-index-at *v-turtle-tuning-category* row))
                (y (+ 128.0 (* (the float row) 43.0))))
            (wasdoors-draw-v-turtle-tuning-bar index (the int (+ y 19.0)))))
        (set-scale! font 0.22)
        (format (clear *temp-string*)
                "CATEGORY: ~A"
                (wasdoors-v-turtle-tuning-category-name))
        (wasdoors-draw-v-turtle-loadout-option-line
          font
          *temp-string*
          108.0
          #f
          #f)
        (set-scale! font 0.28)
        (dotimes (row (v-turtle-tuning-category-count *v-turtle-tuning-category*))
          (let ((index (v-turtle-tuning-index-at *v-turtle-tuning-category* row))
                (y (+ 128.0 (* (the float row) 43.0))))
            (format (clear *temp-string*)
                    "~A~A     PRICE ~D/STEP"
                    (if (= row *v-turtle-loadout-menu-selection*) "> " "  ")
                    (wasdoors-v-turtle-tuning-parameter-name index)
                    (turtle-tuning-parameter-price index))
            (wasdoors-draw-v-turtle-loadout-option-line
              font
              *temp-string*
              y
              (= row *v-turtle-loadout-menu-selection*)
              #f)
            (set-scale! font 0.17)
            (if (= index 0)
                (format (clear *temp-string*) "MIN ~D     CURRENT ~D     PROPOSED ~D     MAX ~D"
                        (the int (v-turtle-tuning-min-value index))
                        (the int (v-turtle-tuning-value index #f))
                        (the int (v-turtle-tuning-value index #t))
                        (the int (v-turtle-tuning-max-value index)))
                (format (clear *temp-string*) "MIN ~F     CURRENT ~F     PROPOSED ~F     MAX ~F"
                        (v-turtle-tuning-min-value index)
                        (v-turtle-tuning-value index #f)
                        (v-turtle-tuning-value index #t)
                        (v-turtle-tuning-max-value index)))
            (wasdoors-draw-v-turtle-loadout-option-line
              font *temp-string* (+ y 30.0) #f #f)
            (set-scale! font 0.28)
            )
          )
        (set-scale! font 0.25)
        (format (clear *temp-string*) "TOTAL PREVIEW COST: ~D ORBS" (turtle-tuning-total-cost))
        (wasdoors-draw-v-turtle-loadout-option-line font *temp-string* 310.0 #f #f)
        )
      )

    ;; Use one combined D-pad glyph for menu navigation.
    (set-scale! font 0.3)
    (when (!= *v-turtle-loadout-menu-page* 4)
      (wasdoors-draw-v-turtle-loadout-option-line
        font
        "<PAD_DPAD_DOWN>  Move"
        305.0
        #f
        #f
        ))
    (wasdoors-draw-v-turtle-loadout-option-line
      font
      (cond
        ((= *v-turtle-loadout-menu-page* 0)
         "<PAD_X>  Select     <PAD_TRIANGLE>  Exit")
        ((= *v-turtle-loadout-menu-page* 4)
         (if *v-turtle-tuning-confirm?*
             "PREVIEW: <PAD_X> Confirm Temporary Tune  <PAD_CIRCLE> Back"
             "<PAD_X> Review  <PAD_CIRCLE> Cancel  <PAD_TRIANGLE> Stock  <PAD_L1><PAD_R1> Category"))
        (else
          "<PAD_X>  Equip     <PAD_CIRCLE>  Back     <PAD_TRIANGLE>  Exit"))
      345.0
      #f
      #f
      )
    )
  (none)
  )

(defun wasdoors-update-v-turtle-loadout-menu ()
  (wasdoors-draw-v-turtle-loadout-menu)
  (let ((last-selection (cond
                          ((= *v-turtle-loadout-menu-page* 0) 3)
                          ((= *v-turtle-loadout-menu-page* 2) 4)
                          ((= *v-turtle-loadout-menu-page* 3) 3)
                          ((= *v-turtle-loadout-menu-page* 4)
                           (- (v-turtle-tuning-category-count *v-turtle-tuning-category*) 1))
                          (else 1)
                          )))
    (cond
      ((and (= *v-turtle-loadout-menu-page* 4) *v-turtle-tuning-confirm?*)
       (cond
         ((cpad-pressed? 0 x)
          ;; Development preview: apply temporary values without charging Orbs.
          (set! *v-turtle-tuning-confirm?* #f)
          (v-turtle-tuning-apply!)
          (set! *v-turtle-loadout-menu-selection* 3)
          (set! *v-turtle-loadout-menu-page* 0)
          (sound-play "menu-pick"))
         ((cpad-pressed? 0 circle)
          (set! *v-turtle-tuning-confirm?* #f)
          (sound-play "menu-back"))))
      ((cpad-pressed? 0 up)
       (dec! *v-turtle-loadout-menu-selection*)
       (when (< *v-turtle-loadout-menu-selection* 0)
         (set! *v-turtle-loadout-menu-selection* last-selection)
         )
       (sound-play "menu-pick")
       )
      ((cpad-pressed? 0 down)
       (inc! *v-turtle-loadout-menu-selection*)
       (when (> *v-turtle-loadout-menu-selection* last-selection)
         (set! *v-turtle-loadout-menu-selection* 0)
         )
       (sound-play "menu-pick")
       )
      ((and (= *v-turtle-loadout-menu-page* 4)
            (cpad-pressed? 0 l1 r1))
       (set! *v-turtle-tuning-category*
             (mod (+ *v-turtle-tuning-category*
                     (if (cpad-pressed? 0 l1) 2 1))
                  3))
       (set! *v-turtle-loadout-menu-selection* 0)
       (set! *v-turtle-tuning-selection* 0)
       (sound-play "menu-pick")
       )
      ((and (= *v-turtle-loadout-menu-page* 4)
            (cpad-pressed? 0 left right))
       (v-turtle-tuning-adjust!
         (v-turtle-tuning-index-at *v-turtle-tuning-category* *v-turtle-loadout-menu-selection*)
         (if (cpad-pressed? 0 left) -1 1))
       (sound-play "menu-pick")
       )
      ((and (= *v-turtle-loadout-menu-page* 4)
            (cpad-pressed? 0 r2))
       (v-turtle-tuning-reset-all!)
       (sound-play "menu-pick")
       )
      ((cpad-pressed? 0 x)
       (sound-play "menu-pick")
       (case *v-turtle-loadout-menu-page*
         ((0)
          (set! *v-turtle-loadout-menu-page* (+ *v-turtle-loadout-menu-selection* 1))
          (case *v-turtle-loadout-menu-page*
            ((1) (set! *v-turtle-loadout-menu-selection* (if (= *v-turtle-weapon-loadout* 1) 1 0)))
            ((2) (set! *v-turtle-loadout-menu-selection*
                       (if *v-turtle-vehicle-toughness-equipped?*
                           1
                           (case *v-turtle-ability-loadout*
                             ((3) 2)
                             ((6) 3)
                             ((7) 4)
                             (else 0)
                             ))))
            ((3) (set! *v-turtle-loadout-menu-selection*
                        (case *v-turtle-defense-loadout*
                          ((4) 1)
                          ((5) 2)
                          ((8) 3)
                          (else 0)
                          )))
            (else
              (v-turtle-tuning-open!)
              (set! *v-turtle-loadout-menu-selection* 0)
              (set! *v-turtle-tuning-selection* 0)
              )
            )
         )
         ((1)
          (if (and (= *v-turtle-loadout-menu-selection* 1)
                   (not (v-turtle-mass-inverter-unlocked?)))
              (sound-play "menu-back")
              (set-v-turtle-active-loadout! *v-turtle-loadout-menu-selection*))
          )
         ((2)
          (if (and (= *v-turtle-loadout-menu-selection* 2)
                   (not (wasdoors-v-turtle-faster-boost-unlocked?)))
              (sound-play "menu-back")
              (set-v-turtle-ability-loadout!
                (case *v-turtle-loadout-menu-selection*
                  ((0) 0)
                  ((1) 2)
                  ((2) 3)
                  ((3) 6)
                  (else 7)
                  )))
          )
         ((3)
           (set-v-turtle-defense-loadout!
             (case *v-turtle-loadout-menu-selection*
               ((0) 0)
               ((1) 4)
               ((2) 5)
               (else 8)
               ))
           )
         (else
           (set! *v-turtle-tuning-confirm?* #t)
           )
         )
       )
      ((cpad-pressed? 0 triangle)
       (if (= *v-turtle-loadout-menu-page* 4)
           (begin
             (v-turtle-tuning-reset-selected!
               (v-turtle-tuning-index-at *v-turtle-tuning-category* *v-turtle-loadout-menu-selection*))
             (sound-play "menu-pick"))
           (close-v-turtle-loadout-menu))
       )
      ((cpad-pressed? 0 circle)
       (when (!= *v-turtle-loadout-menu-page* 0)
         (when (= *v-turtle-loadout-menu-page* 4)
           (set! *v-turtle-tuning-confirm?* #f)
           (v-turtle-tuning-close!))
         (set! *v-turtle-loadout-menu-selection* (- *v-turtle-loadout-menu-page* 1))
         (set! *v-turtle-loadout-menu-page* 0)
         (sound-play "menu-pick")
         )
       )
      )
    )
  (none)
  )

(defun wasdoors-update-v-turtle-loadout-trigger ()
  ;; Faster Boost Cooldown cannot remain equipped before its Course Race reward.
  (when (and (= *v-turtle-ability-loadout* 3)
             (not (wasdoors-v-turtle-faster-boost-unlocked?)))
    (set! *v-turtle-ability-loadout* 0)
    )
  (when (and (= *v-turtle-weapon-loadout* 1)
             (not (v-turtle-mass-inverter-unlocked?)))
    (set! *v-turtle-weapon-loadout* 0)
    )
  (cond
    ;; The Tough Puppy loadout system is exclusive to Hero Mode.  Keeping the
    ;; gate here also prevents the prompt from appearing in a normal save.
    ((not (logtest? (-> *game-info* secrets) (game-secrets hero-mode)))
     (when *v-turtle-loadout-menu-open?*
       (close-v-turtle-loadout-menu)
       )
     (set! *v-turtle-weapon-loadout* 0)
     (set! *v-turtle-ability-loadout* 0)
     (set! *v-turtle-defense-loadout* 0)
     )
    (*v-turtle-loadout-menu-open?*
     (wasdoors-update-v-turtle-loadout-menu)
     )
    ((and *target*
          (not (focus-test? *target* pilot-riding))
          (< (vector-vector-distance-squared
               (target-pos 0)
               *v-turtle-loadout-trigger-pos*
               )
             (square 8192.0)
             )
          )
     (let ((font (new 'stack 'font-context *font-default-matrix* 56 330 0.0
                      (font-color default)
                      (font-flags shadow kerning)
                      )))
       (set! (-> font flags) (font-flags shadow kerning middle middle-vert large))
       (set-width! font 400)
       (set-height! font 80)
       (set-scale! font 0.7)
       (format (clear *temp-string*) "Press <PAD_X> to edit loadout")
       (pc-encode-utf8-string *temp-string* *pc-encoded-temp-string*)
       (print-game-text *pc-encoded-temp-string* font #f 44 (bucket-id hud-draw-hud-alpha))
       )
     (when (cpad-pressed? 0 x)
       (open-v-turtle-loadout-menu)
       (cpad-clear! 0 x)
       )
      )
    )
  (none)
  )

(defun wasdoors-draw-v-snake-loadout-menu ()
  (let ((font (new 'stack 'font-context *font-default-matrix* 56 65 0.0
                   (font-color default)
                   (font-flags shadow kerning)
                   )))
    (set! (-> font flags) (font-flags shadow kerning large))
    (set-width! font 400)
    (set-height! font 50)
    (set-scale! font 0.48)
    (set! (-> font color) (font-color cyan))
    (format (clear *temp-string*) "Sand Shark Loadout")
    (pc-encode-utf8-string *temp-string* *pc-encoded-temp-string*)
    (print-game-text *pc-encoded-temp-string* font #f 44 (bucket-id hud-draw-hud-alpha))

    (set-scale! font 0.3)
    (wasdoors-draw-v-turtle-loadout-option-line
      font
      (case (v-snake-loadout-equipped-count)
        ((0) "Equipped: 0/2")
        ((1) "Equipped: 1/2")
        (else "Equipped: 2/2 (Full)"))
      100.0 #f #f)
    (set-scale! font 0.4)
    (wasdoors-draw-v-turtle-loadout-option-line
      font
      (if (= *v-snake-loadout-menu-selection* 0) "> None" "  None")
      130.0
      (= *v-snake-loadout-menu-selection* 0)
      (and (not *v-snake-regenerative-armor-equipped?*)
           (not *v-snake-emergency-repair-equipped?*)
           (not *v-snake-vehicle-toughness-equipped?*)
           (not *v-snake-turret-jammer-equipped?*)
           (not *v-snake-camouflage-equipped?*)
           (not *v-snake-damage-shield-equipped?*))
      )
    (wasdoors-draw-v-turtle-loadout-option-line
      font
      (if (= *v-snake-loadout-menu-selection* 1) "> Regenerative Armor" "  Regenerative Armor")
      160.0
      (= *v-snake-loadout-menu-selection* 1)
      *v-snake-regenerative-armor-equipped?*
      )
    (wasdoors-draw-v-turtle-loadout-option-line
      font
      (if (= *v-snake-loadout-menu-selection* 2) "> Emergency Repair" "  Emergency Repair")
      190.0
      (= *v-snake-loadout-menu-selection* 2)
      *v-snake-emergency-repair-equipped?*
      )
    (wasdoors-draw-v-turtle-loadout-option-line
      font
      (if (= *v-snake-loadout-menu-selection* 3) "> Vehicle Toughness" "  Vehicle Toughness")
      220.0
      (= *v-snake-loadout-menu-selection* 3)
      *v-snake-vehicle-toughness-equipped?*
      )
    (wasdoors-draw-v-turtle-loadout-option-line
      font
      (if (= *v-snake-loadout-menu-selection* 4) "> Turret Jammer" "  Turret Jammer")
      250.0
      (= *v-snake-loadout-menu-selection* 4)
      *v-snake-turret-jammer-equipped?*
      )
    (wasdoors-draw-v-turtle-loadout-option-line
      font
      (if (= *v-snake-loadout-menu-selection* 5) "> Camouflage" "  Camouflage")
      280.0
      (= *v-snake-loadout-menu-selection* 5)
      *v-snake-camouflage-equipped?*
      )
    (wasdoors-draw-v-turtle-loadout-option-line
      font
      (if (= *v-snake-loadout-menu-selection* 6) "> Damage Shield" "  Damage Shield")
      310.0
      (= *v-snake-loadout-menu-selection* 6)
      *v-snake-damage-shield-equipped?*
      )
    (set-scale! font 0.3)
    (wasdoors-draw-v-turtle-loadout-option-line
      font
      (cond
        ((or *v-snake-camouflage-equipped?* *v-snake-damage-shield-equipped?*
             *v-snake-emergency-repair-equipped?*)
         "<PAD_DPAD_UP><PAD_DPAD_DOWN> Move   <PAD_DPAD_RIGHT> Activate")
        (else "<PAD_DPAD_UP><PAD_DPAD_DOWN>  Move"))
      370.0
      #f
      #f
      )
    (wasdoors-draw-v-turtle-loadout-option-line
      font
      "<PAD_X>  Toggle     <PAD_TRIANGLE>  Exit"
      400.0
      #f
      #f
      )
    )
  (none)
  )

(defun wasdoors-update-v-snake-loadout-trigger ()
  (cond
    ((not (logtest? (-> *game-info* secrets) (game-secrets hero-mode)))
     (when *v-snake-loadout-menu-open?*
       (close-v-snake-loadout-menu)
       )
     (set-v-snake-regenerative-armor-equipped! #f)
     (set-v-snake-emergency-repair-equipped! #f)
     (set! *v-snake-vehicle-toughness-equipped?* #f)
     (set! *v-snake-turret-jammer-equipped?* #f)
     (set! *v-snake-camouflage-equipped?* #f)
     (v-snake-end-camouflage!)
     (set! *v-snake-damage-shield-equipped?* #f)
     (v-snake-end-damage-shield!)
     )
    (*v-snake-loadout-menu-open?*
     (wasdoors-draw-v-snake-loadout-menu)
     (cond
       ((cpad-pressed? 0 up down)
        (set! *v-snake-loadout-menu-selection*
              (mod (+ *v-snake-loadout-menu-selection*
                      (if (cpad-pressed? 0 up) 6 1)) 7))
        (sound-play "menu-pick")
        )
       ((cpad-pressed? 0 x)
        (v-snake-toggle-loadout! *v-snake-loadout-menu-selection*)
        (sound-play "menu-pick")
        )
       ((cpad-pressed? 0 triangle)
        (close-v-snake-loadout-menu)
        )
       )
     )
    ((and *target*
          (not (focus-test? *target* pilot-riding))
          (< (vector-vector-distance-squared
               (target-pos 0)
               *v-snake-loadout-trigger-pos*)
             (square 8192.0)))
     (let ((font (new 'stack 'font-context *font-default-matrix* 56 330 0.0
                      (font-color default)
                      (font-flags shadow kerning)
                      )))
       (set! (-> font flags) (font-flags shadow kerning middle middle-vert large))
       (set-width! font 400)
       (set-height! font 80)
       (set-scale! font 0.7)
       (format (clear *temp-string*) "Press <PAD_X> to edit loadout")
       (pc-encode-utf8-string *temp-string* *pc-encoded-temp-string*)
       (print-game-text *pc-encoded-temp-string* font #f 44 (bucket-id hud-draw-hud-alpha))
       )
     (when (cpad-pressed? 0 x)
       (open-v-snake-loadout-menu)
       (cpad-clear! 0 x)
       )
     )
    )
  (none)
  )

(defun wasdoors-point-inside? ((arg0 vector))
  (let ((gp-0 (new 'stack-no-clear 'inline-array 'vector 3)))
    (vector-copy! (-> gp-0 0) (new 'static 'vector :z -1.0 :w 957235.2))
    (vector-copy! (-> gp-0 1) (new 'static 'vector :x 9246720.0 :y 125747.2 :z 625049.6 :w 450560.0))
    (set! (-> gp-0 2 x) (vector4-dot (-> gp-0 0) arg0))
    (set! (-> gp-0 2 y) (vector-vector-distance (-> gp-0 1) arg0))
    (and (< 0.0 (-> gp-0 2 x)) (< (-> gp-0 2 y) (-> gp-0 1 w)))
    )
  )

(defun wasdoors-cleanup ((arg0 level))
  (let ((gp-0 12))
    (while (>= 19 gp-0)
      (let ((s5-0 (as-type (handle->process (-> *vehicle-info* handle-by-vehicle-type gp-0)) process-focusable)))
        (if (and s5-0 (wasdoors-point-inside? (-> (the-as process-focusable s5-0) root trans)))
            (send-event s5-0 'go-die)
            )
        )
      (+! gp-0 1)
      )
    )
  0
  (none)
  )

(deftype wasdoors-manager (process)
  ()
  (:state-methods
    idle
    )
  (:methods
    (repair-vehicles (_type_) none)
    )
  )


(defmethod repair-vehicles ((this wasdoors-manager))
  (let ((gp-0 12)
        (f30-0 (* 0.2 (seconds-per-frame)))
        )
    (while (>= 19 gp-0)
      (let ((s5-0 (as-type (handle->process (-> *vehicle-info* handle-by-vehicle-type gp-0)) process-focusable)))
        (if (and s5-0
                 (not (focus-test? (the-as process-focusable s5-0) dead))
                 (wasdoors-point-inside? (-> (the-as process-focusable s5-0) root trans))
                 )
            (send-event s5-0 'repair f30-0)
            )
        )
      (+! gp-0 1)
      )
    )
  0
  (none)
  )

(defstate idle (wasdoors-manager)
  :virtual #t
  :exit (behavior ()
    (let ((gp-0 'active)
          (a0-0 *level*)
          )
      (cond
        ((= (level-status? a0-0 'desert #f) gp-0)
         (wasdoors-cleanup (the-as level a0-0))
         )
        (else
          (dotimes (gp-1 44)
            (send-event (handle->process (-> *vehicle-info* handle-by-vehicle-type gp-1)) 'go-die)
            )
          )
        )
      )
    )
   :trans (behavior ()
     (repair-vehicles self)
     (wasdoors-update-v-turtle-loadout-trigger)
     (wasdoors-update-v-snake-loadout-trigger)
    )
  :code sleep-code
  )

(defbehavior wasdoors-manager-init-by-other wasdoors-manager ()
  ;; This manager must continue drawing and reading menu input while gameplay
  ;; processes are suspended by master mode.
  (process-mask-clear! (-> self mask) menu pause)
  (go-virtual idle)
  )

(define *wasdoors-manager* (the-as (pointer wasdoors-manager) #f))

(defun wasdoors-manager-start ()
  (set! *wasdoors-manager* (process-spawn wasdoors-manager :name "wasdoors-manager" :to *entity-pool*))
  0
  (none)
  )

;; WARN: Return type mismatch symbol vs none.
(defun wasdoors-manager-kill ()
  (close-v-turtle-loadout-menu)
  (close-v-snake-loadout-menu)
  (wasdoors-close-rock-catcher)
  (kill-by-type wasdoors-manager *active-pool*)
  (set! *wasdoors-manager* (the-as (pointer wasdoors-manager) #f))
  (none)
  )

(defun wasdoors-activate ((arg0 level))
  (wasdoors-manager-start)
  (none)
  )

(defun wasdoors-deactivate ((arg0 level))
  (wasdoors-manager-kill)
  0
  (none)
  )
