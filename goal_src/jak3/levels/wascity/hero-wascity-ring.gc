;;-*-Lisp-*-
(in-package goal)

;; A replayable Hero Mode route. Never reopen or close the saved trader unlock.
(define *hero-wascity-ring-route*
  (new 'static 'boxed-array :type vector
    (new 'static 'vector :x (meters 1785.46) :y (meters 43.50) :z (meters -319.18) :w 1.0)
    (new 'static 'vector :x (meters 1748.80) :y (meters 43.23) :z (meters -251.26) :w 1.0)
    (new 'static 'vector :x (meters 1767.69) :y (meters 69.93) :z (meters -139.40) :w 1.0)
    (new 'static 'vector :x (meters 1757.14) :y (meters 94.97) :z (meters -103.84) :w 1.0)
    (new 'static 'vector :x (meters 1743.30) :y (meters 93.77) :z (meters -187.62) :w 1.0)
    (new 'static 'vector :x (meters 1516.18) :y (meters 27.06) :z (meters -373.42) :w 1.0)
    (new 'static 'vector :x (meters 1457.27) :y (meters 27.75) :z (meters -366.24) :w 1.0)
    (new 'static 'vector :x (meters 1432.16) :y (meters 35.02) :z (meters -517.20) :w 1.0)
    (new 'static 'vector :x (meters 1451.61) :y (meters 32.26) :z (meters -534.08) :w 1.0)))
(define *hero-wascity-ring-time* (seconds 20))
(define *hero-wascity-ring-radius* (meters 6))
(define *hero-wascity-ring-actor* (the-as handle #f))
(define *hero-wascity-ring-timer-hud* (the-as handle #f))

(defun hero-wascity-ring-text ((text string) (y int) (color font-color))
  (let ((font (new 'stack 'font-context *font-default-matrix* 32 y 0.0 color
                   (font-flags shadow kerning large middle))))
    (set-width! font 448)
    (set-height! font 24)
    (set! (-> font scale) 0.65)
    (pc-encode-utf8-string text *pc-encoded-temp-string*)
    (print-game-text *pc-encoded-temp-string* font #f 44 (bucket-id hud-draw-hud-alpha)))
  (none))

(defbehavior hero-wascity-ring-init desert-chase-ring ((owner process) (pos vector) (next vector) (final? symbol))
  ;; Runtime rings have no entity-provided optional turbo actor. Raw zero is
  ;; truthy in GOAL, so initialize these fields before the native idle entry.
  (set! (-> self alt-actor) #f)
  (set! (-> self turbo-handle) (the-as handle #f))
  (set! (-> self minimap) (the-as connection-minimap #f))
  ;; The native ring normally selects the texture from its LBBRING level.
  ;; This route packages the same atlas in WASALL instead.
  (let ((texture (the-as float (lookup-level-texture-id-by-name "racegate" (level-get *level* 'wasall) 7))))
    (set! (-> *part-id-table* 5143 init-specs 0 initial-valuef) texture)
    (set! (-> *part-id-table* 5146 init-specs 0 initial-valuef) texture)
    (set! (-> *part-id-table* 5153 init-specs 0 initial-valuef) texture)
    (set! (-> *part-id-table* 5154 init-specs 0 initial-valuef) texture))
  (alloc-trsqv! self)
  (vector-copy! (-> self root trans) pos)
  (quaternion-identity! (-> self root quat))
  ;; Face the approach direction using the native ring's quaternion hit plane.
  (let ((direction (vector-! (new 'stack-no-clear 'vector) next pos)))
    (when (> (vector-length direction) 0.0)
      (quaternion-axis-angle! (-> self root quat) 0.0 1.0 0.0 (atan (-> direction x) (-> direction z)))))
  (quaternion->matrix (-> self mat) (-> self root quat))
  (vector-copy! (-> self mat trans) pos)
  (set! (-> self ring-radius) *hero-wascity-ring-radius*)
  (set! (-> self taskman) (process->handle owner))
  (set! (-> self is-final?) final?)
  (set! (-> self part) (create-launch-control group-desert-ring self))
  (set! (-> self part-final) (create-launch-control group-desert-ring-final self))
  (go-virtual idle))

(deftype hero-wascity-ring-manager (process)
  ((ring-index int32)
   (running? symbol)
   (result int32)
   (ring-time time-frame)
   (visual-time time-frame)
   (previous-pos vector :inline)
   (intro sound-id))
  (:state-methods idle))

(defmethod deactivate ((this hero-wascity-ring-manager))
  (when (nonzero? (-> this intro))
    (set-action! *gui-control* (gui-action stop) (-> this intro) (gui-channel none)
                 (gui-action none) (the-as string #f)
                 (the-as (function gui-connection symbol) #f) (the-as process #f)))
  (let ((ring (handle->process *hero-wascity-ring-actor*))
        (hud (handle->process *hero-wascity-ring-timer-hud*)))
    (when ring
      (kill-callback (-> *minimap* engine) (-> (the-as desert-chase-ring ring) minimap))
      (deactivate ring))
    (when hud (send-event hud 'hide-and-die)))
  (remove-setting! 'extra-bank)
  ((method-of-type process deactivate) this)
  (none))

(defstate idle (hero-wascity-ring-manager)
  :virtual #t
  :event (behavior ((proc process) (argc int) (message symbol) (block event-message-block))
    (when (and (= message 'ring-hit) (-> self running?)
               (= proc (handle->process *hero-wascity-ring-actor*)))
      (set! *hero-wascity-ring-actor* (the-as handle #f))
      (+! (-> self ring-index) 1)
      (set-time! (-> self ring-time))
      (when (= (-> self ring-index) (-> *hero-wascity-ring-route* length))
        (set! (-> self result) 1)
        (set! (-> self running?) #f))))
  :trans (behavior ()
    (cond
      ((or (not *target*)
           (not (logtest? (-> *game-info* secrets) (game-secrets hero-mode)))
           (!= (level-status? *level* 'waswide #f) 'active))
       (deactivate self))
      ((and (-> self running?)
            (or (focus-test? *target* dead)
                (nonzero? (-> *game-info* task-node-exclusive length))
                (time-elapsed? (-> self ring-time) *hero-wascity-ring-time*)))
       (set! (-> self result) -1)
       (set! (-> self running?) #f))))
  :post (behavior ()
    (when (and (-> self running?) (= *master-mode* 'game))
      (set! (-> *game-info* timer)
            (max 0 (- *hero-wascity-ring-time* (- (current-time) (-> self ring-time)))))
      (set! (-> *game-info* timer-flash) (< (-> *game-info* timer) (seconds 10)))
      (format (clear *temp-string*) "RING ~D/~D"
              (+ (-> self ring-index) 1) (-> *hero-wascity-ring-route* length))
      (hero-wascity-ring-text *temp-string* 85 (font-color cyan))))
  :code (behavior ()
    ;; Ring introductions are BBush GUI speech, not scene-player cinematics.
    ;; Use the same channel as the original Burning Bush introduction.
    (set! (-> self intro)
          (add-process *gui-control* self (gui-channel bbush) (gui-action play) "o-bb11i" -99.0 0))
    (set-time! (-> self ring-time))
    (while (and (nonzero? (get-status *gui-control* (-> self intro)))
                (not (time-elapsed? (-> self ring-time) (seconds 60)))) (suspend))
    (set-time! (-> self ring-time))
    (set! *hero-wascity-ring-timer-hud*
          (process->handle (process-spawn hud-timer :init hud-init-by-other :name "hud-timer" :to *target*)))
    (set! (-> self running?) #t)
    (while (-> self running?)
      (unless (handle->process *hero-wascity-ring-actor*)
        (let* ((index (-> self ring-index))
               (final? (= (+ index 1) (-> *hero-wascity-ring-route* length)))
               (pos (-> *hero-wascity-ring-route* index))
               (next (if final? (target-pos 0) (-> *hero-wascity-ring-route* (+ index 1)))))
          (set! *hero-wascity-ring-actor*
                (process->handle (process-spawn desert-chase-ring :init hero-wascity-ring-init
                  :name "hero-wascity-route-ring" :to self self pos next final?)))))
      (suspend))
    (let ((hud (handle->process *hero-wascity-ring-timer-hud*)))
      (when hud (send-event hud 'hide-and-die)))
    (let ((ring (handle->process *hero-wascity-ring-actor*)))
      (when ring (send-event ring 'fail))
      (set! *hero-wascity-ring-actor* (the-as handle #f)))
    ;; Keep the speech bank until the native GUI connection actually finishes.
    (let ((voice (talker-spawn-func
                  (string->talker-speech (if (= (-> self result) 1) "o-bb11w" "o-bb11f"))
                  *entity-pool* (target-pos 0) (the-as region #f))))
      (while (and (nonzero? voice) (nonzero? (get-status *gui-control* voice)))
        (suspend)))
    (deactivate self)))

(defbehavior hero-wascity-ring-manager-init-by-other hero-wascity-ring-manager ()
  (set! (-> self ring-index) 0)
  (set! (-> self result) 0)
  (set! (-> self running?) #f)
  (set! (-> self intro) (the-as sound-id 0))
  (set! *hero-wascity-ring-actor* (the-as handle #f))
  (set! *hero-wascity-ring-timer-hud* (the-as handle #f))
  (set! (-> self visual-time) (the-as time-frame 0))
  (vector-zero! (-> self previous-pos))
  (add-setting! 'extra-bank '((wascity3 bbush1)) 0.0 0)
  (go-virtual idle))

(defun hero-wascity-ring-offer! ((bush process-focusable))
  (when (and *target* (= *master-mode* 'game) (not *popup-menu-open*)
             (zero? (-> *game-info* task-node-exclusive length))
             (logtest? (-> *game-info* secrets) (game-secrets hero-mode))
             (task-node-closed? (game-task-node wascity-bbush-get-to-23-resolution))
             (not (process-by-name "hero-wascity-ring" *active-pool*))
             (des-burning-bush-method-34 (the-as des-burning-bush bush))
             (can-display-query? bush "bbush-ring" -99.0))
    (hero-wascity-ring-text "Press <PAD_TRIANGLE> to Start Ring Challenge" 300 (font-color white))
    (when (cpad-pressed? 0 triangle)
      (logclear! (-> *cpad-list* cpads 0 button0-abs 0) (pad-buttons triangle))
      (logclear! (-> *cpad-list* cpads 0 button0-rel 0) (pad-buttons triangle))
      (process-spawn hero-wascity-ring-manager :init hero-wascity-ring-manager-init-by-other
                     :name "hero-wascity-ring" :to *entity-pool*)))
  (none))
