           (let ((orb-handle (the-as handle (-> block param 0)))
                 (local-index (the-as int (-> block param 1)))
                 )
             (if (volcano-world-orb-collected? local-index)
                 (deactivate (handle->process orb-handle))
                 (set! (-> self orbs local-index) orb-handle)
                 )
             )
           )
          (('notify)
           (when (= (-> block param 0) 'pickup)
             (dotimes (local-index volcano-world-orb-count)
               (when (= proc (handle->process (-> self orbs local-index)))
                 (mark-volcano-world-orb-collected! local-index)
                 )
               )
             )
           )
          )
        )
      :code sleep-code
      )

    (defbehavior volcano-world-orb-manager-init-by-other volcano-world-orb-manager ()
      (go-virtual active)
      )

    (define *volcano-world-orb-manager* (the-as (pointer volcano-world-orb-manager) #f))

    (defun update-volcano-world-orbs! ()
      (if (= (level-status? *level* 'volcanox #f) 'active)
          (when (not *volcano-world-orb-manager*)
            (set! *volcano-world-orb-manager*
                  (process-spawn
                    volcano-world-orb-manager
                    :init volcano-world-orb-manager-init-by-other
                    :name "volcano-world-orb-manager"
                    :to *active-pool*
                    )
                  )
            )
          (when *volcano-world-orb-manager*
            (kill-by-type volcano-world-orb-manager *active-pool*)
            (set! *volcano-world-orb-manager* (the-as (pointer volcano-world-orb-manager) #f))
            )
          )
      (none)
      )

    ;; Persistent free-roam orbs placed in Haven Forest. These use their own
    ;; save mask and are present whenever either Forest section is active.
    (defun forest-world-orb-collected? ((index int))
      (logtest? (-> *game-info* custom-orbs-mask-3) (the-as uint64 (ash 1 index)))
      )

    (defun mark-forest-world-orb-collected! ((index int))
      (logior! (-> *game-info* custom-orbs-mask-3) (the-as uint64 (ash 1 index)))
      (none)
      )

    (deftype forest-world-orb-manager (process)
      ((orbs handle 21))
      (:state-methods active)
      )

    (defstate active (forest-world-orb-manager)
      :virtual #t
      :enter (behavior ()
        (dotimes (index forest-world-orb-count)
          (set! (-> self orbs index) (the-as handle #f))
          )
        (clear-spawn-skill-meters-owner!)
        (set-spawn-skill-meters-owner! self)
        (spawn-skill-meters -493.1600 45.7799 918.4645 1.0 #t)
        (spawn-skill-meters -643.8310 22.5627 918.8386 1.0 #t)
        (spawn-skill-meters -606.3533 45.2737 910.7897 1.0 #t)
        (spawn-skill-meters -872.4736 24.2318 914.5801 1.0 #t)
        (spawn-skill-meters -715.4612 34.6727 1134.0947 1.0 #t)
        (spawn-skill-meters -667.9100 45.9819 1073.3837 1.0 #t)
        (spawn-skill-meters -688.9154 54.0671 1017.6752 1.0 #t)
        (spawn-skill-meters -880.4213 50.4360 996.0784 1.0 #t)
        (spawn-skill-meters -848.0971 33.3619 1014.1878 1.0 #t)
        (spawn-skill-meters -868.7611 45.3016 1072.9954 1.0 #t)
        (spawn-skill-meters -637.5035 44.6111 1133.6593 1.0 #t)
        (spawn-skill-meters -834.5504 50.8742 1190.9031 1.0 #t)
        (spawn-skill-meters -829.6187 50.2586 1261.2099 1.0 #t)
        (spawn-skill-meters -689.9815 40.5162 1264.8319 1.0 #t)
        (spawn-skill-meters -591.1799 28.5843 1197.3463 1.0 #t)
        (spawn-skill-meters -595.2537 37.5263 1239.9418 1.0 #t)
        (spawn-skill-meters -506.8360 17.5897 1175.6007 1.0 #t)
        (spawn-skill-meters -567.9719 45.9654 1128.1896 1.0 #t)
        (spawn-skill-meters -509.4879 41.2501 1147.3031 1.0 #t)
        (spawn-skill-meters -509.8911 45.9390 1079.6945 1.0 #t)
        (spawn-skill-meters -536.0919 15.3197 1037.9998 1.0 #t)
        (clear-spawn-skill-meters-owner!)
        )
      :event (behavior ((proc process) (argc int) (message symbol) (block event-message-block))
        (case message
          (('register-custom-orb)
           (let ((orb-handle (the-as handle (-> block param 0)))
                 (local-index (the-as int (-> block param 1)))
                 )
             (if (forest-world-orb-collected? local-index)
                 (deactivate (handle->process orb-handle))
                 (set! (-> self orbs local-index) orb-handle)
                 )
             )
           )
          (('notify)
           (when (= (-> block param 0) 'pickup)
             (dotimes (local-index forest-world-orb-count)
               (when (= proc (handle->process (-> self orbs local-index)))
                 (mark-forest-world-orb-collected! local-index)
                 )
               )
             )
           )
          )
        )
      :code sleep-code
      )

    (defbehavior forest-world-orb-manager-init-by-other forest-world-orb-manager ()
      (go-virtual active)
      )

    (define *forest-world-orb-manager* (the-as (pointer forest-world-orb-manager) #f))

    (defun update-forest-world-orbs! ()
      (if (or (= (level-status? *level* 'foresta #f) 'active)
              (= (level-status? *level* 'forestb #f) 'active)
              )
          (when (not *forest-world-orb-manager*)
            (set! *forest-world-orb-manager*
                  (process-spawn
                    forest-world-orb-manager
                    :init forest-world-orb-manager-init-by-other
                    :name "forest-world-orb-manager"
                    :to *active-pool*
                    )
                  )
            )
          (when *forest-world-orb-manager*
            (kill-by-type forest-world-orb-manager *active-pool*)
            (set! *forest-world-orb-manager* (the-as (pointer forest-world-orb-manager) #f))
            )
          )
      (none)
      )

    (defun desert-custom-orbs-player-in-garage? ()
      ;; Use the same interior volume as wasdoors-point-inside?. The desert and
      ;; garage can remain loaded together, so level activation alone does not
      ;; reliably tell us that Jak crossed into the garage.
      (and *target*
           (let ((garage-plane (new 'static 'vector :z -1.0 :w 957235.2))
                 (garage-center (new 'static 'vector :x 9246720.0 :y 125747.2 :z 625049.6 :w 450560.0))
                 )
             (and (< 0.0 (vector4-dot garage-plane (target-pos 0)))
                  (< (vector-vector-distance garage-center (target-pos 0)) (-> garage-center w))
                  )
             )
           )
      )

    (defun runs-every-frame ()
      ;; (increase-power-cell-by-one) This is a call to increase-power-cell-by-one defined in mod-common-functions.gc

      (update-temple-climb-world-orbs!)
      (update-volcano-world-orbs!)
      (update-forest-world-orbs!)

      ;; This guard must live outside the desert mission manager because that
      ;; manager unloads during a garage or transport transition. Reopening the
      ;; introduction cancels the current attempt without restoring collected
      ;; custom orbs, and allows a fresh attempt when the player returns.
      (when (and (task-node-closed? (game-task-node desert-bbush-custom-orbs-introduction))
                 (not (task-node-closed? (game-task-node desert-bbush-custom-orbs-resolution)))
                 (or (desert-custom-orbs-player-in-garage?)
                     (and *target* (focus-test? *target* teleporting))
                     )
                 )
        (task-node-open! (game-task-node desert-bbush-custom-orbs-introduction) 'event)
        )

      ;; Sample code to turn jak pink whenever he's doing the jetboard hover glitch
      ;; (when *target* 
      ;;   (if (board-hovering?)
      ;;     (draw-pink *target*)
      ;;     (draw-normal *target*)
      ;;     )
      ;;   )

      (if *show-input-display* 
        (input-display-on)
        (input-display-off)
        )

      (when *debug-segment*
        (orb-placer-maintenance)
        )

      (none)
      )

    (defun runs-on-gem-pickup ()
      ;; Code here runs on any scout fly pickup

      (none)
      )

    (defun runs-on-task-close ()
    

      (none)
      )

    (defun runs-on-eco-pickup ((eco-type pickup-type) (parent process-tree))
      (let* ((from-vent? #f))
        ;; Code here runs as soon as you pickup ANY eco

        (case eco-type
          (((pickup-type eco-yellow))      
            ;; Code here runs as soon as you pickup yellow eco

            )
          (((pickup-type eco-red))      
            ;; Code here runs as soon as you pickup red eco

            )
          (((pickup-type eco-blue))      
            ;; Code here runs as soon as you pickup blue eco

            )

          (((pickup-type eco-green))      
            ;; Code here runs as soon as you pickup big green eco 

            )
          )
        
        (when from-vent?
          ;; Code here runs only if the eco was picked up from a vent

          )
        )

      (none)
      )

    (defun runs-on-jak-spawn ()
      ;; Code here runs every time jak spawns (loading a file new game or death)   

      (none)
      )

    (defun runs-on-jak-death ((death-event symbol))
      (case death-event
        (('dying)
          ;; Code here runs immediately every time jak dies, before any death animation or death cutscene
          
          )
        (('blackout)
          ;; Code here runs after jak dies (and any death cutscene finishes), during the blackout before he spawns

          )
        )
      
      (none)
      )


