    ;;-*-Lisp-*-
    (in-package goal)

    ;; name: mod-custom-code.gc
    ;; name in dgo: mod-custom-code
    ;; dgos: TODO


    ;;;;;;;;;;;;;;;;;;;;;;;;;;
    ;; What is this file for.
    ;;;;;;;;;;;;;;;;;;;;;;;;;;

    #| This file contains function defenitions that are pre placed in the mod base,
    so if you place custom code inside of these functions, it will exectue based on
    the name of the function, for example, if you place (set! (-> *game-info* fuel) (+ (-> *game-info* fuel) 1))
    to the function named runs-on-orb-pickup, then jaks powercell count will increase each time you collect
    an orb |#


    ;;;;;;;;;;;;;;;;;;;;;;;;;;
    ;; Begin function defintions.
    ;;;;;;;;;;;;;;;;;;;;;;;;;;

    ;; Printed Precursor Orb locations for the custom Burning Bush 6 mission.
    ;; The 22 pickups at the temple climb are normal free-roam pickups instead.
    (defconstant desert-custom-orb-mission-count 99)
    (defconstant temple-climb-world-orb-first-index 83)
    (defconstant temple-climb-world-orb-count 22)
    (defconstant volcano-world-orb-count 51)
    (defconstant forest-world-orb-count 21)
    (defconstant mine-world-orb-count 57)

    ;; Persistent Hero Mode Mine pickups. These use a dedicated save mask so
    ;; they do not overlap the existing Desert, Volcano, Forest, or Temple sets.
    (defun mine-world-orb-collected? ((index int))
      (logtest? (-> *game-info* mine-world-orbs-mask) (the-as uint64 (ash 1 index)))
      )

    (defun mark-mine-world-orb-collected! ((index int))
      (logior! (-> *game-info* mine-world-orbs-mask) (the-as uint64 (ash 1 index)))
      (none)
      )

    (deftype mine-world-orb-manager (process)
      ((orbs handle 57))
      (:state-methods active)
      )

