    ;;-*-Lisp-*-
    (in-package goal)

    ;; name: mod-custom-code.gc
    ;; name in dgo: mod-custom-code
    ;; dgos: TODO


    ;;;;;;;;;;;;;;;;;;;;;;;;;;
    ;; What is this file for.
    ;;;;;;;;;;;;;;;;;;;;;;;;;;

    #| This file contains function defenitions that are pre placed in the mod base,
    so if you place custom code inside of these functions, it will exectue based on
    the name of the function, for example, if you place (set! (-> *game-info* fuel) (+ (-> *game-info* fuel) 1))
    to the function named runs-on-orb-pickup, then jaks powercell count will increase each time you collect
    an orb |#


    ;;;;;;;;;;;;;;;;;;;;;;;;;;
    ;; Begin function defintions.
    ;;;;;;;;;;;;;;;;;;;;;;;;;;

    ;; Printed Precursor Orb locations for the custom Burning Bush 6 mission.
    ;; These pickups are owned by the mission manager and do not exist outside it.
    (deftype task-manager-desert-custom-orbs (task-manager)
      ((orbs      handle 121)
       (spawned   int)
       (collected int)
       )
      (:methods
        (clear-custom-orbs! (_type_) none)
        )
      )

    (defmethod clear-custom-orbs! ((this task-manager-desert-custom-orbs))
      (dotimes (i (-> this spawned))
        (let ((proc (handle->process (-> this orbs i))))
          (when proc
            (deactivate proc)
            )
          )
        (set! (-> this orbs i) (the-as handle #f))
        )
      (set! (-> this spawned) 0)
      (clear-spawn-skill-meters-owner!)
      (none)
      )

    (defmethod set-time-limit ((this task-manager-desert-custom-orbs))
      (let ((parent-set-time-limit (method-of-type task-manager set-time-limit)))
        (parent-set-time-limit this)
        )
      (clear-custom-orbs! this)
      (none)
      )

