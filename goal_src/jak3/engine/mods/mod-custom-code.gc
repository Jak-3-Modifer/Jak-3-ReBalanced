    ;; Hero Mode-only Temple pickups. Keep these save-bit assignments fixed:
    ;; local indices 0..42 use mask 3 bits 21..63 (after the Forest's 21 orbs),
    ;; and indices 43..46 use mask 2 bits 51..54 (after the Volcano's 51 orbs).
    ;; Existing orb IDs and the timed Desert Orb Hunt remain unchanged.
    (defconstant hero-temple-world-orb-count 47)

    (defun hero-temple-world-orb-collected? ((index int))
      (if (< index 43)
          (logtest? (-> *game-info* custom-orbs-mask-3)
                    (the-as uint64 (ash 1 (+ index 21))))
          (logtest? (-> *game-info* custom-orbs-mask-2)
                    (the-as uint64 (ash 1 (+ (- index 43) 51))))
          )
      )

    (defun mark-hero-temple-world-orb-collected! ((index int))
      (if (< index 43)
          (logior! (-> *game-info* custom-orbs-mask-3)
                   (the-as uint64 (ash 1 (+ index 21))))
          (logior! (-> *game-info* custom-orbs-mask-2)
                   (the-as uint64 (ash 1 (+ (- index 43) 51))))
          )
      (none)
      )

