        (spawn-skill-meters 4130.6030 61.6262 4667.1826 1.0 #t)
        (spawn-skill-meters 4172.7695 56.3358 4668.3544 1.0 #t)
        (spawn-skill-meters 4177.8247 54.0381 4695.9946 1.0 #t)
        (spawn-skill-meters 4106.3525 60.4693 4499.8994 1.0 #t)
        (spawn-skill-meters 4146.0092 45.8155 4505.0566 1.0 #t)
        (spawn-skill-meters 4146.8486 44.8789 4438.6967 1.0 #t)
        (spawn-skill-meters 4117.5776 44.5470 4396.6464 1.0 #t)
        (spawn-skill-meters 4098.1586 58.1430 4313.9296 1.0 #t)
        (clear-spawn-skill-meters-owner!)
        )
      :event (behavior ((proc process) (argc int) (message symbol) (block event-message-block))
        (case message
          (('register-custom-orb)
           (let ((orb-handle (the-as handle (-> block param 0)))
                 (local-index (the-as int (-> block param 1)))
                 )
             (when (and (>= local-index 0) (< local-index hero-temple-world-orb-count))
               (if (hero-temple-world-orb-collected? local-index)
                   (deactivate (handle->process orb-handle))
                   (set! (-> self orbs local-index) orb-handle)
                   )
               )
             )
           )
          (('notify)
           (when (= (-> block param 0) 'pickup)
             (dotimes (local-index hero-temple-world-orb-count)
               (when (= proc (handle->process (-> self orbs local-index)))
                 (mark-hero-temple-world-orb-collected! local-index)
                 )
               )
             )
           )
          )
        )
      :code sleep-code
      )

    (defbehavior hero-temple-world-orb-manager-init-by-other hero-temple-world-orb-manager ()
      (go-virtual active)
      )

    (define *hero-temple-world-orb-manager* (the-as (pointer hero-temple-world-orb-manager) #f))

    (defun update-hero-temple-world-orbs! ()
      (if (and (logtest? (-> *game-info* secrets) (game-secrets hero-mode))
               (or (= (level-status? *level* 'templex #f) 'active)
                   (= (level-status? *level* 'templea #f) 'active))
               )
          (when (not *hero-temple-world-orb-manager*)
            (set! *hero-temple-world-orb-manager*
                  (process-spawn
                    hero-temple-world-orb-manager
                    :init hero-temple-world-orb-manager-init-by-other
                    :name "hero-temple-world-orb-manager"
                    :to *active-pool*
                    )
                  )
            )
          (when *hero-temple-world-orb-manager*
            (kill-by-type hero-temple-world-orb-manager *active-pool*)
            (set! *hero-temple-world-orb-manager* (the-as (pointer hero-temple-world-orb-manager) #f))
            )
          )
      (none)
      )


    (defun desert-custom-orbs-player-in-garage? ()
      ;; Use the same interior volume as wasdoors-point-inside?. The desert and
      ;; garage can remain loaded together, so level activation alone does not
      ;; reliably tell us that Jak crossed into the garage.
      (and *target*
           (let ((garage-plane (new 'static 'vector :z -1.0 :w 957235.2))
                 (garage-center (new 'static 'vector :x 9246720.0 :y 125747.2 :z 625049.6 :w 450560.0))
                 )
             (and (< 0.0 (vector4-dot garage-plane (target-pos 0)))
                  (< (vector-vector-distance garage-center (target-pos 0)) (-> garage-center w))
                  )
             )
           )
      )

    (define-extern desert-unlocked-flut-manager-activate (function level none))

    (define *desert-artifact-hud-remaining* 0.0)

    (defun hero-artifact-gameplay-level ()
      ;; runs-every-frame executes between loader steps. Never search streamed
      ;; BSP geometry or bank carried loot while a level transition is in flight.
      (let ((inside (the-as level #f)))
        (when (and *target* *level* *load-state*
                   (logtest? (-> *game-info* secrets) (game-secrets hero-mode))
                   (not (load-in-progress? *level*))
                   (-> *load-state* vis-nick)
                   (not (focus-test? *target* dead teleporting)))
          (set! inside (level-get *level* (-> *load-state* vis-nick)))
          (when (and inside (!= (-> inside status) 'active))
            (set! inside (the-as level #f))))
        inside))

    (defun draw-desert-artifact-stash! ()
      ;; Screen-space coordinates stay inside the 512-wide 4:3 safe area.
      ;; Read carried loot only; this display never modifies either inventory.
      (let ((inside (hero-artifact-gameplay-level)))
        (cond
          ((not (and *target* inside
                     (logtest? (-> *game-info* secrets) (game-secrets hero-mode))
                     (= (-> inside info taskname) 'desert)
                     ;; The Hover resolution node is open throughout the hunt.
                     ;; Clear any active popup and ignore L3 until it ends.
                     (not (task-node-open? (game-task-node desert-hover-resolution)))
                     (not (focus-test? *target* dead teleporting))))
           (set! *desert-artifact-hud-remaining* 0.0))
          ((and *display* (not (paused?)) (not (movie?)))
           (when (cpad-pressed? 0 l3)
             (set! *desert-artifact-hud-remaining* 5.0))
           (when (> *desert-artifact-hud-remaining* 0.0)
             (with-dma-buffer-add-bucket ((buf (-> *display* frames (-> *display* on-screen) global-buf))
                                          (bucket-id hud-draw-hud-alpha))
               (dotimes (tier 3)
                 (let ((color (new 'static 'rgba :a 128)))
                   (case tier
                     ((0) (set! (-> color r) 64) (set! (-> color g) 144) (set! (-> color b) 255))
                     ((1) (set! (-> color r) 170) (set! (-> color g) 64) (set! (-> color b) 240))
                     ((2) (set! (-> color r) 255) (set! (-> color g) 200) (set! (-> color b) 48)))
                   (draw-sprite2d-xy buf 414 (+ 198 (* tier 23)) 12 12 color #x3fffff))))
             (let ((font (new 'stack 'font-context *font-default-matrix* 414 180 0.0
                              (font-color default) (font-flags shadow kerning large))))
               (set-width! font 70)
               (set-height! font 20)
               (set-scale! font 0.3)
               (print-game-text "Desert Loot" font #f 44 (bucket-id hud-draw-hud-alpha)))
             (dotimes (tier 3)
               (let ((font (new 'stack 'font-context *font-default-matrix* 436 (+ 197 (* tier 23)) 0.0
                                (font-color default) (font-flags shadow kerning large))))
                 (set-width! font 48)
                 (set-height! font 20)
                 (set-scale! font 0.45)
                 (format (clear *temp-string*) "~D" (-> *game-info* hero-artifacts-pending tier))
                 (print-game-text *temp-string* font #f 44 (bucket-id hud-draw-hud-alpha))))
             (set! *desert-artifact-hud-remaining*
                   (fmax 0.0 (- *desert-artifact-hud-remaining* (seconds-per-frame))))))))
      (none))

    (defun draw-death-counter! ()
      (when (and *display*
                 *target*
                 (logtest? (-> *game-info* secrets) (game-secrets statistics))
                 (not (focus-test? *target* gun))
                 (not (paused?))
                 (not (movie?)))
        (let ((font (new 'stack 'font-context *font-default-matrix* 500 18 0.0
                         (font-color default) (font-flags shadow kerning right large))))
          (set-width! font 150)
          (set-height! font 28)
          (set-scale! font 0.45)
          (format (clear *temp-string*) "Deaths: ~D" (-> *game-info* total-deaths))
          (print-game-text *temp-string* font #f 44 (bucket-id hud-draw-hud-alpha)))
        )
      (none))

    (defun runs-every-frame ()
      ;; Full armor is standard in Hero Mode, including existing saves. The
      ;; normal target update supplies its four +2 HP bonuses and model pieces.
      (when (logtest? (-> *game-info* secrets) (game-secrets hero-mode))
        (logior! (-> *game-info* features) (game-feature armor0 armor1 armor2 armor3)))
      (draw-desert-artifact-stash!)
      (draw-death-counter!)
      ;; Bank only after Jak actually enters a safe area, never from preloading.
      (let ((inside (hero-artifact-gameplay-level)))
        (when inside
          (when (and inside
                     (or (= (-> inside info taskname) 'wascity)
                         (= (-> inside name) 'ctyport)
                         (= (-> inside name) 'templex)))
            (dotimes (tier 3)
              (when (> (-> *game-info* hero-artifacts-pending tier) 0)
                (+! (-> *game-info* hero-artifacts tier)
                    (-> *game-info* hero-artifacts-pending tier))
                (set! (-> *game-info* hero-artifacts-pending tier) 0))))))
      ;; Wait until DST is fully active before calling its level-local code.
      ;; The manager's handle guard prevents duplicate mounts/managers.
      (let ((desert-level (level-get *level* 'desert)))
        (when (and desert-level (= (-> desert-level status) 'active) *target*
                   (not (-> *level* loading-level)))
          (desert-unlocked-flut-manager-activate desert-level)))
      ;; (increase-power-cell-by-one) This is a call to increase-power-cell-by-one defined in mod-common-functions.gc

      (update-temple-climb-world-orbs!)
      (update-volcano-world-orbs!)
      (update-forest-world-orbs!)
      (update-mine-world-orbs!)
      (update-hero-temple-world-orbs!)

      ;; This guard must live outside the desert mission manager because that
      ;; manager unloads during a garage or transport transition. Reopening the
      ;; introduction cancels the current attempt without restoring collected
      ;; custom orbs, and allows a fresh attempt when the player returns.
      (when (and (task-node-closed? (game-task-node desert-bbush-custom-orbs-introduction))
                 (not (task-node-closed? (game-task-node desert-bbush-custom-orbs-resolution)))
                 (or (desert-custom-orbs-player-in-garage?)
                     (and *target* (focus-test? *target* teleporting))
                     )
                 )
        (task-node-open! (game-task-node desert-bbush-custom-orbs-introduction) 'event)
        )

      ;; Sample code to turn jak pink whenever he's doing the jetboard hover glitch
      ;; (when *target* 
      ;;   (if (board-hovering?)
      ;;     (draw-pink *target*)
      ;;     (draw-normal *target*)
      ;;     )
      ;;   )

      (if *show-input-display* 
        (input-display-on)
        (input-display-off)
        )

      (when *debug-segment*
        (orb-placer-maintenance)
        )

      (none)
      )

