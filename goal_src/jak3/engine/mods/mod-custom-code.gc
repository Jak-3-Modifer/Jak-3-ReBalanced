      :event (behavior ((proc process) (argc int) (message symbol) (block event-message-block))
        (case message
          (('register-custom-orb)
           (let ((orb-handle (the-as handle (-> block param 0)))
                 (local-index (the-as int (-> block param 1))))
             (if (mine-world-orb-collected? local-index)
                 (deactivate (handle->process orb-handle))
                 (set! (-> self orbs local-index) orb-handle))))
          (('notify)
           (when (= (-> block param 0) 'pickup)
             (dotimes (local-index mine-world-orb-count)
               (when (= proc (handle->process (-> self orbs local-index)))
                 (mark-mine-world-orb-collected! local-index)))))
          )
        )
      :code sleep-code
      )

    (defbehavior mine-world-orb-manager-init-by-other mine-world-orb-manager ()
      (go-virtual active)
      )

    (define *mine-world-orb-manager* (the-as (pointer mine-world-orb-manager) #f))

    (defun update-mine-world-orbs! ()
      (if (and (logtest? (-> *game-info* secrets) (game-secrets hero-mode))
               (= (level-status? *level* 'mine #f) 'active))
          (when (not *mine-world-orb-manager*)
            (set! *mine-world-orb-manager*
                  (process-spawn mine-world-orb-manager
                    :init mine-world-orb-manager-init-by-other
                    :name "mine-world-orb-manager"
                    :to *active-pool*)))
          (when *mine-world-orb-manager*
            (kill-by-type mine-world-orb-manager *active-pool*)
            (set! *mine-world-orb-manager* (the-as (pointer mine-world-orb-manager) #f))))
      (none)
      )

    (deftype hud-desert-custom-orbs (hud)
      ()
      )

    (defmethod draw ((this hud-desert-custom-orbs))
      (set-hud-piece-position!
        (the-as hud-sprite (-> this icons 0 pos))
        (the int (+ 462.0 (* 130.0 (-> this offset))))
        145
        )
      (set-as-offset-from! (-> this sprites 0) (-> this icons 0 pos) -20 -39)
      (set! (-> this sprites 0 scale-x) 0.62)
      ;; Keep the counter compact inside the 4:3 HUD safe area.
      (format (clear (-> this strings 0 text)) "~D out of 99" (-> this values 0 current))
      (set-as-offset-from! (the-as hud-sprite (-> this strings 0 pos)) (-> this icons 0 pos) -24 -5)
      (when (not (paused?))
        (let ((spin (new 'stack-no-clear 'quaternion)))
          (quaternion-axis-angle! spin 0.0 1.0 0.0 (* DISPLAY_FPS_RATIO 364.0889))
          (quaternion*! (-> this icons 0 icon 0 root quat) spin (-> this icons 0 icon 0 root quat))
          )
        )
      ((method-of-type hud draw) this)
      (none)
      )

    (defmethod update-values! ((this hud-desert-custom-orbs))
      (set! (-> this values 0 target) (the int (-> *game-info* counter)))
      ((method-of-type hud update-values!) this)
      (none)
      )

    (defmethod init-callback ((this hud-desert-custom-orbs))
      (set! (-> this gui-id)
            (add-process *gui-control* this (gui-channel hud-center-right) (gui-action hidden) (-> this name) 81920.0 0)
            )
      (logior! (-> this flags) (hud-flags show))
      (hud-create-icon this 0 (the-as int (art-group-get-by-name *level* "skel-skill" (the-as (pointer level) #f))))
      (set! (-> this icons 0 scale-x) 0.009)
      (set! (-> this icons 0 scale-y) -0.018)
      (set! (-> this sprites 0 tid) (the-as texture-id (get-texture hud-egg-glow level-default-minimap)))
      (set! (-> this sprites 0 scale-x) 0.62)
      (set! (-> this sprites 0 scale-y) 1.34)
      (set! (-> this sprites 0 pos z) #xfff9ff)
      (alloc-string-if-needed this 0)
      (set! (-> this strings 0 flags) (font-flags kerning right large))
      (set! (-> this strings 0 scale) 0.5)
      (logior! (-> this values 0 flags) 9)
      (set! (-> this values 0 inc-time) (the-as uint 15))
      (set! (-> this values 0 inc-unit) (the-as uint 1))
      (none)
      )

    (defun desert-custom-orb-collected? ((index int))
      (if (< index 64)
          (logtest? (-> *game-info* custom-orbs-mask-0) (the-as uint64 (ash 1 index)))
          (logtest? (-> *game-info* custom-orbs-mask-1) (the-as uint64 (ash 1 (- index 64))))
          )
      )

    (defun mark-desert-custom-orb-collected! ((index int))
      (if (< index 64)
          (logior! (-> *game-info* custom-orbs-mask-0) (the-as uint64 (ash 1 index)))
          (logior! (-> *game-info* custom-orbs-mask-1) (the-as uint64 (ash 1 (- index 64))))
          )
      (none)
      )

    (defun desert-custom-orb-collected-count ()
      (let ((count 0))
        (dotimes (index 121)
          (when (and (or (< index temple-climb-world-orb-first-index)
                         (>= index (+ temple-climb-world-orb-first-index temple-climb-world-orb-count)))
                     (desert-custom-orb-collected? index)
                     )
            (+! count 1)
            )
          )
        count
        )
      )

    (deftype task-manager-desert-custom-orbs (task-manager)
      ((orbs          handle 121)
       (orb-location  uint8  121)
       (spawned       int)
       (collected     int)
       )
      (:methods
        (clear-custom-orbs! (_type_) none)
        )
      )

    (defmethod clear-custom-orbs! ((this task-manager-desert-custom-orbs))
      (dotimes (i (-> this spawned))
        (let ((proc (handle->process (-> this orbs i))))
          (when proc
            (deactivate proc)
            )
          )
        (set! (-> this orbs i) (the-as handle #f))
        )
      (set! (-> this spawned) 0)
      (clear-spawn-skill-meters-owner!)
      (none)
      )

    (defmethod on-fail ((this task-manager-desert-custom-orbs) (reason symbol))
      (clear-custom-orbs! this)
      ((method-of-type task-manager on-fail) this reason)
      )

    (defmethod set-time-limit ((this task-manager-desert-custom-orbs))
      ;; Keep the mission timer stopped until the two-second title prompt ends.
      (set! (-> this start-time) 0)
      (set! (-> this time-limit) (-> this info time-limit))
      (clear-custom-orbs! this)
      (none)
      )

