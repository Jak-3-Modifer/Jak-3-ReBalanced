    (defstate active (task-manager-desert-custom-orbs)
      :virtual #t
      :event (behavior ((proc process) (argc int) (message symbol) (block event-message-block))
        (case message
          (('register-custom-orb)
           (when (< (-> self spawned) 121)
             (set! (-> self orbs (-> self spawned)) (the-as handle (-> block param 0)))
             (+! (-> self spawned) 1)
             )
           )
          (('notify)
           (case (-> block param 0)
             (('pickup)
              (+! (-> self collected) 1)
              (set! (-> *game-info* counter) (the float (- 121 (-> self collected))))
              (when (>= (-> self collected) 121)
                (send-event self 'complete)
                )
              )
             )
           )
          (else
            (task-manager-event-handler proc argc message block)
            )
          )
        )
      :code (behavior ()
        (set! (-> self spawned) 0)
        (set! (-> self collected) 0)
        (clear-spawn-skill-meters-owner!)
        (set-spawn-skill-meters-owner! self)
        (spawn-printed-desert-orbs)
        (clear-spawn-skill-meters-owner!)
        (set! (-> *game-info* counter) 121.0)
        (until #f
          (suspend)
          )
        )
      )

    (defun runs-every-frame ()
      ;; (increase-power-cell-by-one) This is a call to increase-power-cell-by-one defined in mod-common-functions.gc

      ;; Sample code to turn jak pink whenever he's doing the jetboard hover glitch
      ;; (when *target* 
      ;;   (if (board-hovering?)
      ;;     (draw-pink *target*)
      ;;     (draw-normal *target*)
      ;;     )
      ;;   )

      (if *show-input-display* 
        (input-display-on)
        (input-display-off)
        )

      (when *debug-segment*
        (orb-placer-maintenance)
        )

      (none)
      )

    (defun runs-on-gem-pickup ()
      ;; Code here runs on any scout fly pickup

      (none)
      )

